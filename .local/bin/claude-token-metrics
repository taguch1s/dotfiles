#!/usr/bin/env python3
"""Claude Code のトランスクリプトから、セッションごとのトークン効率指標（L0〜L2）を集計する。

- L0: トークン種類別の合計と、重み付きコスト（input 換算のトークン数）。
- L1: リクエスト数、文脈サイズ（平均・最大・最後・十分位の推移）、家賃率
  （cache 読み込みの重み付きコスト ÷ 総コスト）、再読倍率
  （cache 読み込み ÷ (input + cache 作成)）、文脈の急減（compact / clear の痕跡）。
- L2: 200 バイト以上のツール結果ごとに、直前 400kB までのツール結果履歴に対する
  条件付き圧縮長（lzma preset=1）を「新しい情報量」とみなし、新情報率を出す。
  粗い近似なので、絶対値ではなく同じ方法で測った値どうしの比較に使う。

集計の単位（scope）は main（本体）、sidechain（本体ファイル内の isSidechain 行）、
subagents（<session>/subagents/*.jsonl）と、それらを合わせた total。
assistant 行は 1 リクエストが複数行に分かれるので requestId で重複を除く（後の行を採用）。

重みは既定値 < 設定ファイル < --weights の順に上書きする。
  設定ファイル: ${XDG_CONFIG_HOME:-~/.config}/claude-token-metrics/weights.json
  形式: {"weights": {"input": 1, "cache_creation_5m": 1.25, ...}}（一部のキーだけでよい。
  "weights" 以外のキーは無視するので、推定の根拠などを併記してよい）

使い方:
  claude-token-metrics session [--weights k=v,...] <transcript.jsonl>   1 行の JSON を出す
  claude-token-metrics record [--foreground]   SessionEnd hook 用（stdin の JSON を読む）
  claude-token-metrics report [--since YYYY-MM-DD] [--json]
  claude-token-metrics calibrate [--since YYYY-MM-DD] [--json] [--write]
      claude-statusline が記録した使用率の変化から、トークン種類ごとの重みを推定する
記録先: ${XDG_DATA_HOME:-~/.local/share}/claude-token-metrics/sessions.jsonl
       ${XDG_DATA_HOME:-~/.local/share}/claude-token-metrics/ratelimit.jsonl（statusline が書く）
"""

from __future__ import annotations

import argparse
import bisect
import datetime as dt
import json
import lzma
import math
import os
import re
import subprocess
import sys
from pathlib import Path

SCHEMA = "claude-token-metrics/v1"
DEFAULT_WEIGHTS = {"input": 1, "cache_creation_5m": 1.25, "cache_creation_1h": 2,
                   "cache_read": 0.1, "output": 5}
TOKEN_KEYS = ("input", "cache_creation_5m", "cache_creation_1h", "cache_read", "output", "thinking")

WINDOW_BYTES = 400_000  # 新情報率の条件にするツール結果履歴の窓幅
MIN_BYTES = 200  # これより短いツール結果は新情報率を測らない（履歴には入れる）
LOW_RATE = 0.05  # 新情報率がこれ未満のツール呼び出しを low_new_info に挙げる
LOW_LIMIT = 20
DROP_RATIO = 0.5  # 文脈がこの割合未満に減り、かつ
DROP_MIN_TOKENS = 1000  # この数以上減ったら急減とみなす
SYNTHETIC_MODEL = "<synthetic>"
LZMA_FILTERS = [{"id": lzma.FILTER_LZMA2, "preset": 1}]
ENV_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=.*")


# ---- 設定と保存先 ----------------------------------------------------------

def config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "claude-token-metrics" / "weights.json"


def data_dir() -> Path:
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "claude-token-metrics"


def sessions_path() -> Path:
    return data_dir() / "sessions.jsonl"


def _weight_value(key: object, value: object) -> float:
    if key not in DEFAULT_WEIGHTS:
        raise ValueError(f"未知の重み: {key}（{', '.join(DEFAULT_WEIGHTS)} のいずれか）")
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
        raise ValueError(f"重み {key} は 0 以上の数値にしてください: {value!r}")
    return value


def parse_weights_arg(text: str) -> dict:
    """`input=1,output=5` 形式の --weights を辞書にする。"""
    result = {}
    for item in filter(None, (part.strip() for part in text.split(","))):
        key, sep, raw = item.partition("=")
        if not sep:
            raise ValueError(f"--weights は key=value の形で指定してください: {item}")
        try:
            value = float(raw)
        except ValueError:
            raise ValueError(f"重み {key} は 0 以上の数値にしてください: {raw!r}") from None
        result[key.strip()] = _weight_value(key.strip(), value)
    return result


def load_weights(cli_value: str | None = None, path: Path | None = None) -> tuple[dict, str]:
    """重みを既定値 < 設定ファイル < --weights の順で決め、(重み, 出所) を返す。"""
    weights, source = dict(DEFAULT_WEIGHTS), "default"
    path = config_path() if path is None else path
    if path.is_file():
        data = json.loads(path.read_text())
        overrides = data.get("weights") if isinstance(data, dict) else None
        if not isinstance(overrides, dict):
            raise ValueError(f"{path}: {{\"weights\": {{...}}}} の形にしてください")
        weights.update({key: _weight_value(key, value) for key, value in overrides.items()})
        source = str(path)
    if cli_value:
        weights.update(parse_weights_arg(cli_value))
        source = "--weights"
    return weights, source


# ---- 新情報量 -------------------------------------------------------------

def compressed_size(data: bytes) -> int:
    if not data:
        return 0
    return len(lzma.compress(data, format=lzma.FORMAT_RAW, filters=LZMA_FILTERS))


class ToolHistory:
    """直前 window バイトまでのツール結果を条件にした、条件付き圧縮長を求める。"""

    def __init__(self, window: int = WINDOW_BYTES):
        self.window = window
        self.buffer = b""
        self._size: int | None = 0  # compressed_size(self.buffer) のキャッシュ

    def novel_bytes(self, data: bytes) -> int:
        base = compressed_size(self.buffer) if self._size is None else self._size
        joint = compressed_size(self.buffer + data)
        self.add(data, joint)
        return max(0, joint - base)

    def add(self, data: bytes, joint: int | None = None) -> None:
        combined = self.buffer + data
        self.buffer = combined[-self.window:]
        self._size = joint if joint is not None and len(combined) <= self.window else None


def command_key(name: str, tool_input: object) -> str:
    """低新情報率の一覧をまとめるキー。Bash はコマンドの先頭語（環境変数の代入は飛ばす）。"""
    if name != "Bash" or not isinstance(tool_input, dict):
        return name
    for word in str(tool_input.get("command", "")).split():
        if not ENV_ASSIGNMENT.fullmatch(word):
            return f"Bash:{os.path.basename(word) or word}"
    return "Bash"


# ---- トランスクリプトの読み込み -----------------------------------------------

def _number(value: object) -> int | float:
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


def normalize_usage(usage: dict, model: str) -> dict:
    cache_creation = _number(usage.get("cache_creation_input_tokens"))
    detail = usage.get("cache_creation")
    one_hour = _number(detail.get("ephemeral_1h_input_tokens")) if isinstance(detail, dict) else 0
    one_hour = min(one_hour, cache_creation)  # 内訳がなければ全量を 5m とみなす
    output_detail = usage.get("output_tokens_details")
    request = {
        "model": model,
        "input": _number(usage.get("input_tokens")),
        "cache_creation_5m": cache_creation - one_hour,
        "cache_creation_1h": one_hour,
        "cache_read": _number(usage.get("cache_read_input_tokens")),
        "output": _number(usage.get("output_tokens")),
        "thinking": _number(output_detail.get("thinking_tokens")) if isinstance(output_detail, dict) else 0,
    }
    request["context"] = request["input"] + cache_creation + request["cache_read"]
    return request


def result_bytes(content: object) -> bytes:
    if isinstance(content, str):
        return content.encode()
    if isinstance(content, list):
        texts = [item.get("text", "") for item in content
                 if isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str)]
        return "\n".join(texts).encode()
    return b""


class Stream:
    """1 つの会話の流れ（本体、本体内の sidechain、サブエージェントの 1 ファイル）。"""

    def __init__(self, tools: dict):
        self.requests: list[dict] = []
        self.request_index: dict[str, int] = {}
        self.tool_results: list[tuple[str, bytes]] = []
        self.compact_boundaries = 0
        self.tools = tools  # tool_use_id -> (name, input)。同じファイル内で共有する


class Transcript:
    def __init__(self):
        self.skipped = {"broken_lines": 0, "no_usage": 0, "synthetic": 0}
        self.versions: set[str] = set()
        self.version: str | None = None
        self.session_id: str | None = None
        self.timestamps: list[str] = []

    def read(self, path: Path, *, split_sidechain: bool) -> tuple[Stream, Stream]:
        """1 ファイルを読み、(本体, sidechain) の Stream を返す。split しないときは本体だけに入れる。"""
        tools: dict = {}
        main, side = Stream(tools), Stream(tools)
        with path.open(encoding="utf-8", errors="replace") as handle:
            for raw in handle:
                if not raw.strip():
                    continue
                try:
                    line = json.loads(raw)
                except json.JSONDecodeError:
                    line = None
                if not isinstance(line, dict):
                    self.skipped["broken_lines"] += 1
                    continue
                self._meta(line, record_session=split_sidechain)
                stream = side if split_sidechain and line.get("isSidechain") else main
                self._line(line, stream, tools)
        return main, side

    def _meta(self, line: dict, *, record_session: bool) -> None:
        if isinstance(line.get("version"), str):
            self.versions.add(line["version"])
            if record_session:
                self.version = line["version"]
        if record_session:
            if self.session_id is None and isinstance(line.get("sessionId"), str):
                self.session_id = line["sessionId"]
            if isinstance(line.get("timestamp"), str):
                self.timestamps.append(line["timestamp"])

    def _line(self, line: dict, stream: Stream, tools: dict) -> None:
        kind, message = line.get("type"), line.get("message")
        message = message if isinstance(message, dict) else {}
        content = message.get("content")
        blocks = [block for block in content if isinstance(block, dict)] if isinstance(content, list) else []
        if kind == "system" and line.get("subtype") == "compact_boundary":
            stream.compact_boundaries += 1
        elif kind == "assistant":
            for block in blocks:
                if block.get("type") == "tool_use" and isinstance(block.get("id"), str):
                    tools[block["id"]] = (str(block.get("name", "unknown")), block.get("input"))
            usage = message.get("usage")
            if not isinstance(usage, dict):
                self.skipped["no_usage"] += 1
                return
            model = str(message.get("model", "unknown"))
            if model == SYNTHETIC_MODEL:
                self.skipped["synthetic"] += 1  # API を呼んでいない合成メッセージ（中断・エラー表示など）
                return
            request = normalize_usage(usage, model)
            key = line.get("requestId") or message.get("id")
            request.update(timestamp=line.get("timestamp"), request_id=key if isinstance(key, str) else None)
            if isinstance(key, str) and key in stream.request_index:
                stream.requests[stream.request_index[key]] = request  # 同じリクエストは後の行を採用する
                return
            if isinstance(key, str):
                stream.request_index[key] = len(stream.requests)
            stream.requests.append(request)
        elif kind == "user":
            for block in blocks:
                if block.get("type") == "tool_result":
                    stream.tool_results.append((str(block.get("tool_use_id", "")),
                                                result_bytes(block.get("content"))))


# ---- 指標の計算 -------------------------------------------------------------

def l0(requests: list[dict], weights: dict) -> dict:
    tokens = {key: sum(request[key] for request in requests) for key in TOKEN_KEYS}
    tokens["cache_creation"] = tokens["cache_creation_5m"] + tokens["cache_creation_1h"]
    cost = sum(weight * tokens[key] for key, weight in weights.items())
    return {"tokens": tokens, "weighted_cost": cost}


def rates(tokens: dict, cost: float, weights: dict) -> tuple[float | None, float | None]:
    """(家賃率, 再読倍率) を返す。"""
    rent = weights["cache_read"] * tokens["cache_read"] / cost if cost else None
    fresh = tokens["input"] + tokens["cache_creation"]
    return rent, (tokens["cache_read"] / fresh if fresh else None)


def l1(streams: list[Stream], base: dict, weights: dict) -> dict:
    contexts, drops, index = [], [], 0
    for stream in streams:
        previous = None
        for request in stream.requests:
            current = request["context"]
            if previous is not None and current < previous * DROP_RATIO and previous - current >= DROP_MIN_TOKENS:
                drops.append({"request_index": index, "from": previous, "to": current})
            contexts.append(current)
            previous, index = current, index + 1
    count = len(contexts)
    deciles = []
    for bucket in range(10):
        part = contexts[bucket * count // 10:(bucket + 1) * count // 10]
        deciles.append(sum(part) / len(part) if part else None)
    rent, reread = rates(base["tokens"], base["weighted_cost"], weights)
    return {
        "requests": count,
        "context": {"mean": sum(contexts) / count if count else None, "max": max(contexts, default=None),
                    "last": contexts[-1] if contexts else None, "deciles": deciles},
        "rent_rate": rent,
        "reread_ratio": reread,
        "drops": drops,
        "drop_rule": {"ratio_below": DROP_RATIO, "min_tokens": DROP_MIN_TOKENS},
        "compact_boundaries": sum(stream.compact_boundaries for stream in streams),
    }


def _rate(novel: int, raw: int) -> float | None:
    return novel / raw if raw else None


def _low_list(low: dict) -> list[dict]:
    items = sorted(low.items(), key=lambda item: (-item[1]["raw_bytes"], item[0]))
    return [{"key": key, **value} for key, value in items[:LOW_LIMIT]]


def l2(streams: list[Stream]) -> dict:
    by_tool: dict[str, dict] = {}
    low: dict[str, dict] = {}
    for stream in streams:
        history = ToolHistory()
        for tool_id, data in stream.tool_results:
            if len(data) < MIN_BYTES:
                history.add(data)
                continue
            novel = history.novel_bytes(data)
            name, tool_input = stream.tools.get(tool_id, ("unknown", None))
            entry = by_tool.setdefault(name, {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
            entry["count"] += 1
            entry["raw_bytes"] += len(data)
            entry["novel_bytes"] += novel
            if novel / len(data) < LOW_RATE:
                item = low.setdefault(command_key(name, tool_input), {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
                item["count"] += 1
                item["raw_bytes"] += len(data)
                item["novel_bytes"] += novel
    for entry in by_tool.values():
        entry["new_info_rate"] = _rate(entry["novel_bytes"], entry["raw_bytes"])
    raw = sum(entry["raw_bytes"] for entry in by_tool.values())
    novel = sum(entry["novel_bytes"] for entry in by_tool.values())
    return {
        "window_bytes": WINDOW_BYTES, "min_bytes": MIN_BYTES, "low_threshold": LOW_RATE,
        "tool_results": sum(entry["count"] for entry in by_tool.values()),
        "raw_bytes": raw, "novel_bytes": novel, "new_info_rate": _rate(novel, raw),
        "by_tool": dict(sorted(by_tool.items())), "low_new_info": _low_list(low),
    }


def scope_metrics(streams: list[Stream], weights: dict) -> dict:
    requests = [request for stream in streams for request in stream.requests]
    base = l0(requests, weights)
    by_model = {}
    for model in sorted({request["model"] for request in requests}):
        subset = [request for request in requests if request["model"] == model]
        model_l0 = l0(subset, weights)
        by_model[model] = {"requests": len(subset), **model_l0}
    return {"L0": base, "L1": l1(streams, base, weights), "L2": l2(streams), "by_model": by_model}


def total_metrics(scopes: list[dict], all_requests: list[dict], weights: dict) -> dict:
    base = l0(all_requests, weights)
    rent, reread = rates(base["tokens"], base["weighted_cost"], weights)
    low: dict[str, dict] = {}
    for scope in scopes:
        for item in scope["L2"]["low_new_info"]:
            merged = low.setdefault(item["key"], {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
            for key in merged:
                merged[key] += item[key]
    raw = sum(scope["L2"]["raw_bytes"] for scope in scopes)
    novel = sum(scope["L2"]["novel_bytes"] for scope in scopes)
    return {"requests": len(all_requests), **base, "rent_rate": rent, "reread_ratio": reread,
            "tool_results": sum(scope["L2"]["tool_results"] for scope in scopes),
            "raw_bytes": raw, "novel_bytes": novel, "new_info_rate": _rate(novel, raw),
            "low_new_info": _low_list(low)}


def session_metrics(transcript_path: str | Path, weights: dict, weights_source: str) -> dict:
    """1 セッション分の指標を求める。出力の形は SCHEMA（claude-token-metrics/v1）。"""
    path = Path(transcript_path)
    transcript = Transcript()
    main, side = transcript.read(path, split_sidechain=True)
    files = sorted((path.parent / path.stem / "subagents").glob("*.jsonl"))
    subagents = [transcript.read(file, split_sidechain=False)[0] for file in files]

    scopes = {"main": scope_metrics([main], weights), "sidechain": scope_metrics([side], weights),
              "subagents": {"files": len(files), **scope_metrics(subagents, weights)}}
    all_requests = [request for stream in (main, side, *subagents) for request in stream.requests]
    return {
        "schema": SCHEMA,
        "session_id": transcript.session_id or path.stem,
        "transcript_path": str(path),
        "version": transcript.version,
        "versions": sorted(transcript.versions),
        "started_at": min(transcript.timestamps, default=None),
        "ended_at": max(transcript.timestamps, default=None),
        "weights": weights,
        "weights_source": weights_source,
        "skipped": transcript.skipped,
        **scopes,
        "total": total_metrics(list(scopes.values()), all_requests, weights),
    }


# ---- サブコマンド -----------------------------------------------------------

def command_session(args: argparse.Namespace, parser: argparse.ArgumentParser) -> int:
    try:
        weights, source = load_weights(args.weights)
    except (ValueError, OSError) as error:
        parser.error(str(error))
    if not Path(args.transcript).is_file():
        print(f"claude-token-metrics: トランスクリプトがありません: {args.transcript}", file=sys.stderr)
        return 1
    print(json.dumps(session_metrics(args.transcript, weights, source), ensure_ascii=False))
    return 0


def record_foreground(raw: str) -> None:
    payload = json.loads(raw or "{}")
    if not isinstance(payload, dict):
        raise ValueError("hook の入力が JSON オブジェクトではありません")
    transcript = payload.get("transcript_path")
    if not isinstance(transcript, str) or not Path(transcript).is_file():
        raise ValueError(f"transcript_path がありません: {transcript!r}")
    weights, source = load_weights()
    metrics = session_metrics(transcript, weights, source)
    if isinstance(payload.get("session_id"), str):
        metrics["session_id"] = payload["session_id"]
    metrics.update({"recorded_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
                    "reason": payload.get("reason"), "cwd": payload.get("cwd")})
    path = sessions_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(metrics, ensure_ascii=False) + "\n")


def record_detached(raw: str) -> None:
    """集計を切り離した子プロセスに任せ、hook はすぐ返す（セッションの終了を待たせない）。"""
    log = data_dir() / "record.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as output:
        child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "record", "--foreground"],
                                 stdin=subprocess.PIPE, stdout=output, stderr=output,
                                 start_new_session=True, text=True)
    child.stdin.write(raw)
    child.stdin.close()


def command_record(args: argparse.Namespace) -> int:
    # hook から呼ばれるので、どんな失敗でも exit 0 で返す。
    try:
        raw = sys.stdin.read()
        (record_foreground if args.foreground else record_detached)(raw)
    except Exception as error:  # noqa: BLE001 - セッションを妨げないため全て握りつぶす
        stamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        print(f"{stamp} claude-token-metrics record: {error}", file=sys.stderr)
    return 0


def load_records(path: Path) -> list[dict]:
    """sessions.jsonl を読み、同じ session_id は後に記録したものを採用する。"""
    latest: dict[str, dict] = {}
    if not path.is_file():
        return []
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            record = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if isinstance(record, dict) and isinstance(record.get("session_id"), str):
            latest.pop(record["session_id"], None)
            latest[record["session_id"]] = record
    return list(latest.values())


def report_row(record: dict) -> dict:
    total = record.get("total") or {}
    context = ((record.get("main") or {}).get("L1") or {}).get("context") or {}
    return {
        "session_id": record["session_id"],
        "started_at": record.get("started_at"),
        "recorded_at": record.get("recorded_at"),
        "cwd": record.get("cwd"),
        "requests": total.get("requests"),
        "weighted_cost": total.get("weighted_cost"),
        "rent_rate": total.get("rent_rate"),
        "context_max": context.get("max"),
        "new_info_rate": total.get("new_info_rate"),
        "low_new_info_top": [item.get("key") for item in (total.get("low_new_info") or [])[:3]],
    }


def _percent(value: object) -> str:
    return f"{value * 100:.1f}%" if isinstance(value, (int, float)) else "-"


def _count(value: object) -> str:
    return f"{value:,.0f}" if isinstance(value, (int, float)) else "-"


def command_report(args: argparse.Namespace) -> int:
    rows = [report_row(record) for record in load_records(sessions_path())]
    if args.since:
        rows = [row for row in rows if (row["started_at"] or row["recorded_at"] or "")[:10] >= args.since]
    rows.sort(key=lambda row: row["started_at"] or row["recorded_at"] or "")
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    header = ("started(UTC)", "session", "req", "cost", "rent", "ctx_max", "new_info", "low_new_info_top")
    lines = [header]
    for row in rows:
        lines.append(((row["started_at"] or "-")[:16].replace("T", " "), row["session_id"][:8],
                      _count(row["requests"]), _count(row["weighted_cost"]), _percent(row["rent_rate"]),
                      _count(row["context_max"]), _percent(row["new_info_rate"]),
                      ", ".join(row["low_new_info_top"]) or "-"))
    widths = [max(len(line[column]) for line in lines) for column in range(len(header) - 1)]
    for line in lines:
        print("  ".join(cell.ljust(width) for cell, width in zip(line, widths)) + "  " + line[-1])
    return 0


# ---- 重みの推定（calibrate） --------------------------------------------------
#
# claude-statusline は rate_limits.five_hour.used_percentage が変わるたびに ratelimit.jsonl へ記録する。
# 同じ resets_at を持つ連続した 2 つの記録の間を 1 区間とし、その区間に全プロジェクト
# （サブエージェント込み）で発生したトークンを種類別に合計する。Δused_percentage を目的変数、
# 種類別トークンを説明変数として切片なしの非負最小二乗で係数を求め、input を 1 とした相対値にする。

CALIBRATE_SCHEMA = "claude-token-metrics/calibrate/v1"
FEATURES = ("input", "cache_creation_5m", "cache_creation_1h", "cache_read", "output")
MIN_INTERVALS = 30
RESET_TOLERANCE = 60  # resets_at がこの秒数以内の差なら同じ 5 時間枠とみなす
FAMILIES = ("opus", "sonnet", "haiku")
CALIBRATE_NOTE = ("同じ枠を claude.ai web や他の端末で使った分はローカルのログに出ないため、"
                  "推定のノイズになる。used_percentage の刻みが粗いほど 1 区間の誤差は大きい。")


def ratelimit_path() -> Path:
    return data_dir() / "ratelimit.jsonl"


def projects_dir() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    return Path(base) / "projects"


def epoch(value: object) -> float | None:
    """ISO 8601 の文字列か Unix 時刻（秒またはミリ秒）を Unix 秒にする。読めなければ None。"""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        number = float(value)
        if not math.isfinite(number):
            return None
        return number / 1000 if number > 1e12 else number
    if not isinstance(value, str) or not value:
        return None
    try:
        return epoch(float(value))
    except ValueError:
        pass
    try:
        moment = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=dt.timezone.utc)
    return moment.timestamp()


def load_ratelimit_records(path: Path, since: str | None = None) -> list[dict]:
    """ratelimit.jsonl を読み、5 時間枠の使用率を持つ記録を時刻順に {ts, pct, reset} で返す。"""
    records = []
    if not path.is_file():
        return records
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            line = json.loads(raw)
        except json.JSONDecodeError:
            continue
        window = line.get("five_hour") if isinstance(line, dict) else None
        moment = epoch(line.get("ts")) if isinstance(line, dict) else None
        if moment is None or not isinstance(window, dict):
            continue
        percent = window.get("used_percentage")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)) or not math.isfinite(percent):
            continue
        if since and dt.datetime.fromtimestamp(moment, dt.timezone.utc).date().isoformat() < since:
            continue
        records.append({"ts": moment, "pct": percent, "reset": epoch(window.get("resets_at"))})
    records.sort(key=lambda record: record["ts"])
    return records


def build_intervals(records: list[dict], min_delta: float = 0) -> tuple[list[dict], dict]:
    """同じ枠の連続した 2 記録を 1 区間にする。枠の切り替わりと使用率の減少は除く。

    min_delta > 0 なら、同じ枠の中で Δ がその値以上になるまで連続した区間をつなげる
    （used_percentage の刻みが粗いとき、1 区間あたりの丸め誤差を小さくするため）。"""
    intervals, skipped = [], {"window_change": 0, "negative_delta": 0}
    start = records[0] if records else None
    for before, after in zip(records, records[1:]):
        if before["reset"] is None or after["reset"] is None \
                or abs(before["reset"] - after["reset"]) > RESET_TOLERANCE:
            skipped["window_change"] += 1
            start = after
            continue
        if after["pct"] < before["pct"]:
            skipped["negative_delta"] += 1
            start = after
            continue
        delta = after["pct"] - start["pct"]
        if delta < min_delta:
            continue
        intervals.append({"start": start["ts"], "end": after["ts"], "delta": delta, "tokens": {}})
        start = after
    return intervals, skipped


def model_family(model: str) -> str:
    name = model.lower()
    return next((family for family in FAMILIES if family in name), "other")


def attribute_tokens(intervals: list[dict], projects: Path) -> dict:
    """全トランスクリプトのリクエストを、時刻で区間に振り分けてモデル系統・種類別に足す。"""
    counts = {"files": 0, "requests": 0, "duplicate_requests": 0}
    if not intervals or not projects.is_dir():
        return counts
    first, last = intervals[0]["start"], intervals[-1]["end"]
    ends = [interval["end"] for interval in intervals]
    seen: set[str] = set()
    for file in sorted(projects.rglob("*.jsonl")):
        try:
            if file.stat().st_mtime < first:
                continue  # 最初の記録より前に書き終わったファイルには、区間内のリクエストがない
            stream = Transcript().read(file, split_sidechain=False)[0]
        except OSError:
            continue
        counts["files"] += 1
        for request in stream.requests:
            moment = epoch(request.get("timestamp"))
            if moment is None or not first < moment <= last:
                continue
            key = request.get("request_id")
            if key in seen:
                counts["duplicate_requests"] += 1  # 再開したセッションなどで別ファイルに同じリクエストがある
                continue
            if key:
                seen.add(key)
            interval = intervals[bisect.bisect_left(ends, moment)]
            if moment <= interval["start"]:
                continue  # 区間に入らない（枠の切り替わりなどで除いた区間の中）
            bucket = interval["tokens"].setdefault(model_family(request["model"]), dict.fromkeys(FEATURES, 0))
            for feature in FEATURES:
                bucket[feature] += request[feature]
            counts["requests"] += 1
    return counts


def _solve(matrix: list[list[float]], vector: list[float]) -> list[float] | None:
    """ガウスの消去法（部分ピボット）。特異なら None。"""
    size = len(vector)
    rows = [list(row) + [value] for row, value in zip(matrix, vector)]
    for column in range(size):
        pivot = max(range(column, size), key=lambda index: abs(rows[index][column]))
        if abs(rows[pivot][column]) < 1e-10:
            return None
        rows[column], rows[pivot] = rows[pivot], rows[column]
        for index in range(column + 1, size):
            factor = rows[index][column] / rows[column][column]
            rows[index] = [a - factor * b for a, b in zip(rows[index], rows[column])]
    solution = [0.0] * size
    for index in reversed(range(size)):
        known = sum(rows[index][j] * solution[j] for j in range(index + 1, size))
        solution[index] = (rows[index][size] - known) / rows[index][index]
    return solution


def nnls(columns: list[list[float]], target: list[float]) -> list[float]:
    """非負最小二乗。説明変数が高々 5 個なので、すべての台（部分集合）で最小二乗を解き、
    係数が非負の解のうち残差が最小のものを選ぶ（NNLS の最適解は、その台での最小二乗解なので厳密）。"""
    size = len(columns)
    norms = [math.sqrt(sum(value * value for value in column)) for column in columns]
    scaled = [[value / norm for value in column] if norm else column for column, norm in zip(columns, norms)]
    gram = [[sum(a * b for a, b in zip(left, right)) for right in scaled] for left in scaled]
    moment = [sum(a * b for a, b in zip(column, target)) for column in scaled]
    total = sum(value * value for value in target)
    best, best_residual = [0.0] * size, total
    for mask in range(1, 1 << size):
        support = [index for index in range(size) if mask >> index & 1]
        if not all(norms[index] for index in support):
            continue
        solution = _solve([[gram[i][j] for j in support] for i in support], [moment[i] for i in support])
        if solution is None or min(solution) < 0:
            continue
        residual = total - sum(value * moment[index] for value, index in zip(solution, support))
        if residual < best_residual - 1e-12 * max(total, 1.0):
            best_residual, best = residual, [0.0] * size
            for value, index in zip(solution, support):
                best[index] = value
    return [value / norm if norm else 0.0 for value, norm in zip(best, norms)]


def _significant(value: float) -> float:
    return float(f"{value:.4g}")


def fit_weights(rows: list[tuple[dict, float]], min_intervals: int) -> dict:
    """区間ごとの (種類別トークン, Δ使用率) から重みを推定する。区間数が足りなければ推定しない。"""
    result = {"status": "insufficient_data", "intervals": len(rows), "weights": None,
              "percent_per_mtok": None, "r2": None}
    if not rows or len(rows) < min_intervals:
        return result
    used = [feature for feature in FEATURES if any(tokens[feature] for tokens, _ in rows)]
    target = [delta for _, delta in rows]
    coefficients = dict(zip(used, nnls([[tokens[feature] for tokens, _ in rows] for feature in used], target)))
    predicted = [sum(value * tokens[feature] for feature, value in coefficients.items()) for tokens, _ in rows]
    mean = sum(target) / len(target)
    spread = sum((value - mean) ** 2 for value in target)
    residual = sum((value - guess) ** 2 for value, guess in zip(target, predicted))
    base = coefficients.get("input", 0)
    result.update(
        status="ok",
        weights={feature: _significant(coefficients[feature] / base) if feature in coefficients else None
                 for feature in FEATURES} if base > 0 else None,
        percent_per_mtok={feature: coefficients[feature] * 1e6 if feature in coefficients else None
                          for feature in FEATURES},
        r2=1 - residual / spread if spread else None,  # 切片なしだが、平均まわりの決定係数（保守的な値）
    )
    return result


def calibrate(ratelimit: Path, projects: Path, since: str | None, min_intervals: int,
              min_delta: float = 0) -> dict:
    records = load_ratelimit_records(ratelimit, since)
    intervals, skipped = build_intervals(records, min_delta)
    counts = attribute_tokens(intervals, projects)
    skipped.update(no_tokens=0, duplicate_requests=counts["duplicate_requests"])
    rows, families = [], {}
    for interval in intervals:
        buckets = {family: tokens for family, tokens in interval["tokens"].items() if any(tokens.values())}
        if not buckets:
            skipped["no_tokens"] += 1  # ローカルで使っていない区間（他の端末の分）は情報を持たない
            continue
        rows.append(({feature: sum(tokens[feature] for tokens in buckets.values()) for feature in FEATURES},
                     interval["delta"]))
        # モデル系統別の推定には、その系統だけを使った区間を使う。
        for family in buckets:
            families.setdefault(family, [])
        if len(buckets) == 1:
            (family, tokens), = buckets.items()
            families[family].append((tokens, interval["delta"]))
    return {
        "schema": CALIBRATE_SCHEMA,
        **fit_weights(rows, min_intervals),
        "min_intervals": min_intervals,
        "min_delta": min_delta,
        "records": len(records),
        "since": since,
        "files": counts["files"],
        "requests": counts["requests"],
        "skipped": skipped,
        "by_model": {family: fit_weights(subset, min_intervals) for family, subset in sorted(families.items())},
        "note": CALIBRATE_NOTE,
    }


def _weights_text(weights: dict) -> str:
    return ", ".join(f"{key} {value:.4g}" for key, value in weights.items() if value is not None)


def _fit_text(fit: dict, min_intervals: int) -> str:
    if fit["status"] != "ok":
        return f"データ不足: 区間 {fit['intervals']}（{min_intervals} 以上必要）。推定しません"
    if not fit["weights"]:
        return f"区間 {fit['intervals']}: input の係数が 0 のため、input = 1 の相対値を出せません"
    r2 = "-" if fit["r2"] is None else f"{fit['r2']:.3f}"
    return f"重み（input = 1）: {_weights_text(fit['weights'])}、決定係数 {r2}"


def print_calibration(result: dict) -> None:
    skipped = result["skipped"]
    print(f"記録 {result['records']}、区間 {result['intervals']}（枠の切り替わり {skipped['window_change']}、"
          f"使用率の減少 {skipped['negative_delta']}、ローカルのトークンなし {skipped['no_tokens']} を除外）、"
          f"リクエスト {result['requests']}、ファイル {result['files']}")
    print(_fit_text(result, result["min_intervals"]))
    if result["status"] == "ok":
        print(f"使用率（% / 100 万トークン）: {_weights_text(result['percent_per_mtok'])}")
    for family, fit in result["by_model"].items():
        print(f"  {family}: {_fit_text(fit, result['min_intervals'])}")
    print(f"注意: {result['note']}")


def write_calibration(result: dict, path: Path) -> None:
    """推定した重みを設定ファイルに書く。"weights" 以外のキーは残し、推定の根拠を "calibration" に入れる。"""
    if result["status"] != "ok" or not result["weights"]:
        raise ValueError(f"データ不足（区間 {result['intervals']}）または input の係数が 0 のため、書き出しません")
    data: dict = {}
    if path.is_file():
        try:
            loaded = json.loads(path.read_text())
        except json.JSONDecodeError:
            raise ValueError(f"{path} が JSON として読めないため、上書きしません") from None
        data = loaded if isinstance(loaded, dict) else {}
    data["weights"] = {key: value for key, value in result["weights"].items() if value is not None}
    data["calibration"] = {
        "source": "claude-token-metrics calibrate",
        "estimated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "since": result["since"], "min_delta": result["min_delta"],
        "intervals": result["intervals"], "r2": result["r2"],
        "percent_per_mtok": result["percent_per_mtok"], "note": result["note"],
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    os.replace(temporary, path)


def command_calibrate(args: argparse.Namespace) -> int:
    ratelimit = Path(args.ratelimit) if args.ratelimit else ratelimit_path()
    projects = Path(args.projects) if args.projects else projects_dir()
    result = calibrate(ratelimit, projects, args.since, args.min_intervals, args.min_delta)
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print_calibration(result)
    if args.write:
        try:
            write_calibration(result, config_path())
        except (ValueError, OSError) as error:
            print(f"claude-token-metrics: {error}", file=sys.stderr)
            return 1
        print(f"{config_path()} に重みを書き出しました", file=sys.stderr)
    return 0


def positive_int(value: str) -> int:
    try:
        number = int(value)
    except ValueError:
        number = 0
    if number < 1:
        raise argparse.ArgumentTypeError(f"1 以上の整数で指定してください: {value}")
    return number


def non_negative_float(value: str) -> float:
    try:
        number = float(value)
    except ValueError:
        number = -1.0
    if not math.isfinite(number) or number < 0:
        raise argparse.ArgumentTypeError(f"0 以上の数値で指定してください: {value}")
    return number


def since_date(value: str) -> str:
    try:
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
            raise ValueError
        dt.date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"YYYY-MM-DD で指定してください: {value}") from None
    return value


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="claude-token-metrics", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    session = commands.add_parser("session", help="1 セッションの指標を 1 行の JSON で出す")
    session.add_argument("--weights", help="重みの上書き（例: input=1,output=5）")
    session.add_argument("transcript")
    record = commands.add_parser("record", help="SessionEnd hook 用。stdin の transcript_path を集計して追記する")
    record.add_argument("--foreground", action="store_true", help="切り離さずにその場で集計する")
    report = commands.add_parser("report", help="記録したセッションの一覧を出す")
    report.add_argument("--since", type=since_date, help="この日（UTC）以降に始まったセッションだけ出す")
    report.add_argument("--json", action="store_true", help="表ではなく JSON の配列で出す")
    calibrate_parser = commands.add_parser(
        "calibrate", help="statusline が記録した使用率の変化から、トークン種類ごとの重みを推定する")
    calibrate_parser.add_argument("--since", type=since_date, help="この日（UTC）以降の記録だけ使う")
    calibrate_parser.add_argument("--min-intervals", type=positive_int, default=MIN_INTERVALS,
                                  help=f"推定に必要な区間数（既定 {MIN_INTERVALS}）")
    calibrate_parser.add_argument("--min-delta", type=non_negative_float, default=0,
                                  help="同じ枠の中で Δ使用率がこの値以上になるまで区間をつなげる"
                                       "（刻みが粗いときの丸め誤差対策。既定 0 = 連続した 2 記録ごと）")
    calibrate_parser.add_argument("--json", action="store_true", help="結果を JSON で出す")
    calibrate_parser.add_argument("--write", action="store_true",
                                  help="推定した重みで設定ファイル（weights.json）の weights を置き換える（既定では書かない）")
    calibrate_parser.add_argument("--ratelimit", help="使用率の記録（既定: <データ>/ratelimit.jsonl）")
    calibrate_parser.add_argument("--projects", help="トランスクリプトの場所（既定: ~/.claude/projects）")
    args = parser.parse_args(argv)
    if args.command == "session":
        return command_session(args, session)
    if args.command == "record":
        return command_record(args)
    if args.command == "calibrate":
        return command_calibrate(args)
    return command_report(args)


if __name__ == "__main__":
    raise SystemExit(main())
