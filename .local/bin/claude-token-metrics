#!/usr/bin/env python3
"""Claude Code のトランスクリプトから、セッションごとのトークン効率指標（L0〜L2）を集計する。

- L0: トークン種類別の合計と、重み付きコスト（input 換算のトークン数）。
- L1: リクエスト数、文脈サイズ（平均・最大・最後・十分位の推移）、家賃率
  （cache 読み込みの重み付きコスト ÷ 総コスト）、再読倍率
  （cache 読み込み ÷ (input + cache 作成)）、文脈の急減（compact / clear の痕跡）。
- L2: 200 バイト以上のツール結果ごとに、直前 400kB までのツール結果履歴に対する
  条件付き圧縮長（lzma preset=1）を「新しい情報量」とみなし、新情報率を出す。
  粗い近似なので、絶対値ではなく同じ方法で測った値どうしの比較に使う。

集計の単位（scope）は main（本体）、sidechain（本体ファイル内の isSidechain 行）、
subagents（<session>/subagents/*.jsonl）と、それらを合わせた total。
assistant 行は 1 リクエストが複数行に分かれるので requestId で重複を除く（後の行を採用）。

重みは既定値 < 設定ファイル < --weights の順に上書きする。
  設定ファイル: ${XDG_CONFIG_HOME:-~/.config}/claude-token-metrics/weights.json
  形式: {"weights": {"input": 1, "cache_creation_5m": 1.25, ...}}（一部のキーだけでよい。
  "weights" 以外のキーは無視するので、推定の根拠などを併記してよい）

使い方:
  claude-token-metrics session [--weights k=v,...] [--waste-config <path>] <transcript.jsonl>
      1 行の JSON を出す（waste に無駄検出の結果が入る）
  claude-token-metrics waste [--json] [--waste-config <path>] <transcript.jsonl>
      無駄検出の結果をルール別の表で出す。設定は ${XDG_CONFIG_HOME:-~/.config}/claude-token-metrics/waste.json
  claude-token-metrics record [--foreground]   SessionEnd hook 用（stdin の JSON を読む）
  claude-token-metrics report [--by session|task] [--since YYYY-MM-DD] [--json]
      記録の表。--by task はタスク（Issue）ごとにまとめる
  claude-token-metrics rescan --since YYYY-MM-DD [--projects <dir>]
      --since 以降に更新された transcript を集計し直して記録に追記する
  claude-token-metrics calibrate [--since YYYY-MM-DD] [--json] [--write]
      claude-statusline が記録した使用率の変化から、トークン種類ごとの重みを推定する
記録先: ${XDG_DATA_HOME:-~/.local/share}/claude-token-metrics/sessions.jsonl
       ${XDG_DATA_HOME:-~/.local/share}/claude-token-metrics/ratelimit.jsonl（statusline が書く）
"""

from __future__ import annotations

import argparse
import bisect
import datetime as dt
import hashlib
import json
import lzma
import math
import os
import re
import subprocess
import sys
from pathlib import Path

SCHEMA = "claude-token-metrics/v1"
DEFAULT_WEIGHTS = {"input": 1, "cache_creation_5m": 1.25, "cache_creation_1h": 2,
                   "cache_read": 0.1, "output": 5}
TOKEN_KEYS = ("input", "cache_creation_5m", "cache_creation_1h", "cache_read", "output", "thinking")

WINDOW_BYTES = 400_000  # 新情報率の条件にするツール結果履歴の窓幅
MIN_BYTES = 200  # これより短いツール結果は新情報率を測らない（履歴には入れる）
LOW_RATE = 0.05  # 新情報率がこれ未満のツール呼び出しを low_new_info に挙げる
LOW_LIMIT = 20
DROP_RATIO = 0.5  # 文脈がこの割合未満に減り、かつ
DROP_MIN_TOKENS = 1000  # この数以上減ったら急減とみなす
SYNTHETIC_MODEL = "<synthetic>"
LZMA_FILTERS = [{"id": lzma.FILTER_LZMA2, "preset": 1}]
ENV_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=.*")


# ---- 設定と保存先 ----------------------------------------------------------

def config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "claude-token-metrics" / "weights.json"


def data_dir() -> Path:
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "claude-token-metrics"


def sessions_path() -> Path:
    return data_dir() / "sessions.jsonl"


def _weight_value(key: object, value: object) -> float:
    if key not in DEFAULT_WEIGHTS:
        raise ValueError(f"未知の重み: {key}（{', '.join(DEFAULT_WEIGHTS)} のいずれか）")
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:
        raise ValueError(f"重み {key} は 0 以上の数値にしてください: {value!r}")
    return value


def parse_weights_arg(text: str) -> dict:
    """`input=1,output=5` 形式の --weights を辞書にする。"""
    result = {}
    for item in filter(None, (part.strip() for part in text.split(","))):
        key, sep, raw = item.partition("=")
        if not sep:
            raise ValueError(f"--weights は key=value の形で指定してください: {item}")
        try:
            value = float(raw)
        except ValueError:
            raise ValueError(f"重み {key} は 0 以上の数値にしてください: {raw!r}") from None
        result[key.strip()] = _weight_value(key.strip(), value)
    return result


def load_weights(cli_value: str | None = None, path: Path | None = None) -> tuple[dict, str]:
    """重みを既定値 < 設定ファイル < --weights の順で決め、(重み, 出所) を返す。"""
    weights, source = dict(DEFAULT_WEIGHTS), "default"
    path = config_path() if path is None else path
    if path.is_file():
        data = json.loads(path.read_text())
        overrides = data.get("weights") if isinstance(data, dict) else None
        if not isinstance(overrides, dict):
            raise ValueError(f"{path}: {{\"weights\": {{...}}}} の形にしてください")
        weights.update({key: _weight_value(key, value) for key, value in overrides.items()})
        source = str(path)
    if cli_value:
        weights.update(parse_weights_arg(cli_value))
        source = "--weights"
    return weights, source


# ---- 新情報量 -------------------------------------------------------------

def compressed_size(data: bytes) -> int:
    if not data:
        return 0
    return len(lzma.compress(data, format=lzma.FORMAT_RAW, filters=LZMA_FILTERS))


class ToolHistory:
    """直前 window バイトまでのツール結果を条件にした、条件付き圧縮長を求める。"""

    def __init__(self, window: int = WINDOW_BYTES):
        self.window = window
        self.buffer = b""
        self._size: int | None = 0  # compressed_size(self.buffer) のキャッシュ

    def novel_bytes(self, data: bytes) -> int:
        base = compressed_size(self.buffer) if self._size is None else self._size
        joint = compressed_size(self.buffer + data)
        self.add(data, joint)
        return max(0, joint - base)

    def add(self, data: bytes, joint: int | None = None) -> None:
        combined = self.buffer + data
        self.buffer = combined[-self.window:]
        self._size = joint if joint is not None and len(combined) <= self.window else None


def command_key(name: str, tool_input: object) -> str:
    """低新情報率の一覧をまとめるキー。Bash はコマンドの先頭語（環境変数の代入は飛ばす）。"""
    if name != "Bash" or not isinstance(tool_input, dict):
        return name
    for word in str(tool_input.get("command", "")).split():
        if not ENV_ASSIGNMENT.fullmatch(word):
            return f"Bash:{os.path.basename(word) or word}"
    return "Bash"


# ---- トランスクリプトの読み込み -----------------------------------------------

def _number(value: object) -> int | float:
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


def normalize_usage(usage: dict, model: str) -> dict:
    cache_creation = _number(usage.get("cache_creation_input_tokens"))
    detail = usage.get("cache_creation")
    one_hour = _number(detail.get("ephemeral_1h_input_tokens")) if isinstance(detail, dict) else 0
    one_hour = min(one_hour, cache_creation)  # 内訳がなければ全量を 5m とみなす
    output_detail = usage.get("output_tokens_details")
    request = {
        "model": model,
        "input": _number(usage.get("input_tokens")),
        "cache_creation_5m": cache_creation - one_hour,
        "cache_creation_1h": one_hour,
        "cache_read": _number(usage.get("cache_read_input_tokens")),
        "output": _number(usage.get("output_tokens")),
        "thinking": _number(output_detail.get("thinking_tokens")) if isinstance(output_detail, dict) else 0,
    }
    request["context"] = request["input"] + cache_creation + request["cache_read"]
    return request


def result_bytes(content: object) -> bytes:
    if isinstance(content, str):
        return content.encode()
    if isinstance(content, list):
        texts = [item.get("text", "") for item in content
                 if isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str)]
        return "\n".join(texts).encode()
    return b""


class Stream:
    """1 つの会話の流れ（本体、本体内の sidechain、サブエージェントの 1 ファイル）。"""

    def __init__(self, tools: dict):
        self.requests: list[dict] = []
        self.request_index: dict[str, int] = {}
        self.tool_results: list[tuple[str, bytes]] = []
        self.compact_boundaries = 0
        self.tools = tools  # tool_use_id -> (name, input)。同じファイル内で共有する
        # 無駄検出（waste）用。results は tool_results と同じ順で、is_error・timestamp と、
        # 直前のリクエストの位置（after。無ければ -1）を持つ。
        self.results: list[dict] = []
        self.compact_after: list[int] = []  # compact_boundary の直前のリクエストの位置
        self.tool_request: dict[str, int] = {}  # tool_use_id -> 呼び出しを出したリクエストの位置
        self.last_kind: str | None = None  # 直前の行: human / tool_result / assistant
        self.tool_order: list[str] = []  # tool_use_id を出た順に（delegation / restart 用）
        self.first_human: str | None = None  # 最初の人の発言の本文（restart 用）


class Transcript:
    def __init__(self):
        self.skipped = {"broken_lines": 0, "no_usage": 0, "synthetic": 0}
        self.versions: set[str] = set()
        self.version: str | None = None
        self.session_id: str | None = None
        self.timestamps: list[str] = []
        self.branches: dict[str, int] = {}  # 本体の行の gitBranch -> 行数（出た順を保つ）
        self.cwds: dict[str, int] = {}  # 本体の行の cwd -> 行数

    def most_common(self, counts: dict[str, int]) -> str | None:
        """最も多い値。同数なら先に出た方。"""
        return max(counts, key=lambda key: counts[key], default=None) if counts else None

    def read(self, path: Path, *, split_sidechain: bool) -> tuple[Stream, Stream]:
        """1 ファイルを読み、(本体, sidechain) の Stream を返す。split しないときは本体だけに入れる。"""
        tools: dict = {}
        main, side = Stream(tools), Stream(tools)
        with path.open(encoding="utf-8", errors="replace") as handle:
            for raw in handle:
                if not raw.strip():
                    continue
                try:
                    line = json.loads(raw)
                except json.JSONDecodeError:
                    line = None
                if not isinstance(line, dict):
                    self.skipped["broken_lines"] += 1
                    continue
                self._meta(line, record_session=split_sidechain)
                stream = side if split_sidechain and line.get("isSidechain") else main
                self._line(line, stream, tools)
        return main, side

    def _meta(self, line: dict, *, record_session: bool) -> None:
        if isinstance(line.get("version"), str):
            self.versions.add(line["version"])
            if record_session:
                self.version = line["version"]
        if record_session:
            if self.session_id is None and isinstance(line.get("sessionId"), str):
                self.session_id = line["sessionId"]
            if isinstance(line.get("timestamp"), str):
                self.timestamps.append(line["timestamp"])
            if not line.get("isSidechain"):
                branch, cwd = line.get("gitBranch"), line.get("cwd")
                # HEAD は detached か git の外（hc の監督役の作業場所など）なのでブランチとみなさない
                if isinstance(branch, str) and branch and branch != "HEAD":
                    self.branches[branch] = self.branches.get(branch, 0) + 1
                if isinstance(cwd, str) and cwd:
                    self.cwds[cwd] = self.cwds.get(cwd, 0) + 1

    def _line(self, line: dict, stream: Stream, tools: dict) -> None:
        kind, message = line.get("type"), line.get("message")
        message = message if isinstance(message, dict) else {}
        content = message.get("content")
        blocks = [block for block in content if isinstance(block, dict)] if isinstance(content, list) else []
        if kind == "system" and line.get("subtype") == "compact_boundary":
            stream.compact_boundaries += 1
            stream.compact_after.append(len(stream.requests) - 1)
        elif kind == "assistant":
            previous_kind, stream.last_kind = stream.last_kind, "assistant"
            tool_ids = []
            for block in blocks:
                if block.get("type") == "tool_use" and isinstance(block.get("id"), str):
                    tools[block["id"]] = (str(block.get("name", "unknown")), block.get("input"))
                    stream.tool_order.append(block["id"])
                    tool_ids.append(block["id"])
            usage = message.get("usage")
            if not isinstance(usage, dict):
                self.skipped["no_usage"] += 1
                return
            model = str(message.get("model", "unknown"))
            if model == SYNTHETIC_MODEL:
                self.skipped["synthetic"] += 1  # API を呼んでいない合成メッセージ（中断・エラー表示など）
                return
            request = normalize_usage(usage, model)
            key = line.get("requestId") or message.get("id")
            request.update(timestamp=line.get("timestamp"), request_id=key if isinstance(key, str) else None)
            if isinstance(key, str) and key in stream.request_index:
                index = stream.request_index[key]
                first = stream.requests[index]
                request.update(prev=first["prev"], first_timestamp=first["first_timestamp"])
                stream.requests[index] = request  # 同じリクエストは後の行を採用する
            else:
                index = len(stream.requests)
                if isinstance(key, str):
                    stream.request_index[key] = index
                request.update(prev=previous_kind, first_timestamp=line.get("timestamp"))
                stream.requests.append(request)
            for tool_id in tool_ids:
                stream.tool_request[tool_id] = index
        elif kind == "user":
            has_result = False
            for block in blocks:
                if block.get("type") == "tool_result":
                    has_result = True
                    tool_id, data = str(block.get("tool_use_id", "")), result_bytes(block.get("content"))
                    stream.tool_results.append((tool_id, data))
                    stream.results.append({"id": tool_id, "data": data, "is_error": block.get("is_error") is True,
                                           "timestamp": line.get("timestamp"),
                                           "after": len(stream.requests) - 1})
            if has_result:
                stream.last_kind = "tool_result"
            elif not line.get("isMeta"):
                stream.last_kind = "human"
                if stream.first_human is None:
                    stream.first_human = result_bytes(content).decode(errors="replace")


# ---- 指標の計算 -------------------------------------------------------------

def l0(requests: list[dict], weights: dict) -> dict:
    tokens = {key: sum(request[key] for request in requests) for key in TOKEN_KEYS}
    tokens["cache_creation"] = tokens["cache_creation_5m"] + tokens["cache_creation_1h"]
    cost = sum(weight * tokens[key] for key, weight in weights.items())
    return {"tokens": tokens, "weighted_cost": cost}


def rates(tokens: dict, cost: float, weights: dict) -> tuple[float | None, float | None]:
    """(家賃率, 再読倍率) を返す。"""
    rent = weights["cache_read"] * tokens["cache_read"] / cost if cost else None
    fresh = tokens["input"] + tokens["cache_creation"]
    return rent, (tokens["cache_read"] / fresh if fresh else None)


def l1(streams: list[Stream], base: dict, weights: dict) -> dict:
    contexts, drops, index = [], [], 0
    for stream in streams:
        previous = None
        for request in stream.requests:
            current = request["context"]
            if previous is not None and current < previous * DROP_RATIO and previous - current >= DROP_MIN_TOKENS:
                drops.append({"request_index": index, "from": previous, "to": current})
            contexts.append(current)
            previous, index = current, index + 1
    count = len(contexts)
    deciles = []
    for bucket in range(10):
        part = contexts[bucket * count // 10:(bucket + 1) * count // 10]
        deciles.append(sum(part) / len(part) if part else None)
    rent, reread = rates(base["tokens"], base["weighted_cost"], weights)
    return {
        "requests": count,
        "context": {"mean": sum(contexts) / count if count else None, "max": max(contexts, default=None),
                    "last": contexts[-1] if contexts else None, "deciles": deciles},
        "rent_rate": rent,
        "reread_ratio": reread,
        "drops": drops,
        "drop_rule": {"ratio_below": DROP_RATIO, "min_tokens": DROP_MIN_TOKENS},
        "compact_boundaries": sum(stream.compact_boundaries for stream in streams),
    }


def _rate(novel: int, raw: int) -> float | None:
    return novel / raw if raw else None


def _low_list(low: dict) -> list[dict]:
    items = sorted(low.items(), key=lambda item: (-item[1]["raw_bytes"], item[0]))
    return [{"key": key, **value} for key, value in items[:LOW_LIMIT]]


def l2(streams: list[Stream]) -> dict:
    by_tool: dict[str, dict] = {}
    low: dict[str, dict] = {}
    for stream in streams:
        history = ToolHistory()
        for tool_id, data in stream.tool_results:
            if len(data) < MIN_BYTES:
                history.add(data)
                continue
            novel = history.novel_bytes(data)
            name, tool_input = stream.tools.get(tool_id, ("unknown", None))
            entry = by_tool.setdefault(name, {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
            entry["count"] += 1
            entry["raw_bytes"] += len(data)
            entry["novel_bytes"] += novel
            if novel / len(data) < LOW_RATE:
                item = low.setdefault(command_key(name, tool_input), {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
                item["count"] += 1
                item["raw_bytes"] += len(data)
                item["novel_bytes"] += novel
    for entry in by_tool.values():
        entry["new_info_rate"] = _rate(entry["novel_bytes"], entry["raw_bytes"])
    raw = sum(entry["raw_bytes"] for entry in by_tool.values())
    novel = sum(entry["novel_bytes"] for entry in by_tool.values())
    return {
        "window_bytes": WINDOW_BYTES, "min_bytes": MIN_BYTES, "low_threshold": LOW_RATE,
        "tool_results": sum(entry["count"] for entry in by_tool.values()),
        "raw_bytes": raw, "novel_bytes": novel, "new_info_rate": _rate(novel, raw),
        "by_tool": dict(sorted(by_tool.items())), "low_new_info": _low_list(low),
    }


def scope_metrics(streams: list[Stream], weights: dict) -> dict:
    requests = [request for stream in streams for request in stream.requests]
    base = l0(requests, weights)
    by_model = {}
    for model in sorted({request["model"] for request in requests}):
        subset = [request for request in requests if request["model"] == model]
        model_l0 = l0(subset, weights)
        by_model[model] = {"requests": len(subset), **model_l0}
    return {"L0": base, "L1": l1(streams, base, weights), "L2": l2(streams), "by_model": by_model}


def total_metrics(scopes: list[dict], all_requests: list[dict], weights: dict) -> dict:
    base = l0(all_requests, weights)
    rent, reread = rates(base["tokens"], base["weighted_cost"], weights)
    low: dict[str, dict] = {}
    for scope in scopes:
        for item in scope["L2"]["low_new_info"]:
            merged = low.setdefault(item["key"], {"count": 0, "raw_bytes": 0, "novel_bytes": 0})
            for key in merged:
                merged[key] += item[key]
    raw = sum(scope["L2"]["raw_bytes"] for scope in scopes)
    novel = sum(scope["L2"]["novel_bytes"] for scope in scopes)
    return {"requests": len(all_requests), **base, "rent_rate": rent, "reread_ratio": reread,
            "tool_results": sum(scope["L2"]["tool_results"] for scope in scopes),
            "raw_bytes": raw, "novel_bytes": novel, "new_info_rate": _rate(novel, raw),
            "low_new_info": _low_list(low)}


# ---- 無駄の検出（waste） -----------------------------------------------------
#
# transcript の項目（ツール結果のバイト列とハッシュ、ツールの input、is_error、usage、時刻）と
# 設定の閾値だけで、決定的に無駄なトークンを数える。ルールはストリームごとに独立に適用する。

WASTE_SCHEMA = "claude-token-metrics/waste/v1"
WASTE_RULES = ("oversized_output", "duplicate_result", "reread_file", "repeated_failure",
               "cache_rewrite", "context_bloat", "over_delegation")
OVER_DELEGATION_KINDS = ("trivial", "duplicate")
AGENT_TOOLS = ("Agent", "Task")
CACHE_CAUSES = ("idle", "tool_wait", "break")
EDIT_TOOLS = ("Edit", "MultiEdit", "Write", "NotebookEdit")
TTL_5M, TTL_1H = 300, 3600
DEFAULT_WASTE = {
    "oversized_bytes": 20000,
    "min_bytes": 200,
    "exempt_keys": ["Edit", "MultiEdit", "NotebookEdit", "Write"],  # 編集の成功メッセージは避けられない
    "failure_streak": 3,
    "cache_miss_ratio": 0.5,
    "cache_ttl_seconds": None,  # None なら 1h cache を書いていれば 3600 秒、なければ 300 秒
    "context_budget": 200000,  # claude-context-guard の既定の閾値（対話）と同じ
    "findings_limit": 50,
    "bytes_per_token": 2.2,  # 根拠は docs/claude-token-metrics.md
    # 委譲（over_delegation、hints.under_delegation）
    "trivial_requests": 3,
    "trivial_tool_calls": 2,
    "exempt_agent_types": ["web-fetch"],  # ツールの代わりとして使う型
    "under_delegation_bytes": 400000,
    # 作り直し（restart）
    "resume_markers": ["【再開】"],
    "resume_window": 5,
    "supervisor_handoff_paths": ["hc-supervisor/handoff.md"],
    "startup_cap": 20,
    "handoff_tail": 10,
    "handoff_write_paths": ["codex-handoffs/", "hc-supervisor/handoff.md"],
    # タスク（Issue）単位の集計（report --by task、#48）。最初のグループを Issue の番号とみなす
    "task_branch_pattern": r"(?:^|/)(?:issue|epic)-(\d+)",
}
LIST_KEYS = ("exempt_keys", "exempt_agent_types", "resume_markers", "supervisor_handoff_paths",
             "handoff_write_paths")
READ_LINE = re.compile(rb"^\s*\d+(?:\t|\xe2\x86\x92)", re.MULTILINE)  # Read の結果の行番号（N\t か N→）


def waste_config_path() -> Path:
    return config_path().with_name("waste.json")


def _is_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _is_number(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def _valid_branch_pattern(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        return re.compile(value).groups >= 1
    except re.error:
        return False


def _waste_value(key: str, value: object) -> object:
    checks = {
        "oversized_bytes": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "min_bytes": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "failure_streak": (lambda v: _is_int(v) and v >= 2, "2 以上の整数"),
        "findings_limit": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "context_budget": (lambda v: _is_int(v) and v >= 1, "1 以上の整数"),
        "cache_miss_ratio": (lambda v: _is_number(v) and 0 < v <= 1, "0 より大きく 1 以下の数値"),
        "cache_ttl_seconds": (lambda v: v is None or (_is_number(v) and v > 0), "null か 0 より大きい数値"),
        "bytes_per_token": (lambda v: _is_number(v) and v > 0, "0 より大きい数値"),
        "trivial_requests": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "trivial_tool_calls": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "under_delegation_bytes": (lambda v: _is_int(v) and v >= 0, "0 以上の整数"),
        "resume_window": (lambda v: _is_int(v) and v >= 1, "1 以上の整数"),
        "startup_cap": (lambda v: _is_int(v) and v >= 1, "1 以上の整数"),
        "handoff_tail": (lambda v: _is_int(v) and v >= 1, "1 以上の整数"),
    }
    checks["task_branch_pattern"] = (_valid_branch_pattern, "グループを 1 つ以上持つ正規表現の文字列")
    for list_key in LIST_KEYS:
        checks[list_key] = (lambda v: isinstance(v, list) and all(isinstance(item, str) for item in v),
                            "文字列の配列")
    check, expected = checks[key]
    if not check(value):
        raise ValueError(f"waste の {key} は{expected}にしてください: {value!r}")
    return sorted(set(value)) if key in LIST_KEYS else value


def _waste_overrides(path: Path, *, required: bool) -> dict | None:
    """waste.json の形のファイルから "waste" を読む。無ければ None。"""
    if not path.is_file():
        if required:
            raise ValueError(f"{path}: ファイルがありません")
        return None
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise ValueError(f"{path}: JSON として読めません（{error}）") from None
    overrides = data.get("waste", {}) if isinstance(data, dict) else None
    if not isinstance(overrides, dict):
        raise ValueError(f"{path}: {{\"waste\": {{...}}}} の形にしてください")
    return overrides


def load_waste_config(cli_path: str | None = None, path: Path | None = None) -> tuple[dict, str, list[str]]:
    """無駄検出の設定を既定値 < waste.json < --waste-config の順で決め、(設定, 出所, 警告) を返す。

    型・範囲が不正なら ValueError。知らないキーは警告にして無視する。"""
    config, source, warnings = json.loads(json.dumps(DEFAULT_WASTE)), "default", []
    for candidate, required, name in ((waste_config_path() if path is None else path, False, "file"),
                                      (Path(cli_path) if cli_path else None, True, "cli")):
        if candidate is None:
            continue
        overrides = _waste_overrides(candidate, required=required)
        if overrides is None:
            continue
        for key, value in overrides.items():
            if key not in DEFAULT_WASTE:
                warnings.append(f"{candidate}: 知らないキー waste.{key} を無視します")
                continue
            config[key] = _waste_value(key, value)
        source = name
    return config, source, warnings


def config_hash(config: dict) -> str:
    text = json.dumps(config, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(text.encode()).hexdigest()[:12]


def context_budget_from_env() -> tuple[int | None, str | None]:
    """record 時の CLAUDE_CTX_GUARD_TOKENS を読む。(値, 不正なときの警告) を返す。"""
    raw = os.environ.get("CLAUDE_CTX_GUARD_TOKENS")
    if raw is None or not raw.strip():
        return None, None
    try:
        value = int(raw)
    except ValueError:
        value = 0
    if value < 1:
        return None, f"CLAUDE_CTX_GUARD_TOKENS が 1 以上の整数ではないため無視します: {raw!r}"
    return value, None


def _cc_weight(request: dict, weights: dict) -> float:
    """cache 作成の多い方（5m / 1h）の重み。"""
    if request["cache_creation_1h"] > request["cache_creation_5m"]:
        return weights["cache_creation_1h"]
    return weights["cache_creation_5m"]


def _segments(stream: Stream) -> tuple[list[int], list[int], int]:
    """リクエストごとの区切りの番号、その区切りの最後のリクエストの位置、末尾の後の区切り番号を返す。

    区切りは compact_boundary か、文脈の急減（L1 の drops と同じ条件）。"""
    requests, compact = stream.requests, set(stream.compact_after)
    segment, current = [], 0
    for index, request in enumerate(requests):
        if index:
            before, now = requests[index - 1]["context"], request["context"]
            if index - 1 in compact or (now < before * DROP_RATIO and before - now >= DROP_MIN_TOKENS):
                current += 1
        segment.append(current)
    last = {value: index for index, value in enumerate(segment)}
    tail = current + 1 if requests and len(requests) - 1 in compact else current
    return segment, [last[value] for value in segment], tail


def _estimates(stream: Stream, segment: list[int], bytes_per_token: float) -> list[tuple[float, str]]:
    """ツール結果ごとの (推定トークン数, delta|bytes)。

    呼び出しを出したリクエスト R_k と次のリクエスト R_k+1 が同じ区切りにあり、
    Δ = 文脈(R_k+1) − 文脈(R_k) − output(R_k) > 0 なら、その間のツール結果に Δ をバイト数の比で配る。"""
    requests, results = stream.requests, stream.results
    groups: dict[int, list[int]] = {}
    for index, result in enumerate(results):
        groups.setdefault(result["after"], []).append(index)
    estimates: list[tuple[float, str]] = [(0.0, "bytes")] * len(results)
    for after, indexes in groups.items():
        total = sum(len(results[index]["data"]) for index in indexes)
        delta = 0
        if 0 <= after and after + 1 < len(requests) and segment[after] == segment[after + 1]:
            delta = requests[after + 1]["context"] - requests[after]["context"] - requests[after]["output"]
        for index in indexes:
            size = len(results[index]["data"])
            if delta > 0 and total > 0:
                estimates[index] = (delta * size / total, "delta")
            else:
                estimates[index] = (size / bytes_per_token, "bytes")
    return estimates


def _read_range(tool_input: object, data: bytes) -> tuple[int, int]:
    """Read の (開始行, 行数)。開始行は offset（既定 1）、行数は結果の行番号つきの行の数。"""
    offset = tool_input.get("offset") if isinstance(tool_input, dict) else None
    start = offset if _is_int(offset) and offset >= 1 else 1
    count = len(READ_LINE.findall(data))
    if not count and data:
        count = data.count(b"\n") + (0 if data.endswith(b"\n") else 1)
    return start, count


def _overlap(start: int, end: int, ranges: list[tuple[int, int]]) -> int:
    """[start, end] のうち、ranges（閉区間）の和集合に入る行数。"""
    covered, cursor = 0, start
    for low, high in sorted(ranges):
        low, high = max(low, cursor), min(high, end)
        if low <= high:
            covered += high - low + 1
            cursor = high + 1
    return covered


class StreamWaste:
    """1 ストリームの無駄を数える。"""

    def __init__(self, stream: Stream, scope: str, file: str, weights: dict, config: dict):
        self.stream, self.scope, self.file = stream, scope, file
        self.weights, self.config = weights, config
        self.segment, self.segment_end, self.tail = _segments(stream)
        self.findings: list[dict] = []
        self.streaks: list[dict] = []
        # リクエストの位置 -> そのリクエストで文脈に入った、ツール結果のルールで数えたトークン
        self.resident: dict[int, float] = {}

    # -- 共通 --
    def residence_cost(self, tokens: float, read: int | None) -> float:
        """t × (w_cc + w_cr × (n − 1))。n は R_k+1 から区切り（なければ末尾）までのリクエスト数。"""
        if read is None:
            return 0.0  # 次のリクエストがない（文脈に入らずに終わった）
        reads = self.segment_end[read] - read + 1
        request = self.stream.requests[read]
        return tokens * (_cc_weight(request, self.weights) + self.weights["cache_read"] * (reads - 1))

    def finding(self, rule: str, *, index: int | None, timestamp: object, tool_use_id: str | None,
                key: str | None, tokens: float, source: str | None, cost: float, detail: dict) -> None:
        self.findings.append({"rule": rule, "scope": self.scope, "file": self.file, "request_index": index,
                              "timestamp": timestamp, "tool_use_id": tool_use_id, "key": key,
                              "tokens": tokens, "token_source": source, "weighted_cost": cost,
                              "detail": detail})

    # -- ツール結果のルール --
    def tool_rules(self) -> None:
        stream, config = self.stream, self.config
        requests, results = stream.requests, stream.results
        estimates = _estimates(stream, self.segment, config["bytes_per_token"])
        exempt = set(config["exempt_keys"])
        current = None
        hashes: dict[str, str] = {}  # sha256 -> 最初の tool_use_id（今の区切りの中）
        reads: dict[str, list[tuple[int, int, str, str]]] = {}  # path -> (開始, 終了, sha256, tool_use_id)
        failures: dict[str, str] = {}  # 正規化した呼び出し -> 最初に失敗した tool_use_id
        runs: dict[str, dict] = {}  # command_key -> 続いている失敗
        outputs_counted: set[int] = set()
        for position, result in enumerate(results):
            tool_id, data = result["id"], result["data"]
            name, tool_input = stream.tools.get(tool_id, ("unknown", None))
            key = command_key(name, tool_input)
            read = result["after"] + 1 if result["after"] + 1 < len(requests) else None
            segment = self.segment[read] if read is not None else self.tail
            if segment != current:
                current = segment
                hashes.clear()
                reads.clear()
            size, digest = len(data), hashlib.sha256(data).hexdigest()
            tokens, source = estimates[position]
            owner = stream.tool_request.get(tool_id, result["after"] if result["after"] >= 0 else None)
            match = None  # (rule, 数えたツール結果のトークン, 追加の output, detail)

            if result["is_error"]:
                signature = name + "\0" + json.dumps(tool_input, sort_keys=True, ensure_ascii=False)
                if signature in failures:
                    match = ("repeated_failure", tokens, 0, {"first_tool_use_id": failures[signature]})
                else:
                    failures[signature] = tool_id
                run = runs.setdefault(key, {"count": 0, "first": tool_id, "position": position})
                run["count"] += 1
                run["last"] = tool_id
            elif key in runs:
                self.close_run(key, runs.pop(key))

            if size >= config["min_bytes"]:
                if digest in hashes and match is None and key not in exempt:
                    match = ("duplicate_result", tokens, 0,
                             {"bytes": size, "sha256": digest[:12], "first_tool_use_id": hashes[digest]})
                hashes.setdefault(digest, tool_id)

            path = tool_input.get("file_path") if isinstance(tool_input, dict) else None
            if name == "Read" and isinstance(path, str) and not result["is_error"]:
                start, count = _read_range(tool_input, data)
                end = start + count - 1
                previous = reads.setdefault(path, [])
                if match is None and count and previous and all(item[2] != digest for item in previous):
                    overlap = _overlap(start, end, [(item[0], item[1]) for item in previous])
                    if overlap:
                        match = ("reread_file", tokens * overlap / count, 0,
                                 {"path": path, "lines": [start, end], "overlap_lines": overlap,
                                  "first_tool_use_id": previous[0][3]})
                previous.append((start, end, digest, tool_id))

            limit = config["oversized_bytes"]
            if match is None and size > limit and key not in exempt:
                match = ("oversized_output", tokens * (size - limit) / size, 0,
                         {"bytes": size, "threshold": limit})

            if match is not None:
                rule, counted, extra, detail = match
                cost = self.residence_cost(counted, read)
                if rule == "repeated_failure" and owner is not None and owner not in outputs_counted:
                    outputs_counted.add(owner)
                    extra = requests[owner]["output"]
                    cost += extra * self.weights["output"]
                if rule == "repeated_failure":
                    detail.update(tool_tokens=counted, output_tokens=extra)
                if read is not None:
                    self.resident[read] = self.resident.get(read, 0.0) + counted
                self.finding(rule, index=owner, timestamp=result["timestamp"], tool_use_id=tool_id, key=key,
                             tokens=counted + extra, source=source, cost=cost, detail=detail)

            # 変更の可能性がある呼び出しの後は、読み直し・失敗の繰り返しとみなさない。
            if name in EDIT_TOOLS:
                failures.clear()
                if isinstance(tool_input, dict):
                    reads.pop(tool_input.get("file_path") or tool_input.get("notebook_path"), None)
            elif name == "Bash" and isinstance(tool_input, dict):
                command = str(tool_input.get("command", ""))
                for target in [target for target in reads if target in command]:
                    del reads[target]
        for key in list(runs):
            self.close_run(key, runs.pop(key))

    def close_run(self, key: str, run: dict) -> None:
        if run["count"] >= self.config["failure_streak"]:
            self.streaks.append({"scope": self.scope, "file": self.file, "key": key, "count": run["count"],
                                 "first_tool_use_id": run["first"], "last_tool_use_id": run["last"],
                                 "_position": run["position"]})

    # -- cache 切れ後の書き直し --
    def cache_rewrite(self) -> None:
        requests, weights, config = self.stream.requests, self.weights, self.config
        compact = set(self.stream.compact_after)
        wrote_1h = False
        for index in range(1, len(requests)):
            before, request = requests[index - 1], requests[index]
            wrote_1h = wrote_1h or before["cache_creation_1h"] > 0
            if index - 1 in compact or not request["cache_read"] < before["context"] * config["cache_miss_ratio"]:
                continue
            created = request["cache_creation_5m"] + request["cache_creation_1h"]
            tokens = min(created, before["context"] - request["cache_read"])
            if tokens <= 0:
                continue
            ttl = config["cache_ttl_seconds"] or (TTL_1H if wrote_1h else TTL_5M)
            start, end = epoch(before.get("first_timestamp")), epoch(request.get("first_timestamp"))
            gap = end - start if start is not None and end is not None else None
            if gap is None or gap <= ttl:
                cause = "break"
            else:
                cause = "idle" if request.get("prev") == "human" else "tool_wait"
            cost = tokens * (_cc_weight(request, weights) - weights["cache_read"])
            self.finding("cache_rewrite", index=index, timestamp=request.get("first_timestamp"),
                         tool_use_id=None, key=None, tokens=tokens, source=None, cost=cost,
                         detail={"cause": cause, "gap_seconds": gap, "ttl_seconds": ttl,
                                 "cache_read": request["cache_read"], "previous_context": before["context"]})

    # -- 文脈の肥大（本体だけ） --
    def context_bloat(self, budget: int) -> int:
        """予算を超えた分から、他のルールで数えて文脈に残っている分を引いて数える。
        予算を最初に超えたリクエストより後のリクエスト数を返す。"""
        current, resident, first_over = None, 0.0, None
        requests = self.stream.requests
        for index, request in enumerate(requests):
            if self.segment[index] != current:
                current, resident = self.segment[index], 0.0
            resident += self.resident.get(index, 0.0)
            excess = request["context"] - budget - resident
            if excess > 0:
                self.finding("context_bloat", index=index, timestamp=request.get("first_timestamp"),
                             tool_use_id=None, key=None, tokens=excess, source=None,
                             cost=excess * self.weights["cache_read"],
                             detail={"context": request["context"], "budget": budget, "resident_waste": resident})
            if request["context"] > budget and first_over is None:
                first_over = index
        return 0 if first_over is None else len(requests) - first_over - 1


# ---- 委譲（delegation）と作り直し（restart） --------------------------------------

def _agent_meta(path: Path) -> dict | None:
    """agent-<id>.meta.json を読む。無い・読めない・形が違うときは None（unlinked に倒す）。"""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _bytes_sum(stream: Stream, keep) -> int:
    return sum(len(result["data"]) for result in stream.results if keep(result["id"]))


def delegation_metrics(path: Path, streams: list[tuple[str, str, Stream]], weights: dict,
                       session_cost: float) -> dict:
    """本体の Agent 呼び出しとサブエージェントの対応づけ、委譲の量と効果（Issue #47）。"""
    main = streams[0][2]
    subagents = [(file, stream) for scope, file, stream in streams if scope == "subagents"]
    is_agent = lambda tool_id: main.tools.get(tool_id, ("", None))[0] in AGENT_TOOLS  # noqa: E731
    calls = [tool_id for tool_id in main.tool_order if is_agent(tool_id)]
    errors = {result["id"] for result in main.results if result["is_error"]}
    result_size = {result["id"]: len(result["data"]) for result in main.results}

    # 同じ prompt と subagent_type の Agent 呼び出し。前の呼び出しが失敗していれば、やり直しとして数えない。
    duplicate_of: dict[str, str] = {}
    last: dict[tuple[str, str], str] = {}
    for tool_id in calls:
        tool_input = main.tools[tool_id][1]
        if not isinstance(tool_input, dict) or not isinstance(tool_input.get("prompt"), str):
            continue
        key = (hashlib.sha256(tool_input["prompt"].encode()).hexdigest(), str(tool_input.get("subagent_type")))
        if key in last and last[key] not in errors:
            duplicate_of[tool_id] = last[key]
        last[key] = tool_id

    agents, unlinked = [], 0
    for file, stream in subagents:
        meta = _agent_meta(path.parent / path.stem / "subagents" / (Path(file).stem + ".meta.json"))
        tool_id = meta.get("toolUseId") if meta and isinstance(meta.get("toolUseId"), str) else None
        if tool_id is None:
            unlinked += 1
        call = main.tools.get(tool_id, ("", None))[1] if tool_id else None
        agent_type = meta.get("agentType") if meta else None
        if not isinstance(agent_type, str):
            agent_type = call.get("subagent_type") if isinstance(call, dict) and isinstance(
                call.get("subagent_type"), str) else None
        base = l0(stream.requests, weights)
        tokens = base["tokens"]
        first = stream.requests[0] if stream.requests else None
        cold = ({"input": first["input"], "cache_creation_5m": first["cache_creation_5m"],
                 "cache_creation_1h": first["cache_creation_1h"]} if first else None)
        agents.append({
            "file": file, "tool_use_id": tool_id, "agent_type": agent_type,
            "model": meta.get("model") if meta and isinstance(meta.get("model"), str) else None,
            "requests": len(stream.requests), "tool_calls": len(stream.tool_request),
            "weighted_cost": round(base["weighted_cost"], 4),
            "tokens": sum(tokens[key] for key in ("input", "cache_creation", "cache_read", "output")),
            "cold_start_tokens": sum(cold.values()) if cold else 0,
            "cold_start_cost": round(sum(weights[key] * value for key, value in cold.items()), 4) if cold else 0,
            "result_bytes": result_size.get(tool_id) if tool_id else None,
            "duplicate_of": duplicate_of.get(tool_id) if tool_id else None,
        })
    agents.sort(key=lambda item: (item["tool_use_id"] is None, item["file"]))

    sub_cost = sum(item["weighted_cost"] for item in agents)
    sub_bytes = sum(_bytes_sum(stream, lambda _: True) for _, stream in subagents)
    agent_bytes = _bytes_sum(main, is_agent)
    return {
        "agent_calls": len(calls),
        "subagent_cost_share": round(sub_cost / session_cost, 6) if session_cost else None,
        "subagent_tool_bytes": sub_bytes,
        "agent_result_bytes": agent_bytes,
        "compression": round(agent_bytes / sub_bytes, 6) if sub_bytes else None,
        "main_tool_bytes": _bytes_sum(main, lambda tool_id: not is_agent(tool_id)),
        "unlinked": unlinked,
        "agents": agents,
    }


def restart_metrics(main: Stream, weights: dict, config: dict) -> dict:
    """セッションが作り直し（handoff からの再開・監督役の再起動）か、立ち上げにかかったコスト（Issue #47）。"""
    requests = main.requests
    errors = {result["id"] for result in main.results if result["is_error"]}
    calls = []  # (リクエストの位置, ツール名, input)
    for tool_id in main.tool_order:
        index = main.tool_request.get(tool_id)
        if index is not None:
            name, tool_input = main.tools[tool_id]
            if tool_id not in errors:  # 失敗した呼び出し（無いファイルの Read など）は数えない
                calls.append((index, name, tool_input if isinstance(tool_input, dict) else {}))

    def touches(name: str, tool_input: dict, paths: list[str], names: tuple[str, ...]) -> bool:
        target = tool_input.get("file_path") if name in names else None
        command = tool_input.get("command") if name == "Bash" and "Bash" in names else None
        return any((isinstance(target, str) and path in target) or (isinstance(command, str) and path in command)
                   for path in paths)

    # hc は依頼を <pasted_content>・<hc …> で包むので、マーカーは先頭でなくいずれかの行の頭にあればよい
    lines = [line.lstrip() for line in (main.first_human or "").splitlines()]
    if any(line.startswith(marker) for line in lines for marker in config["resume_markers"]):
        kind = "resume_worker"
    elif any(index < config["resume_window"]
             and touches(name, tool_input, config["supervisor_handoff_paths"], ("Read", "Bash"))
             for index, name, tool_input in calls):
        kind = "resume_supervisor"
    else:
        kind = "fresh"

    def starts_work(name: str, tool_input: dict) -> bool:
        return name in EDIT_TOOLS or (name == "Bash" and "git commit" in str(tool_input.get("command", "")))

    work = [index for index, name, tool_input in calls if starts_work(name, tool_input)]
    startup = min(min(work, default=len(requests)), config["startup_cap"], len(requests))
    startup_cost = sum(l0([request], weights)["weighted_cost"] for request in requests[:startup])
    tail = len(requests) - config["handoff_tail"]
    ended = any(index >= tail and touches(name, tool_input, config["handoff_write_paths"], ("Write", "Edit"))
                for index, name, tool_input in calls)
    return {"kind": kind, "startup_requests": startup, "startup_cost": round(startup_cost, 4),
            "ended_with_handoff": ended}


def over_delegation_findings(delegation: dict, config: dict) -> list[dict]:
    """サブエージェント単位の無駄（trivial: cold start だけ、duplicate: 全部）。duplicate が優先。"""
    findings = []
    for agent in delegation["agents"]:
        if agent["tool_use_id"] is None or agent["requests"] == 0:
            continue  # 本体の呼び出しと対応づけられない（型も分からない）ものは数えない
        if agent["duplicate_of"]:
            kind, tokens, cost = "duplicate", agent["tokens"], agent["weighted_cost"]
            detail = {"first_tool_use_id": agent["duplicate_of"]}
        elif (agent["requests"] <= config["trivial_requests"] and agent["tool_calls"] <= config["trivial_tool_calls"]
              and agent["agent_type"] not in config["exempt_agent_types"]):
            kind, tokens, cost = "trivial", agent["cold_start_tokens"], agent["cold_start_cost"]
            detail = {"requests": agent["requests"], "tool_calls": agent["tool_calls"]}
        else:
            continue
        findings.append({"rule": "over_delegation", "scope": "subagents", "file": agent["file"],
                         "request_index": 0, "timestamp": None, "tool_use_id": agent["tool_use_id"],
                         "key": f"Agent:{agent['agent_type']}", "tokens": tokens, "token_source": None,
                         "weighted_cost": cost, "detail": {"kind": kind, "agent_type": agent["agent_type"],
                                                           **detail}})
    return findings


def _rule_total() -> dict:
    return {"count": 0, "tokens": 0.0, "weighted_cost": 0.0}


def _add(total: dict, finding: dict) -> None:
    total["count"] += 1
    total["tokens"] += finding["tokens"]
    total["weighted_cost"] += finding["weighted_cost"]


def _rounded(value: object, digits: int) -> object:
    return round(value, digits) if isinstance(value, float) else value


def waste_metrics(streams: list[tuple[str, str, Stream]], weights: dict, config: dict, source: str,
                  session_cost: float, budget: int | None = None, delegation: dict | None = None) -> dict:
    """streams は (scope, file, Stream) の一覧。budget が None なら config の context_budget を使う。
    delegation（delegation_metrics の結果）があれば over_delegation と under_delegation のヒントを足す。"""
    budget_source = "config" if budget is None else "env"
    budget = config["context_budget"] if budget is None else budget
    findings, streaks, after_budget = [], [], 0
    for scope, file, stream in streams:
        detector = StreamWaste(stream, scope, file, weights, config)
        detector.tool_rules()
        detector.cache_rewrite()
        if scope == "main":
            after_budget = detector.context_bloat(budget)
        findings.extend(detector.findings)
        streaks.extend(detector.streaks)

    over = over_delegation_findings(delegation, config) if delegation else []
    # duplicate に当たったサブエージェントの中の finding は数えない（over_delegation.duplicate が優先）。
    skipped = {item["file"] for item in over if item["detail"]["kind"] == "duplicate"}
    findings = [item for item in findings if not (item["scope"] == "subagents" and item["file"] in skipped)]
    streaks = [item for item in streaks if not (item["scope"] == "subagents" and item["file"] in skipped)]
    findings.extend(over)

    rules = {rule: _rule_total() for rule in WASTE_RULES}
    by_kind = {kind: _rule_total() for kind in OVER_DELEGATION_KINDS}
    causes = {cause: _rule_total() for cause in CACHE_CAUSES}
    for finding in findings:
        _add(rules[finding["rule"]], finding)
        if finding["rule"] == "cache_rewrite":
            _add(causes[finding["detail"]["cause"]], finding)
        elif finding["rule"] == "over_delegation":
            _add(by_kind[finding["detail"]["kind"]], finding)
    for totals in (*rules.values(), *causes.values(), *by_kind.values()):
        totals["tokens"], totals["weighted_cost"] = round(totals["tokens"], 1), round(totals["weighted_cost"], 4)
    rules["context_bloat"].update(budget=budget, budget_source=budget_source)
    rules["over_delegation"]["by_kind"] = by_kind
    tokens = sum(rules[rule]["tokens"] for rule in WASTE_RULES)
    cost = sum(rules[rule]["weighted_cost"] for rule in WASTE_RULES)

    scope_order = {"main": 0, "sidechain": 1, "subagents": 2}
    findings.sort(key=lambda item: (-item["weighted_cost"], scope_order.get(item["scope"], 3), item["file"],
                                    item["request_index"] if item["request_index"] is not None else -1,
                                    item["tool_use_id"] or "", WASTE_RULES.index(item["rule"])))
    for finding in findings:
        finding["tokens"] = round(finding["tokens"], 1)
        finding["weighted_cost"] = round(finding["weighted_cost"], 4)
        finding["detail"] = {key: _rounded(value, 1) for key, value in finding["detail"].items()}
    streaks.sort(key=lambda item: (scope_order.get(item["scope"], 3), item["file"], item["_position"]))
    for streak in streaks:
        del streak["_position"]
    return {
        "schema": WASTE_SCHEMA,
        "config": config, "config_hash": config_hash(config), "config_source": source,
        "rules": rules,
        "cache_rewrite_by_cause": causes,
        "total": {"tokens": round(tokens, 1), "weighted_cost": round(cost, 4),
                  "share": round(cost / session_cost, 6) if session_cost else None},
        "findings": findings[:config["findings_limit"]],
        "hints": {"failure_streaks": streaks, "requests_after_budget": after_budget,
                  "under_delegation": bool(delegation) and delegation["agent_calls"] == 0
                  and delegation["main_tool_bytes"] > config["under_delegation_bytes"]},
    }


# ---- セッションの集計 -----------------------------------------------------------

def read_session(path: Path) -> tuple[Transcript, list[tuple[str, str, Stream]], int]:
    """本体と subagents を読み、(Transcript, [(scope, file, Stream)], subagents のファイル数) を返す。"""
    transcript = Transcript()
    main, side = transcript.read(path, split_sidechain=True)
    files = sorted((path.parent / path.stem / "subagents").glob("*.jsonl"))
    streams = [("main", path.name, main), ("sidechain", path.name, side)]
    streams += [("subagents", file.name, transcript.read(file, split_sidechain=False)[0]) for file in files]
    return transcript, streams, len(files)


def default_waste_options() -> dict:
    return {"config": json.loads(json.dumps(DEFAULT_WASTE)), "source": "default", "budget": None}


def session_waste(transcript_path: str | Path, weights: dict, waste_options: dict | None = None) -> dict:
    """waste だけを求める（L2 の圧縮を計算しない）。"""
    options = waste_options or default_waste_options()
    _, streams, _ = read_session(Path(transcript_path))
    requests = [request for _, _, stream in streams for request in stream.requests]
    cost = l0(requests, weights)["weighted_cost"]
    return waste_metrics(streams, weights, options["config"], options["source"], cost, options.get("budget"),
                         delegation_metrics(Path(transcript_path), streams, weights, cost))


def session_metrics(transcript_path: str | Path, weights: dict, weights_source: str,
                    waste_options: dict | None = None) -> dict:
    """1 セッション分の指標を求める。出力の形は SCHEMA（claude-token-metrics/v1）。"""
    return _session_metrics(transcript_path, weights, weights_source, waste_options)[0]


def _session_metrics(transcript_path: str | Path, weights: dict, weights_source: str,
                     waste_options: dict | None = None) -> tuple[dict, Transcript]:
    path = Path(transcript_path)
    options = waste_options or default_waste_options()
    transcript, streams, file_count = read_session(path)
    main, side = streams[0][2], streams[1][2]
    subagents = [stream for _, _, stream in streams[2:]]

    scopes = {"main": scope_metrics([main], weights), "sidechain": scope_metrics([side], weights),
              "subagents": {"files": file_count, **scope_metrics(subagents, weights)}}
    all_requests = [request for stream in (main, side, *subagents) for request in stream.requests]
    total = total_metrics(list(scopes.values()), all_requests, weights)
    delegation = delegation_metrics(path, streams, weights, total["weighted_cost"])
    return {
        "schema": SCHEMA,
        "session_id": transcript.session_id or path.stem,
        "transcript_path": str(path),
        "version": transcript.version,
        "versions": sorted(transcript.versions),
        "started_at": min(transcript.timestamps, default=None),
        "ended_at": max(transcript.timestamps, default=None),
        "weights": weights,
        "weights_source": weights_source,
        "skipped": transcript.skipped,
        **scopes,
        "total": total,
        "delegation": delegation,
        "restart": restart_metrics(main, weights, options["config"]),
        "waste": waste_metrics(streams, weights, options["config"], options["source"],
                               total["weighted_cost"], options.get("budget"), delegation),
    }, transcript


# ---- サブコマンド -----------------------------------------------------------

def _cli_settings(args: argparse.Namespace, parser: argparse.ArgumentParser) -> tuple[dict, str, dict]:
    """--weights と --waste-config を読む。不正なら exit 2。"""
    try:
        weights, source = load_weights(args.weights)
        config, waste_source, warnings = load_waste_config(args.waste_config)
    except (ValueError, OSError) as error:
        parser.error(str(error))
    for warning in warnings:
        print(f"claude-token-metrics: {warning}", file=sys.stderr)
    return weights, source, {"config": config, "source": waste_source, "budget": None}


def command_session(args: argparse.Namespace, parser: argparse.ArgumentParser) -> int:
    weights, source, waste_options = _cli_settings(args, parser)
    if not Path(args.transcript).is_file():
        print(f"claude-token-metrics: トランスクリプトがありません: {args.transcript}", file=sys.stderr)
        return 1
    print(json.dumps(session_metrics(args.transcript, weights, source, waste_options), ensure_ascii=False))
    return 0


def _short(value: object, width: int) -> str:
    text = "-" if value is None else str(value)
    return text if len(text) <= width else text[:width - 1] + "…"


def _table(rows: list[tuple]) -> None:
    widths = [max(len(row[column]) for row in rows) for column in range(len(rows[0]) - 1)]
    for row in rows:
        print("  ".join(cell.ljust(width) for cell, width in zip(row, widths)) + "  " + row[-1])


def print_waste(waste: dict) -> None:
    total = waste["total"]
    print(f"無駄: {_count(total['tokens'])} トークン、重み付きコスト {_count(total['weighted_cost'])}"
          f"（セッションの {_percent(total['share'])}）  config {waste['config_hash']}（{waste['config_source']}）")
    rows = [("rule", "count", "tokens", "cost", "")]
    for rule, totals in waste["rules"].items():
        note = ""
        if rule == "cache_rewrite":
            note = ", ".join(f"{cause} {value['count']}" for cause, value in waste["cache_rewrite_by_cause"].items())
        elif rule == "context_bloat":
            note = f"予算 {totals['budget']}（{totals['budget_source']}）"
        elif rule == "over_delegation":
            note = ", ".join(f"{kind} {value['count']}" for kind, value in totals["by_kind"].items())
        rows.append((rule, str(totals["count"]), _count(totals["tokens"]), _count(totals["weighted_cost"]), note))
    _table(rows)
    hints = waste["hints"]
    print(f"予算を超えた後のリクエスト: {hints['requests_after_budget']}")
    if hints["under_delegation"]:
        print("委譲不足の可能性: 本体のツール結果が大きいのに Agent を使っていない（ヒント。無駄には数えない）")
    for streak in hints["failure_streaks"]:
        print(f"続いた失敗: {streak['key']} × {streak['count']}（{streak['scope']} {streak['first_tool_use_id']}〜）")
    if not waste["findings"]:
        return
    print()
    rows = [("rule", "scope", "req", "key", "tokens", "cost", "src", "tool_use_id / detail")]
    for finding in waste["findings"]:
        detail = finding["detail"]
        target = finding["tool_use_id"] or ""
        extra = detail.get("path") or detail.get("cause") or detail.get("sha256") or ""
        rows.append((finding["rule"], finding["scope"], _count(finding["request_index"]),
                     _short(finding["key"], 24), _count(finding["tokens"]), _count(finding["weighted_cost"]),
                     finding["token_source"] or "-", " ".join(filter(None, (target, str(extra))))))
    _table(rows)


def command_waste(args: argparse.Namespace, parser: argparse.ArgumentParser) -> int:
    weights, _, waste_options = _cli_settings(args, parser)
    if not Path(args.transcript).is_file():
        print(f"claude-token-metrics: トランスクリプトがありません: {args.transcript}", file=sys.stderr)
        return 1
    waste = session_waste(args.transcript, weights, waste_options)
    if args.json:
        print(json.dumps(waste, ensure_ascii=False))
    else:
        print_waste(waste)
    return 0


def _git(cwd: str, *args: str) -> str | None:
    """git -C <cwd> <args> の 1 行目。git が無い・cwd が無い・失敗・空なら None。"""
    if not cwd or not Path(cwd).is_dir():
        return None
    try:
        # 親の git（hook など）の GIT_DIR・GIT_INDEX_FILE などが残っていると、cwd ではなくそちらを見てしまう
        env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
        result = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=10,
                                check=False, env=env)
    except (OSError, subprocess.SubprocessError):
        return None
    lines = result.stdout.strip().splitlines()
    if result.returncode != 0 or not lines:
        return None
    return lines[0].strip() or None


def git_repo(cwd: str | None) -> str | None:
    """worktree でも本体のリポジトリ名になるよう、共通の git ディレクトリの親の名前を返す。"""
    common = _git(cwd or "", "rev-parse", "--path-format=absolute", "--git-common-dir")
    return (Path(common).parent.name or None) if common else None


def git_info(cwd: str | None, transcript_branch: str | None, *, use_git_branch: bool = True) -> dict:
    """record の git。branch は git のブランチ、取れなければ transcript の本体の行で最も多い gitBranch。"""
    branch = _git(cwd or "", "branch", "--show-current") if use_git_branch else None
    source = "git" if branch else ("transcript" if transcript_branch else None)
    return {"repo": git_repo(cwd), "branch": branch or transcript_branch, "branch_source": source}


def hc_info() -> dict:
    return {"terminal": os.environ.get("HC_TERMINAL_ID") or None, "role": os.environ.get("HC_CLAUDE_ROLE") or None}


def record_waste_options() -> dict:
    """record 用の設定。不正な設定は既定値にし、理由を stderr（record.log）に残す。"""
    try:
        config, source, warnings = load_waste_config()
    except (ValueError, OSError) as error:
        print(f"claude-token-metrics record: waste の設定が不正なため既定値で集計します: {error}", file=sys.stderr)
        options, warnings = default_waste_options(), []
    else:
        options = {"config": config, "source": source, "budget": None}
    budget, warning = context_budget_from_env()
    for message in (*warnings, *([warning] if warning else [])):
        print(f"claude-token-metrics record: {message}", file=sys.stderr)
    options["budget"] = budget
    return options


def record_foreground(raw: str) -> None:
    payload = json.loads(raw or "{}")
    if not isinstance(payload, dict):
        raise ValueError("hook の入力が JSON オブジェクトではありません")
    transcript = payload.get("transcript_path")
    if not isinstance(transcript, str) or not Path(transcript).is_file():
        raise ValueError(f"transcript_path がありません: {transcript!r}")
    weights, source = load_weights()
    options = record_waste_options()
    metrics, parsed = _session_metrics(transcript, weights, source, options)
    if isinstance(payload.get("session_id"), str):
        metrics["session_id"] = payload["session_id"]
    cwd = payload.get("cwd") if isinstance(payload.get("cwd"), str) else None
    try:
        git = git_info(cwd or parsed.most_common(parsed.cwds), parsed.most_common(parsed.branches))
    except Exception:  # noqa: BLE001 - git の情報が取れなくても記録は止めない
        git = {"repo": None, "branch": None, "branch_source": None}
    metrics.update({"recorded_at": now_text(), "reason": payload.get("reason"), "cwd": payload.get("cwd"),
                    "git": git, "hc": hc_info(), "ctx_budget": options["budget"]})
    append_records([metrics])


def now_text() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def append_records(records: list[dict]) -> None:
    path = sessions_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        for record in records:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def record_detached(raw: str) -> None:
    """集計を切り離した子プロセスに任せ、hook はすぐ返す（セッションの終了を待たせない）。"""
    log = data_dir() / "record.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as output:
        child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "record", "--foreground"],
                                 stdin=subprocess.PIPE, stdout=output, stderr=output,
                                 start_new_session=True, text=True)
    child.stdin.write(raw)
    child.stdin.close()


def command_record(args: argparse.Namespace) -> int:
    # hook から呼ばれるので、どんな失敗でも exit 0 で返す。
    try:
        raw = sys.stdin.read()
        (record_foreground if args.foreground else record_detached)(raw)
    except Exception as error:  # noqa: BLE001 - セッションを妨げないため全て握りつぶす
        stamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        print(f"{stamp} claude-token-metrics record: {error}", file=sys.stderr)
    return 0


def load_records(path: Path) -> list[dict]:
    """sessions.jsonl を読み、同じ session_id は後に記録したものを採用する。"""
    latest: dict[str, dict] = {}
    if not path.is_file():
        return []
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            record = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if isinstance(record, dict) and isinstance(record.get("session_id"), str):
            latest.pop(record["session_id"], None)
            latest[record["session_id"]] = record
    return list(latest.values())


def report_row(record: dict) -> dict:
    total = record.get("total") or {}
    context = ((record.get("main") or {}).get("L1") or {}).get("context") or {}
    return {
        "session_id": record["session_id"],
        "started_at": record.get("started_at"),
        "recorded_at": record.get("recorded_at"),
        "cwd": record.get("cwd"),
        "requests": total.get("requests"),
        "weighted_cost": total.get("weighted_cost"),
        "rent_rate": total.get("rent_rate"),
        "context_max": context.get("max"),
        "new_info_rate": total.get("new_info_rate"),
        "low_new_info_top": [item.get("key") for item in (total.get("low_new_info") or [])[:3]],
    }


def _percent(value: object) -> str:
    return f"{value * 100:.1f}%" if isinstance(value, (int, float)) else "-"


def _count(value: object) -> str:
    return f"{value:,.0f}" if isinstance(value, (int, float)) else "-"


def _started(record: dict) -> str:
    return record.get("started_at") or record.get("recorded_at") or ""


def command_report(args: argparse.Namespace, parser: argparse.ArgumentParser) -> int:
    records = load_records(sessions_path())
    if args.since:
        records = [record for record in records if _started(record)[:10] >= args.since]
    if args.by == "task":
        try:
            config, _, warnings = load_waste_config()
        except (ValueError, OSError) as error:
            parser.error(str(error))
        for warning in warnings:
            print(f"claude-token-metrics: {warning}", file=sys.stderr)
        return print_task_report(task_rows(records, config["task_branch_pattern"]), args.json)
    rows = [report_row(record) for record in records]
    rows.sort(key=lambda row: row["started_at"] or row["recorded_at"] or "")
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    header = ("started(UTC)", "session", "req", "cost", "rent", "ctx_max", "new_info", "low_new_info_top")
    lines = [header]
    for row in rows:
        lines.append(((row["started_at"] or "-")[:16].replace("T", " "), row["session_id"][:8],
                      _count(row["requests"]), _count(row["weighted_cost"]), _percent(row["rent_rate"]),
                      _count(row["context_max"]), _percent(row["new_info_rate"]),
                      ", ".join(row["low_new_info_top"]) or "-"))
    widths = [max(len(line[column]) for line in lines) for column in range(len(header) - 1)]
    for line in lines:
        print("  ".join(cell.ljust(width) for cell, width in zip(line, widths)) + "  " + line[-1])
    return 0


# ---- タスク（Issue）単位の集計（report --by task、rescan。#48） ------------------------

def task_key(record: dict, pattern: str) -> str:
    """記録からタスクの key を決める（record・rescan・古い記録に同じ規則を使う純粋な関数）。

    1. hc.role が supervisor → "supervisor"
    2. ブランチが pattern に当たる → "<repo>#<番号>"
    3. ブランチがあり main・master でない → "<repo>:<branch>"
    4. それ以外 → "cwd:<cwd>"
    repo が分からないときは "?" を使う。"""
    hc, git = record.get("hc"), record.get("git")
    hc, git = (hc if isinstance(hc, dict) else {}), (git if isinstance(git, dict) else {})
    if hc.get("role") == "supervisor":
        return "supervisor"
    branch, repo = git.get("branch"), git.get("repo") or "?"
    if isinstance(branch, str) and branch:
        match = re.search(pattern, branch)
        # グループが空や数字でない（設定の正規表現による）ときは番号とみなさず、次の規則に回す
        if match and isinstance(match.group(1), str) and match.group(1).isdigit():
            return f"{repo}#{int(match.group(1))}"
        if branch not in ("main", "master"):
            return f"{repo}:{branch}"
    return f"cwd:{record.get('cwd')}"


def _cost(value: object) -> float:
    return value if _is_number(value) else 0.0


def _share(numerator: float, denominator: float) -> float | None:
    return round(numerator / denominator, 6) if denominator else None


def task_rows(records: list[dict], pattern: str) -> list[dict]:
    """セッションの記録をタスクごとに 1 行にまとめる。始まりの早いタスクから並べる。"""
    groups: dict[str, list[dict]] = {}
    for record in sorted(records, key=_started):
        groups.setdefault(task_key(record, pattern), []).append(record)
    rows = []
    for key, items in groups.items():
        cost = sum(_cost((item.get("total") or {}).get("weighted_cost")) for item in items)
        with_restart = [item for item in items if isinstance(item.get("restart"), dict)]
        resumed = [item for item in with_restart if str(item["restart"].get("kind", "")).startswith("resume_")]
        with_waste = [item for item in items if isinstance(item.get("waste"), dict)]
        rules: dict[str, float] = {}
        for item in with_waste:
            for rule, totals in (item["waste"].get("rules") or {}).items():
                rules[rule] = rules.get(rule, 0.0) + _cost((totals or {}).get("weighted_cost"))
        hashes = sorted({item["waste"]["config_hash"] for item in with_waste
                         if isinstance(item["waste"].get("config_hash"), str)})
        contexts = [(((item.get("main") or {}).get("L1") or {}).get("context") or {}).get("max") for item in items]
        contexts = [value for value in contexts if _is_number(value)]
        models = {model for item in items for scope in ("main", "sidechain", "subagents")
                  for model in ((item.get(scope) or {}).get("by_model") or {})}
        sub_cost = sum(_cost(((item.get("subagents") or {}).get("L0") or {}).get("weighted_cost")) for item in items)
        rows.append({
            "task": key,
            "sessions": len(items),
            "resumed": len(resumed) if with_restart else None,
            "requests": int(sum(_cost((item.get("total") or {}).get("requests")) for item in items)),
            "weighted_cost": round(cost, 4),
            "restart_ratio": _share(sum(_cost(item["restart"].get("startup_cost")) for item in resumed), cost)
            if with_restart else None,
            "subagent_cost_share": _share(sub_cost, cost),
            "waste_share": _share(sum(_cost((item["waste"].get("total") or {}).get("weighted_cost"))
                                      for item in with_waste), cost) if with_waste else None,
            "waste_top": [rule for rule, value in sorted(rules.items(), key=lambda pair: (-pair[1], pair[0]))
                          if value > 0][:3],
            "context_max": max(contexts, default=None),
            "models": sorted(models - {SYNTHETIC_MODEL}),
            "config_hashes": hashes,
            "sessions_without_waste": len(items) - len(with_waste),
            "started_at": _started(items[0]) or None,
            "session_ids": [item["session_id"] for item in items],
        })
    return rows


def print_task_report(rows: list[dict], as_json: bool) -> int:
    if as_json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    header = ("task", "sess", "resumed", "req", "cost", "restart", "subagent", "waste", "no_waste", "ctx_max",
              "models", "waste_top")
    lines = [header]
    for row in rows:
        lines.append((row["task"], str(row["sessions"]), _short(row["resumed"], 7), _count(row["requests"]),
                      _count(row["weighted_cost"]), _percent(row["restart_ratio"]),
                      _percent(row["subagent_cost_share"]),
                      _percent(row["waste_share"]) + ("*" if len(row["config_hashes"]) > 1 else ""),
                      str(row["sessions_without_waste"]), _count(row["context_max"]),
                      ",".join(row["models"]) or "-", ", ".join(row["waste_top"]) or "-"))
    widths = [max(len(line[column]) for line in lines) for column in range(len(header) - 1)]
    for line in lines:
        print("  ".join(cell.ljust(width) for cell, width in zip(line, widths)) + "  " + line[-1])
    if any(len(row["config_hashes"]) > 1 for row in rows):
        print("* waste の設定（config_hash）が違う記録が混ざっている。比べるときは注意する", file=sys.stderr)
    return 0


def rescan_targets(projects: Path, since: str) -> list[Path]:
    """--since の日（UTC）以降に更新された本体の transcript（<projects>/<dir>/*.jsonl）。"""
    start = dt.datetime.fromisoformat(since).replace(tzinfo=dt.timezone.utc).timestamp()
    return sorted(path for path in projects.glob("*/*.jsonl") if path.is_file() and path.stat().st_mtime >= start)


def command_rescan(args: argparse.Namespace) -> int:
    """transcript を集計し直して sessions.jsonl に追記する。hc.*・ctx_budget などは既存の記録から引き継ぐ。"""
    projects = Path(args.projects) if args.projects else projects_dir()
    if not projects.is_dir():
        print(f"claude-token-metrics rescan: ディレクトリがありません: {projects}", file=sys.stderr)
        return 1
    existing = {record["session_id"]: record for record in load_records(sessions_path())}
    weights, source = load_weights()
    options = record_waste_options()
    options.pop("budget")
    written, failed = [], 0
    for path in rescan_targets(projects, args.since):
        try:
            previous = existing.get(path.stem) or {}
            budget = previous.get("ctx_budget") if _is_int(previous.get("ctx_budget")) else None
            metrics, parsed = _session_metrics(path, weights, source, {**options, "budget": budget})
            previous = existing.get(metrics["session_id"]) or previous
            cwd = parsed.most_common(parsed.cwds) or previous.get("cwd")
            git = git_info(cwd, parsed.most_common(parsed.branches), use_git_branch=False)
            if git["repo"] is None:
                git["repo"] = (previous.get("git") or {}).get("repo")
            metrics.update({"recorded_at": now_text(), "reason": previous.get("reason"),
                            "cwd": previous.get("cwd") or cwd, "git": git,
                            "hc": previous.get("hc") or {"terminal": None, "role": None},
                            "ctx_budget": budget, "rescanned": True})
            written.append(metrics)
        except Exception as error:  # noqa: BLE001 - 1 件の失敗で他の再集計を止めない
            failed += 1
            print(f"claude-token-metrics rescan: {path}: {error}", file=sys.stderr)
    append_records(written)
    print(f"rescan: {len(written)} 件を追記しました（失敗 {failed} 件）")
    return 1 if failed else 0


# ---- 重みの推定（calibrate） --------------------------------------------------
#
# claude-statusline は rate_limits.five_hour.used_percentage が変わるたびに ratelimit.jsonl へ記録する。
# 同じ resets_at を持つ連続した 2 つの記録の間を 1 区間とし、その区間に全プロジェクト
# （サブエージェント込み）で発生したトークンを種類別に合計する。Δused_percentage を目的変数、
# 種類別トークンを説明変数として切片なしの非負最小二乗で係数を求め、input を 1 とした相対値にする。

CALIBRATE_SCHEMA = "claude-token-metrics/calibrate/v1"
FEATURES = ("input", "cache_creation_5m", "cache_creation_1h", "cache_read", "output")
MIN_INTERVALS = 30
RESET_TOLERANCE = 60  # resets_at がこの秒数以内の差なら同じ 5 時間枠とみなす
FAMILIES = ("opus", "sonnet", "haiku")
CALIBRATE_NOTE = ("同じ枠を claude.ai web や他の端末で使った分はローカルのログに出ないため、"
                  "推定のノイズになる。used_percentage の刻みが粗いほど 1 区間の誤差は大きい。")


def ratelimit_path() -> Path:
    return data_dir() / "ratelimit.jsonl"


def projects_dir() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    return Path(base) / "projects"


def epoch(value: object) -> float | None:
    """ISO 8601 の文字列か Unix 時刻（秒またはミリ秒）を Unix 秒にする。読めなければ None。"""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        number = float(value)
        if not math.isfinite(number):
            return None
        return number / 1000 if number > 1e12 else number
    if not isinstance(value, str) or not value:
        return None
    try:
        return epoch(float(value))
    except ValueError:
        pass
    try:
        moment = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=dt.timezone.utc)
    return moment.timestamp()


def load_ratelimit_records(path: Path, since: str | None = None) -> list[dict]:
    """ratelimit.jsonl を読み、5 時間枠の使用率を持つ記録を時刻順に {ts, pct, reset} で返す。"""
    records = []
    if not path.is_file():
        return records
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            line = json.loads(raw)
        except json.JSONDecodeError:
            continue
        window = line.get("five_hour") if isinstance(line, dict) else None
        moment = epoch(line.get("ts")) if isinstance(line, dict) else None
        if moment is None or not isinstance(window, dict):
            continue
        percent = window.get("used_percentage")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)) or not math.isfinite(percent):
            continue
        if since and dt.datetime.fromtimestamp(moment, dt.timezone.utc).date().isoformat() < since:
            continue
        records.append({"ts": moment, "pct": percent, "reset": epoch(window.get("resets_at"))})
    records.sort(key=lambda record: record["ts"])
    return records


def build_intervals(records: list[dict], min_delta: float = 0) -> tuple[list[dict], dict]:
    """同じ枠の連続した 2 記録を 1 区間にする。枠の切り替わりと使用率の減少は除く。

    min_delta > 0 なら、同じ枠の中で Δ がその値以上になるまで連続した区間をつなげる
    （used_percentage の刻みが粗いとき、1 区間あたりの丸め誤差を小さくするため）。"""
    intervals, skipped = [], {"window_change": 0, "negative_delta": 0}
    start = records[0] if records else None
    for before, after in zip(records, records[1:]):
        if before["reset"] is None or after["reset"] is None \
                or abs(before["reset"] - after["reset"]) > RESET_TOLERANCE:
            skipped["window_change"] += 1
            start = after
            continue
        if after["pct"] < before["pct"]:
            skipped["negative_delta"] += 1
            start = after
            continue
        delta = after["pct"] - start["pct"]
        if delta < min_delta:
            continue
        intervals.append({"start": start["ts"], "end": after["ts"], "delta": delta, "tokens": {}})
        start = after
    return intervals, skipped


def model_family(model: str) -> str:
    name = model.lower()
    return next((family for family in FAMILIES if family in name), "other")


def attribute_tokens(intervals: list[dict], projects: Path) -> dict:
    """全トランスクリプトのリクエストを、時刻で区間に振り分けてモデル系統・種類別に足す。"""
    counts = {"files": 0, "requests": 0, "duplicate_requests": 0}
    if not intervals or not projects.is_dir():
        return counts
    first, last = intervals[0]["start"], intervals[-1]["end"]
    ends = [interval["end"] for interval in intervals]
    seen: set[str] = set()
    for file in sorted(projects.rglob("*.jsonl")):
        try:
            if file.stat().st_mtime < first:
                continue  # 最初の記録より前に書き終わったファイルには、区間内のリクエストがない
            stream = Transcript().read(file, split_sidechain=False)[0]
        except OSError:
            continue
        counts["files"] += 1
        for request in stream.requests:
            moment = epoch(request.get("timestamp"))
            if moment is None or not first < moment <= last:
                continue
            key = request.get("request_id")
            if key in seen:
                counts["duplicate_requests"] += 1  # 再開したセッションなどで別ファイルに同じリクエストがある
                continue
            if key:
                seen.add(key)
            interval = intervals[bisect.bisect_left(ends, moment)]
            if moment <= interval["start"]:
                continue  # 区間に入らない（枠の切り替わりなどで除いた区間の中）
            bucket = interval["tokens"].setdefault(model_family(request["model"]), dict.fromkeys(FEATURES, 0))
            for feature in FEATURES:
                bucket[feature] += request[feature]
            counts["requests"] += 1
    return counts


def _solve(matrix: list[list[float]], vector: list[float]) -> list[float] | None:
    """ガウスの消去法（部分ピボット）。特異なら None。"""
    size = len(vector)
    rows = [list(row) + [value] for row, value in zip(matrix, vector)]
    for column in range(size):
        pivot = max(range(column, size), key=lambda index: abs(rows[index][column]))
        if abs(rows[pivot][column]) < 1e-10:
            return None
        rows[column], rows[pivot] = rows[pivot], rows[column]
        for index in range(column + 1, size):
            factor = rows[index][column] / rows[column][column]
            rows[index] = [a - factor * b for a, b in zip(rows[index], rows[column])]
    solution = [0.0] * size
    for index in reversed(range(size)):
        known = sum(rows[index][j] * solution[j] for j in range(index + 1, size))
        solution[index] = (rows[index][size] - known) / rows[index][index]
    return solution


def nnls(columns: list[list[float]], target: list[float]) -> list[float]:
    """非負最小二乗。説明変数が高々 5 個なので、すべての台（部分集合）で最小二乗を解き、
    係数が非負の解のうち残差が最小のものを選ぶ（NNLS の最適解は、その台での最小二乗解なので厳密）。"""
    size = len(columns)
    norms = [math.sqrt(sum(value * value for value in column)) for column in columns]
    scaled = [[value / norm for value in column] if norm else column for column, norm in zip(columns, norms)]
    gram = [[sum(a * b for a, b in zip(left, right)) for right in scaled] for left in scaled]
    moment = [sum(a * b for a, b in zip(column, target)) for column in scaled]
    total = sum(value * value for value in target)
    best, best_residual = [0.0] * size, total
    for mask in range(1, 1 << size):
        support = [index for index in range(size) if mask >> index & 1]
        if not all(norms[index] for index in support):
            continue
        solution = _solve([[gram[i][j] for j in support] for i in support], [moment[i] for i in support])
        if solution is None or min(solution) < 0:
            continue
        residual = total - sum(value * moment[index] for value, index in zip(solution, support))
        if residual < best_residual - 1e-12 * max(total, 1.0):
            best_residual, best = residual, [0.0] * size
            for value, index in zip(solution, support):
                best[index] = value
    return [value / norm if norm else 0.0 for value, norm in zip(best, norms)]


def _significant(value: float) -> float:
    return float(f"{value:.4g}")


def fit_weights(rows: list[tuple[dict, float]], min_intervals: int) -> dict:
    """区間ごとの (種類別トークン, Δ使用率) から重みを推定する。区間数が足りなければ推定しない。"""
    result = {"status": "insufficient_data", "intervals": len(rows), "weights": None,
              "percent_per_mtok": None, "r2": None}
    if not rows or len(rows) < min_intervals:
        return result
    used = [feature for feature in FEATURES if any(tokens[feature] for tokens, _ in rows)]
    target = [delta for _, delta in rows]
    coefficients = dict(zip(used, nnls([[tokens[feature] for tokens, _ in rows] for feature in used], target)))
    predicted = [sum(value * tokens[feature] for feature, value in coefficients.items()) for tokens, _ in rows]
    mean = sum(target) / len(target)
    spread = sum((value - mean) ** 2 for value in target)
    residual = sum((value - guess) ** 2 for value, guess in zip(target, predicted))
    base = coefficients.get("input", 0)
    result.update(
        status="ok",
        weights={feature: _significant(coefficients[feature] / base) if feature in coefficients else None
                 for feature in FEATURES} if base > 0 else None,
        percent_per_mtok={feature: coefficients[feature] * 1e6 if feature in coefficients else None
                          for feature in FEATURES},
        r2=1 - residual / spread if spread else None,  # 切片なしだが、平均まわりの決定係数（保守的な値）
    )
    return result


def calibrate(ratelimit: Path, projects: Path, since: str | None, min_intervals: int,
              min_delta: float = 0) -> dict:
    records = load_ratelimit_records(ratelimit, since)
    intervals, skipped = build_intervals(records, min_delta)
    counts = attribute_tokens(intervals, projects)
    skipped.update(no_tokens=0, duplicate_requests=counts["duplicate_requests"])
    rows, families = [], {}
    for interval in intervals:
        buckets = {family: tokens for family, tokens in interval["tokens"].items() if any(tokens.values())}
        if not buckets:
            skipped["no_tokens"] += 1  # ローカルで使っていない区間（他の端末の分）は情報を持たない
            continue
        rows.append(({feature: sum(tokens[feature] for tokens in buckets.values()) for feature in FEATURES},
                     interval["delta"]))
        # モデル系統別の推定には、その系統だけを使った区間を使う。
        for family in buckets:
            families.setdefault(family, [])
        if len(buckets) == 1:
            (family, tokens), = buckets.items()
            families[family].append((tokens, interval["delta"]))
    return {
        "schema": CALIBRATE_SCHEMA,
        **fit_weights(rows, min_intervals),
        "min_intervals": min_intervals,
        "min_delta": min_delta,
        "records": len(records),
        "since": since,
        "files": counts["files"],
        "requests": counts["requests"],
        "skipped": skipped,
        "by_model": {family: fit_weights(subset, min_intervals) for family, subset in sorted(families.items())},
        "note": CALIBRATE_NOTE,
    }


def _weights_text(weights: dict) -> str:
    return ", ".join(f"{key} {value:.4g}" for key, value in weights.items() if value is not None)


def _fit_text(fit: dict, min_intervals: int) -> str:
    if fit["status"] != "ok":
        return f"データ不足: 区間 {fit['intervals']}（{min_intervals} 以上必要）。推定しません"
    if not fit["weights"]:
        return f"区間 {fit['intervals']}: input の係数が 0 のため、input = 1 の相対値を出せません"
    r2 = "-" if fit["r2"] is None else f"{fit['r2']:.3f}"
    return f"重み（input = 1）: {_weights_text(fit['weights'])}、決定係数 {r2}"


def print_calibration(result: dict) -> None:
    skipped = result["skipped"]
    print(f"記録 {result['records']}、区間 {result['intervals']}（枠の切り替わり {skipped['window_change']}、"
          f"使用率の減少 {skipped['negative_delta']}、ローカルのトークンなし {skipped['no_tokens']} を除外）、"
          f"リクエスト {result['requests']}、ファイル {result['files']}")
    print(_fit_text(result, result["min_intervals"]))
    if result["status"] == "ok":
        print(f"使用率（% / 100 万トークン）: {_weights_text(result['percent_per_mtok'])}")
    for family, fit in result["by_model"].items():
        print(f"  {family}: {_fit_text(fit, result['min_intervals'])}")
    print(f"注意: {result['note']}")


def write_calibration(result: dict, path: Path) -> None:
    """推定した重みを設定ファイルに書く。"weights" 以外のキーは残し、推定の根拠を "calibration" に入れる。"""
    if result["status"] != "ok" or not result["weights"]:
        raise ValueError(f"データ不足（区間 {result['intervals']}）または input の係数が 0 のため、書き出しません")
    data: dict = {}
    if path.is_file():
        try:
            loaded = json.loads(path.read_text())
        except json.JSONDecodeError:
            raise ValueError(f"{path} が JSON として読めないため、上書きしません") from None
        data = loaded if isinstance(loaded, dict) else {}
    data["weights"] = {key: value for key, value in result["weights"].items() if value is not None}
    data["calibration"] = {
        "source": "claude-token-metrics calibrate",
        "estimated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "since": result["since"], "min_delta": result["min_delta"],
        "intervals": result["intervals"], "r2": result["r2"],
        "percent_per_mtok": result["percent_per_mtok"], "note": result["note"],
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    os.replace(temporary, path)


def command_calibrate(args: argparse.Namespace) -> int:
    ratelimit = Path(args.ratelimit) if args.ratelimit else ratelimit_path()
    projects = Path(args.projects) if args.projects else projects_dir()
    result = calibrate(ratelimit, projects, args.since, args.min_intervals, args.min_delta)
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print_calibration(result)
    if args.write:
        try:
            write_calibration(result, config_path())
        except (ValueError, OSError) as error:
            print(f"claude-token-metrics: {error}", file=sys.stderr)
            return 1
        print(f"{config_path()} に重みを書き出しました", file=sys.stderr)
    return 0


def positive_int(value: str) -> int:
    try:
        number = int(value)
    except ValueError:
        number = 0
    if number < 1:
        raise argparse.ArgumentTypeError(f"1 以上の整数で指定してください: {value}")
    return number


def non_negative_float(value: str) -> float:
    try:
        number = float(value)
    except ValueError:
        number = -1.0
    if not math.isfinite(number) or number < 0:
        raise argparse.ArgumentTypeError(f"0 以上の数値で指定してください: {value}")
    return number


def since_date(value: str) -> str:
    try:
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
            raise ValueError
        dt.date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"YYYY-MM-DD で指定してください: {value}") from None
    return value


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="claude-token-metrics", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    session = commands.add_parser("session", help="1 セッションの指標を 1 行の JSON で出す")
    session.add_argument("--weights", help="重みの上書き（例: input=1,output=5）")
    session.add_argument("--waste-config", help="無駄検出の設定ファイル（waste.json と同じ形）")
    session.add_argument("transcript")
    waste = commands.add_parser("waste", help="1 セッションの無駄（waste）をルール別の表で出す")
    waste.add_argument("--weights", help="重みの上書き（例: input=1,output=5）")
    waste.add_argument("--waste-config", help="無駄検出の設定ファイル（waste.json と同じ形）")
    waste.add_argument("--json", action="store_true", help="waste を JSON で出す")
    waste.add_argument("transcript")
    record = commands.add_parser("record", help="SessionEnd hook 用。stdin の transcript_path を集計して追記する")
    record.add_argument("--foreground", action="store_true", help="切り離さずにその場で集計する")
    report = commands.add_parser("report", help="記録したセッションの一覧を出す")
    report.add_argument("--since", type=since_date, help="この日（UTC）以降に始まったセッションだけ出す")
    report.add_argument("--json", action="store_true", help="表ではなく JSON の配列で出す")
    report.add_argument("--by", choices=("session", "task"), default="session",
                        help="session: セッションごと（既定）、task: タスク（Issue）ごとにまとめる")
    rescan = commands.add_parser("rescan", help="--since 以降に更新された transcript を集計し直して追記する")
    rescan.add_argument("--since", type=since_date, required=True, help="この日（UTC）以降に更新された transcript")
    rescan.add_argument("--projects", help="トランスクリプトの場所（既定: ~/.claude/projects）")
    calibrate_parser = commands.add_parser(
        "calibrate", help="statusline が記録した使用率の変化から、トークン種類ごとの重みを推定する")
    calibrate_parser.add_argument("--since", type=since_date, help="この日（UTC）以降の記録だけ使う")
    calibrate_parser.add_argument("--min-intervals", type=positive_int, default=MIN_INTERVALS,
                                  help=f"推定に必要な区間数（既定 {MIN_INTERVALS}）")
    calibrate_parser.add_argument("--min-delta", type=non_negative_float, default=0,
                                  help="同じ枠の中で Δ使用率がこの値以上になるまで区間をつなげる"
                                       "（刻みが粗いときの丸め誤差対策。既定 0 = 連続した 2 記録ごと）")
    calibrate_parser.add_argument("--json", action="store_true", help="結果を JSON で出す")
    calibrate_parser.add_argument("--write", action="store_true",
                                  help="推定した重みで設定ファイル（weights.json）の weights を置き換える（既定では書かない）")
    calibrate_parser.add_argument("--ratelimit", help="使用率の記録（既定: <データ>/ratelimit.jsonl）")
    calibrate_parser.add_argument("--projects", help="トランスクリプトの場所（既定: ~/.claude/projects）")
    args = parser.parse_args(argv)
    if args.command == "session":
        return command_session(args, session)
    if args.command == "waste":
        return command_waste(args, waste)
    if args.command == "record":
        return command_record(args)
    if args.command == "calibrate":
        return command_calibrate(args)
    if args.command == "rescan":
        return command_rescan(args)
    return command_report(args, report)


if __name__ == "__main__":
    raise SystemExit(main())
