#!/usr/bin/env bash
# herdr-core 上に監督役の Claude Code を常駐させる。dev ディストリでだけ動く（hc-claude と同じ判定）。
# Herdr app・スマホ・端末のどこからでも同じ 1 行で使う。全体像は docs/herdr-core-orchestration.md
set -euo pipefail

# HC_SUPERVISOR_NAME は検証用（本物の監督役に触れずに別の名前で試す）。普段は supervisor。
name="${HC_SUPERVISOR_NAME:-supervisor}"
start_request='監督を開始してください。'
role_file="${HC_CLAUDE_ROLE_FILE:-/etc/dotfiles-role}"

usage() {
  cat <<'EOF'
Usage: hc-supervisor [start] [--cwd DIR]
       hc-supervisor restart [--cwd DIR]
       hc-supervisor status | stop | board
       hc-supervisor resume-worker --from WORKER --cwd WORKTREE --handoff PATH [--name NAME] REQUEST

start    監督役（名前 supervisor、ラベル role=supervisor）を起動する。既に監督役がいれば起動しない。
         --cwd の既定は ~/.local/share/hc-supervisor（$HOME はフォルダ信頼が保存されず、
         起動のたびに trust ダイアログが出るため）。
restart  監督役を作り直す（プロンプトや設定の変更を反映する）。動いている監督役に引き継ぎ
         （~/.local/share/hc-supervisor/handoff.md）を書かせてから、同じ terminal（同じ tN）の中で
         Claude Code だけを起動し直す。監督役が起動したワーカーは、そのまま新しい監督役の子になる。
         入れ替えられないとき（この仕組みより前に起動した監督役など）は、terminal を消して同じ名前・
         同じタブで作り直す（その場合、それまでのワーカーとの親子関係は切れる）。
         新しい監督役は引き継ぎを読んで続ける。ワーカーは止まらない（--outlive-parent）。
         引き継ぎが書かれなければ、何も止めずに終わる。監督役が自分で実行するときは、
         先に引き継ぎを書いておく（別の terminal に切り離して作り直す）。
status   監督役の状態を表示する。
stop     監督役を止める。監督役が起動したワーカーは止まらない（--outlive-parent）。
board    監督役の進捗ボード（~/.local/share/hc-supervisor/board.md）を表示する。どのセッションからでも使える。
resume-worker
         「【引き継ぎ】<handoff>」を送ったワーカー（--from、名前か tN）を片付け、同じ worktree（--cwd）で
         新しいワーカーを起動する。依頼文は「【再開】<handoff>」の行の後に REQUEST（前のワーカーへの依頼と同じ）を
         付けたもの。handoff は --cwd の `git rev-parse --git-path codex-handoffs` の下にある既存ファイルの
         絶対 path に限る。前のワーカーが role=worker でない、まだ動いている（working）、見つからないときは、
         何も止めず起動もしない。引き継ぎ回数をラベル handoffs に残し、上限
         （HC_SUPERVISOR_MAX_WORKER_HANDOFFS、既定 3）を超えるなら起動しない（ユーザーに報告する）。
         新しいワーカーの名前は --name、無ければ前のワーカーと同じ名前。監督役が実行する。
EOF
}

die() {
  printf 'hc-supervisor: %s\n' "$*" >&2
  exit 1
}

# hc get --json の値を 1 つ出す。field <JSON> <キー> は最上位の項目、label <JSON> <キー> はラベル、
# status <JSON> <キー> はエージェントの状態（status.state など。エージェントでなければ無い）。
# 無ければ空文字。hc get は {"terminal": {...}} で包んで返すこともある。
json_value() {
  python3 -c '
import json, sys
kind, text, key = sys.argv[1:4]
try:
    data = json.loads(text)
except json.JSONDecodeError:
    sys.exit(0)
if isinstance(data, dict) and isinstance(data.get("terminal"), dict):
    data = data["terminal"]
if not isinstance(data, dict):
    sys.exit(0)
if kind in ("label", "status"):
    data = data.get("labels" if kind == "label" else "status")
    if not isinstance(data, dict):
        sys.exit(0)
value = data.get(key)
print(value if isinstance(value, str) else "")
' "$1" "$2" "$3"
}

# 生きている terminal があるか。hc get は終了済みも返しうるので、最上位の state が
# finished なら無いものとみなす（status.state とは別の、live / finished の値）。
exists() {
  local json
  json="$(hc get "$1" --json 2>/dev/null)" || return 1
  [[ "$(json_value field "$json" state)" != finished ]]
}

# Herdr app は terminal のラベル herdr.space / herdr.tab でスペースとタブに配置する（実機 2026-11-14、
# 文書化されていない）。Herdr app のタブから起動したときは、そのスペースの新しいタブに監督役を出す。
caller_space() {
  [[ -n "${HC_TERMINAL_ID:-}" ]] || return 0
  local self
  self="$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null)" || return 0
  json_value label "$self" herdr.space
}

# 監督役を起動する。<スペース> があれば Herdr app のそのスペースのタブ（<タブ>、空なら新しいタブ）に出す。
launch() {
  local space="$1" tab="$2"
  # 初回は trust ダイアログで最初の依頼文が届かず、hc run が届くまで待ち続ける（実機 2026-11-14）。
  # --timeout で待ちを切り上げる（terminal は動いたまま）。役割はシステムプロンプトで渡すので、
  # 依頼文が届かなくても監督役は待機状態になる。
  if [[ -n "${HC_CLAUDE_BIN:-}" ]]; then
    # 検証用: hc run は呼び出し元の環境変数を terminal に渡さないので、偽の claude を env で渡す。
    # hc-claude はこの hc-supervisor の隣のもの（worktree で試すときに、本番のリンク先を使わない）。
    hc run --bg --timeout 20 --no-parent --keep --name "$name" --label role=supervisor --cwd "$cwd" \
      -- env "${passthrough_env[@]}" "$(dirname "$self_path")/hc-claude" supervisor "$start_request" >/dev/null || true
  else
    hc run --bg --timeout 20 --no-parent --keep --name "$name" --label role=supervisor --cwd "$cwd" \
      claude-supervisor "$start_request" || true
  fi
  exists "$name" || die "監督役を起動できませんでした（hc ls で確認してください）"
  printf '起動しました: %s\n' "$name"
  [[ -n "$space" ]] || return 0
  [[ -n "$tab" ]] || tab="tb$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
  hc label "$name" "herdr.space=$space" "herdr.tab=$tab" "where=supervisor" >/dev/null \
    && printf 'Herdr app のこのスペースにタブとして表示します: %s\n' "$name"
}

restart_request='【再起動の準備】hc-supervisor restart からの依頼です。監督役を作り直すので、システムプロンプトの「作り直し」の手順 1 のとおり、進行中のワーカーと未回答の質問を ~/.local/share/hc-supervisor/handoff.md に書いてください。書き終えたら、hc-supervisor restart は実行せずにターンを終えてください。'

# 監督役の terminal <tN> の中で、Claude Code だけを止めて起動し直す（terminal・tN・ラベルはそのまま）。
# hc-claude が <tN>.pid に書いた自分の pid の子（claude）を止める。hc-claude は <tN>.restart の依頼文で
# claude を起動し直す。入れ替えの仕組みがない（古い hc-claude で起動した、シェルになっている）ときは、
# 何もせずに 1 を返す。
swap_in_place() {
  local address="$1" pid_file restart_file shell_pid old_pid new_pid i
  pid_file="$claude_state_dir/$address.pid"
  restart_file="$claude_state_dir/$address.restart"
  shell_pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ "$shell_pid" =~ ^[0-9]+$ ]] || return 1
  tr '\0' ' ' <"/proc/$shell_pid/cmdline" 2>/dev/null | grep -q 'hc-claude supervisor' || return 1
  old_pid="$(pgrep -P "$shell_pid" | head -n 1 || true)"
  [[ -n "$old_pid" ]] || return 1

  printf '%s' "$start_request" >"$restart_file"
  kill -TERM "$old_pid" 2>/dev/null || true
  for ((i = 0; i < 30; i++)); do
    [[ -d "/proc/$old_pid" ]] || break
    sleep 0.5
  done
  [[ ! -d "/proc/$old_pid" ]] || kill -KILL "$old_pid" 2>/dev/null || true
  for ((i = 0; i < 30; i++)); do
    new_pid="$(pgrep -P "$shell_pid" | head -n 1 || true)"
    [[ -z "$new_pid" || "$new_pid" == "$old_pid" ]] || break
    new_pid=""
    sleep 0.5
  done
  if [[ -z "$new_pid" ]]; then
    rm -f "$restart_file"
    die "古い Claude Code は止めましたが、新しい Claude Code が起動しませんでした。hc read $name で確かめ、必要なら hc-supervisor stop → hc-supervisor で起動し直してください。引き継ぎは $handoff にあります。"
  fi
  printf '同じ terminal（%s）のまま、監督役の Claude Code を起動し直しました。ワーカーとの親子関係はそのままです。\n' "$address"
}

restart() {
  if ! exists "$name"; then
    launch "$(caller_space)" ""
    return
  fi
  local json address space tab
  json="$(hc get "$name" --json)"
  address="$(json_value field "$json" address)"
  space="$(json_value label "$json" herdr.space)"
  tab="$(json_value label "$json" herdr.tab)"

  # 監督役が自分で実行した: ここで自分を止めると起動し直す処理も止まるので、
  # 親のない別の terminal に切り離して作り直す。引き継ぎは監督役が先に書いておく。
  if [[ -n "${HC_TERMINAL_ID:-}" && ( "$HC_TERMINAL_ID" == "$address" || "$HC_TERMINAL_ID" == "$name" ) ]]; then
    [[ -f "$handoff" ]] || die "先に引き継ぎを $handoff に書いてください"
    mkdir -p "$state_dir"
    hc run --bg --no-parent --rm --no-notify --name "$name-restart" -- \
      env "${passthrough_env[@]}" bash -c '"$0" restart --handoff-ready --cwd "$1" >>"$2" 2>&1' "$self_path" "$cwd" "$restart_log" >/dev/null
    printf '別の terminal で作り直します。この監督役はまもなく止まります。結果: %s\n' "$restart_log"
    return
  fi

  # herdr-core の再起動後は、監督役の terminal が Claude Code ではなくシェルになる（--keep）。
  # シェルに引き継ぎの依頼を打ち込まないよう、エージェントの状態でなければ止める。
  case "$(json_value status "$json" state)" in
    idle|working|done) ;;
    *) ((handoff_ready)) \
         || die "監督役の terminal で Claude Code が応答できる状態ではありません（herdr-core の再起動後のシェル、ダイアログ待ちなど）。hc read $name で確かめ、必要なら hc-supervisor stop → hc-supervisor で起動し直してください。" ;;
  esac

  if ((handoff_ready)); then
    [[ -f "$handoff" ]] || die "引き継ぎ（$handoff）がありません。監督役は止めていません。"
  else
    local started mtime
    started="$(date +%s)"
    printf '監督役に引き継ぎを書いてもらっています（最大 10 分）…\n'
    hc send --wait --timeout 600 "$name" "$restart_request" >/dev/null \
      || die "監督役に引き継ぎを頼めませんでした。監督役は止めていません。hc read $name で画面を確かめてください。"
    mtime="$(stat -c %Y "$handoff" 2>/dev/null || echo 0)"
    ((mtime >= started)) \
      || die "引き継ぎ（$handoff）が書かれませんでした。監督役は止めていません。hc read $name で画面を確かめてください。"
  fi

  if swap_in_place "$address"; then
    return
  fi

  printf '同じ terminal で Claude Code を入れ替えられないので、terminal を作り直します（この仕組みより前に起動した監督役など）。\n'
  printf '注意: 作り直すと、これまでに監督役が起動したワーカーは新しい監督役の子になりません（hc の parent は %s のまま）。\n' "$address"
  hc kill "$name" >/dev/null
  hc wait "$name" --timeout 30 >/dev/null 2>&1 || true
  hc rm "$name" >/dev/null 2>&1 || true
  ! exists "$name" || die "古い監督役が止まりませんでした（hc ls で確認してください）。引き継ぎは $handoff にあります。"
  printf '古い監督役を止めました。\n'
  launch "$space" "$tab"
}

resume_request() {
  local handoff_path="$1" count="$2" request="$3"
  printf '【再開】%s\n前のワーカーが文脈の区切りで引き継ぎました（引き継ぎ %s 回目）。システムプロンプトの「文脈の区切りと引き継ぎ」に従い、この handoff を読んで next safe action から再開してください。\n\n元の依頼:\n%s' \
    "$handoff_path" "$count" "$request"
}

# 前のワーカー（引き継ぎを送って止まった）を片付け、同じ worktree で handoff 付きの新しいワーカーを起動する。
# 前後のワーカーが同じ worktree で同時に動かないよう、前のワーカーが止まって消えたことを確かめてから起動する。
resume_worker() {
  local from="" worktree="" handoff_path="" new_name="" request=""
  while (($#)); do
    case "$1" in
      --from|--cwd|--handoff|--name)
        (($# >= 2)) || die "$1 に値を指定してください"
        case "$1" in
          --from) from="$2" ;;
          --cwd) worktree="$2" ;;
          --handoff) handoff_path="$2" ;;
          --name) new_name="$2" ;;
        esac
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        usage >&2
        exit 2
        ;;
      *)
        [[ -z "$request" ]] || die '依頼文は 1 つの引数で渡してください'
        request="$1"
        shift
        ;;
    esac
  done
  [[ -n "$from" && -n "$worktree" && -n "$handoff_path" ]] || die '--from・--cwd・--handoff を指定してください'
  [[ -n "${request//[[:space:]]/}" ]] || die '依頼文（前のワーカーに渡したものと同じ）を指定してください'
  local max="${HC_SUPERVISOR_MAX_WORKER_HANDOFFS:-3}"
  [[ "$max" =~ ^[1-9][0-9]*$ ]] || die "HC_SUPERVISOR_MAX_WORKER_HANDOFFS は正の整数にしてください: $max"

  # handoff は Git 管理外の codex-handoffs の下に限る（session-handoff の保存先）。
  [[ -d "$worktree" ]] || die "worktree がありません: $worktree"
  local handoff_dir
  handoff_dir="$(git -C "$worktree" rev-parse --path-format=absolute --git-path codex-handoffs 2>/dev/null)" \
    || die "git の worktree ではありません: $worktree"
  [[ "$handoff_path" == /* ]] || die "handoff は絶対 path で指定してください: $handoff_path"
  [[ -f "$handoff_path" && -s "$handoff_path" ]] || die "handoff がないか空です: $handoff_path"
  local real_handoff real_dir
  real_handoff="$(realpath -e "$handoff_path")"
  real_dir="$(realpath -m "$handoff_dir")"
  [[ "$real_handoff" == "$real_dir"/* ]] \
    || die "handoff が $handoff_dir の下にありません（ワーカーの handoff は git rev-parse --git-path codex-handoffs に置きます）: $handoff_path"

  local json
  json="$(hc get "$from" --json 2>/dev/null)" \
    || die "前のワーカー $from が見つかりません。引き継ぎ回数が分からないので起動しません。ユーザーに報告してください。"
  [[ "$(json_value field "$json" state)" != finished ]] \
    || die "前のワーカー $from は終了済みで、引き継ぎ回数が分かりません。起動しません。ユーザーに報告してください。"
  [[ "$(json_value label "$json" role)" == worker ]] || die "$from は role=worker の terminal ではありません。止めません。"
  [[ "$(json_value status "$json" state)" != working ]] \
    || die "前のワーカー $from はまだ動いています（working）。ターンが終わってから（hc wait $from）実行してください。"
  local previous count
  previous="$(json_value label "$json" handoffs)"
  [[ "$previous" =~ ^[0-9]+$ ]] || previous=0
  count=$((previous + 1))
  ((count <= max)) \
    || die "同じ作業で引き継ぎが $max 回を超えます（今回 $count 回目）。新しいワーカーを起動せず、前のワーカー $from も止めていません。ユーザーに報告してください。"
  [[ -n "$new_name" ]] || new_name="$(json_value field "$json" name)"
  [[ -n "$new_name" ]] || die "前のワーカーの名前が分かりません。--name で新しいワーカーの名前を指定してください。"

  hc kill "$from" >/dev/null
  hc wait "$from" --timeout 30 >/dev/null 2>&1 || true
  hc rm "$from" >/dev/null 2>&1 || true
  ! exists "$from" || die "前のワーカー $from が止まりませんでした。新しいワーカーは起動していません（hc ls で確認してください）。"
  printf '前のワーカーを止めました: %s\n' "$from"

  # 同じリポジトリの worktree なので trust のダイアログは出ない想定。出て最初の依頼文が届かないときに
  # 待ち続けないよう、--timeout で切り上げる（terminal は動いたまま。結果の first_message.sent で分かる）。
  hc run --bg --timeout 60 --outlive-parent --label role=worker --name "$new_name" --cwd "$worktree" \
    claude-worker "$(resume_request "$real_handoff" "$count" "$request")" || true
  exists "$new_name" || die "新しいワーカーを起動できませんでした（hc ls で確認してください）。handoff は $real_handoff にあります。"
  hc label "$new_name" "handoffs=$count" >/dev/null \
    || die "新しいワーカー $new_name は起動しましたが、引き継ぎ回数（$count）をラベルに残せませんでした。進捗ボードに回数を書いてください。"
  printf '新しいワーカーを起動しました: %s（引き継ぎ %s 回目、handoff: %s）\n' "$new_name" "$count" "$real_handoff"
}

command="start"
if (($#)) && [[ "$1" != -* ]]; then
  command="$1"
  shift
fi
state_dir="${XDG_DATA_HOME:-$HOME/.local/share}/hc-supervisor"
default_cwd="$state_dir"
handoff="$state_dir/handoff.md"
board="$state_dir/board.md"
restart_log="$state_dir/restart.log"
# hc-claude が監督役の claude の pid と入れ替えの印を置く場所（hc-claude と同じ既定値）。
claude_state_dir="${HC_CLAUDE_STATE_DIR:-$HOME/.local/state/hc-claude}"
# 別の terminal（hc run）へ引き継ぐ環境変数。hc run は呼び出し元の環境を渡さないので、検証用の差し替えを明示して渡す。
passthrough_env=()
for var in HC_SUPERVISOR_NAME HC_CLAUDE_BIN HC_CLAUDE_STATE_DIR XDG_DATA_HOME; do
  [[ -z "${!var:-}" ]] || passthrough_env+=("$var=${!var}")
done
self_path="$(readlink -f "${BASH_SOURCE[0]}")"
cwd="$default_cwd"
handoff_ready=0
# resume-worker は自分の引数を持つので、ここでは読まずに後で渡す。
resume_args=()
if [[ "$command" == resume-worker ]]; then
  resume_args=("$@")
  set --
fi
while (($#)); do
  case "$1" in
    --cwd)
      (($# >= 2)) || die '--cwd にディレクトリを指定してください'
      cwd="$2"
      shift 2
      ;;
    --handoff-ready)
      # restart の内部用: 引き継ぎは書かれているので、監督役に頼まずに作り直す。
      handoff_ready=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

command -v hc >/dev/null 2>&1 || die 'hc が PATH にありません（herdr-core を導入してください）'

case "$command" in
  status)
    if exists "$name"; then
      hc get "$name"
    else
      printf '%s: 起動していません\n' "$name"
    fi
    exit 0
    ;;
  board)
    if [[ -f "$board" ]]; then
      cat "$board"
    else
      printf '進捗ボードはまだありません（監督役が %s に書きます）
' "$board"
    fi
    exit 0
    ;;
  stop)
    if exists "$name"; then
      hc kill "$name" >/dev/null && printf '止めました: %s\n' "$name"
    fi
    exit 0
    ;;
  start|restart|resume-worker) ;;
  *)
    usage >&2
    exit 2
    ;;
esac

[[ "$(cat "$role_file" 2>/dev/null || true)" == dev ]] \
  || die "dev ディストリでだけ起動します（$role_file が dev ではありません）。admin ではエージェントを動かしません。docs/wsl-dev-distro.md"
command -v hc-claude >/dev/null 2>&1 \
  || die 'hc-claude が PATH にありません（dotfiles で make link を実行してください）'
if [[ "$command" == resume-worker ]]; then
  resume_worker "${resume_args[@]}"
  exit 0
fi

[[ "$cwd" != "$default_cwd" ]] || mkdir -p "$cwd"
[[ -d "$cwd" ]] || die "ディレクトリがありません: $cwd"

if [[ "$command" == restart ]]; then
  restart
elif exists "$name"; then
  printf '監督役は起動済みです: %s\n' "$name"
else
  launch "$(caller_space)" ""
fi

printf '見る: Herdr app / スマホのサイドバーの %s、または hc attach %s（Ctrl+\\ で離れる）\n' "$name" "$name"
