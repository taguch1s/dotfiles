#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12,<3.13"
# dependencies = ["modal==1.6.4"]
# ///
"""重い処理を手元の git worktree から遠隔（Modal・GCP の Spot VM）へ回す。説明は docs/hc-remote.md。

  hc-remote run [--backend auto|modal|gcp|local] [--cpu N] [--memory GB] [--timeout DUR] [--out PATH]... -- CMD...
  hc-remote budget [--json]
  hc-remote ls [--json]
  hc-remote logs <id>
  hc-remote wait <id>
  hc-remote cancel <id>
  hc-remote gc [--dry-run]

- 送るもの: カレントの git worktree の `git ls-files -co --exclude-standard`（追跡ファイルと、
  無視されていない未追跡ファイル）。秘密情報らしいファイルが 1 つでもあれば送らずに止める。
- 遠隔では、展開した `/work` で `bash -lc CMD` を実行し、ログを流し、終了コードを返し、
  `--out` の path を worktree の同じ場所へ持ち帰る。
- 上限（~/.config/hc-remote/config.toml）: 1 ジョブの CPU・メモリ・時間、送る量、同時に動かす数。
  課金のある backend は、起動前に今月の使用額 + このジョブの最大見積額が枠（Modal は無料枠 − 余裕、
  GCP は月の予算）に収まるかを確かめる。auto は modal → gcp の順に試し、どれにも収まらなければ手元で実行する。
- 記録: ~/.local/share/hc-remote/jobs.jsonl（追記だけ）。ls・logs・wait・cancel はここにあるジョブだけを扱う。
- 環境変数: HC_REMOTE_CONFIG（設定の path）、HC_REMOTE_STATE_DIR（記録の置き場所）。

backend は Backend の小さなインターフェース（見積もり・使用額・launch・poll・read_log・fetch_outputs・
cleanup・cancel）にまとめ、BACKENDS と AUTO_ORDER に足せば増やせる。
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import fnmatch
import inspect
import json
import math
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tarfile
import threading
import time
import tomllib
from dataclasses import dataclass
from datetime import datetime, timezone
from decimal import Decimal
from pathlib import Path, PurePosixPath
from typing import Any, Callable, TextIO

SCRIPT = Path(__file__).resolve()

