EXIT_USAGE = 2
EXIT_REFUSED = 3  # 上限・枠・秘密情報で起動しなかった（ユーザー確認が必要）
EXIT_INFRA = 125  # backend の失敗でコマンドの終了コードが無い
GRACE_S = 300  # 展開・持ち帰りの分。backend の時間制限と最大見積もりに足す
STARTUP_S = 30  # 起動の分。実績の見積もりに足す

# basename（小文字）で照合する。
SECRET_NAMES = [
    ".env*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.keystore",
    "*.jks",
    "id_rsa*",
    "id_dsa*",
    "id_ecdsa*",
    "id_ed25519*",
    ".modal.toml",
    "credentials*",
    ".git-credentials",
    ".netrc",
    ".pypirc",
    ".npmrc",
    "auth.json",
    "service-account*.json",
]
# 中身で照合する（.bin/check-dotfiles.sh と同じ形式 + AWS・Anthropic）。大きいファイルは見ない。
SECRET_CONTENT = re.compile(
    rb"(-----BEGIN (RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----"
    rb"|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}"
    rb"|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16})"
)
SECRET_SCAN_MAX_BYTES = 2 * 1024 * 1024


class Refused(Exception):
    """起動しない理由（ユーザー確認が必要）。"""


class Unavailable(Exception):
    """backend が使えない、使用額を取れない、または起動できなかった理由。

    spent_usd: 起動に失敗するまでに課金された見積額（GCP で VM を作ってから失敗したときなど）。記録に残して枠に数える。
    """

    def __init__(self, message: str, spent_usd: float = 0.0) -> None:
        super().__init__(message)
        self.spent_usd = spent_usd


class UsageError(Exception):
    pass


class LaunchFailed(Exception):
    """指定した backend で起動できなかった（backend の失敗）。"""


# ---------------------------------------------------------------- 設定と値


def config_path() -> Path:
    if os.environ.get("HC_REMOTE_CONFIG"):
        return Path(os.environ["HC_REMOTE_CONFIG"])
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "hc-remote" / "config.toml"


def state_dir() -> Path:
    if os.environ.get("HC_REMOTE_STATE_DIR"):
        return Path(os.environ["HC_REMOTE_STATE_DIR"])
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "hc-remote"


def _merge(base: dict[str, Any], over: dict[str, Any], where: str) -> dict[str, Any]:
    merged = dict(base)
    for key, value in over.items():
        if key not in base:
            raise UsageError(f"設定に知らないキーがあります: {where}{key}")
        if isinstance(base[key], dict):
            if not isinstance(value, dict):
                raise UsageError(f"設定の {where}{key} は表にしてください")
            merged[key] = _merge(base[key], value, f"{where}{key}.")
        else:
            merged[key] = value
    return merged


def load_config(path: Path | None = None) -> dict[str, Any]:
    path = path or config_path()
    if not path.exists():
        return json.loads(json.dumps(DEFAULTS))
    with path.open("rb") as f:
        return _merge(DEFAULTS, tomllib.load(f), "")


_DURATION = re.compile(r"(\d+(?:\.\d+)?)([smhd])")
_UNIT = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def parse_duration(text: str | int | float) -> int:
    if isinstance(text, (int, float)):
        return int(text)
    s = text.strip().lower()
    if s.isdigit():
        return int(s)
    pos, total = 0, 0.0
    for m in _DURATION.finditer(s):
        if m.start() != pos:
            break
        total += float(m.group(1)) * _UNIT[m.group(2)]
        pos = m.end()
    if pos != len(s) or not s:
        raise UsageError(f"時間の書き方が分かりません: {text!r}（例: 90s、30m、2h、1h30m）")
    return int(total)


def format_duration(seconds: float) -> str:
    seconds = int(seconds)
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def utcnow() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).isoformat(timespec="seconds")


def month_start(now: datetime) -> datetime:
    return now.astimezone(timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0)


@dataclass
class Spec:
    cmd: str
    outs: list[str]
    cpu: float
    memory_gb: float
    timeout_s: int

    def payload(self) -> dict[str, Any]:
        return {"cmd": self.cmd, "outs": self.outs, "timeout_s": self.timeout_s}


def check_limits(spec: Spec, limits: dict[str, Any]) -> None:
    if spec.cpu <= 0 or spec.memory_gb <= 0 or spec.timeout_s <= 0:
        raise UsageError("--cpu・--memory・--timeout は正の値にしてください")
    reasons = []
    if spec.cpu > float(limits["max_cpu"]):
        reasons.append(f"--cpu {spec.cpu:g} が上限 max_cpu={limits['max_cpu']} を超える")
    if spec.memory_gb > float(limits["max_memory_gb"]):
        reasons.append(f"--memory {spec.memory_gb:g} GB が上限 max_memory_gb={limits['max_memory_gb']} を超える")
    max_timeout = parse_duration(limits["max_timeout"])
    if spec.timeout_s > max_timeout:
        reasons.append(
            f"--timeout {format_duration(spec.timeout_s)} が上限 max_timeout={limits['max_timeout']} を超える"
        )
    if reasons:
        raise Refused("; ".join(reasons))


def check_outs(outs: list[str]) -> list[str]:
    cleaned = []
    for out in outs:
        p = PurePosixPath(out)
        if not out or p.is_absolute() or ".." in p.parts or str(p) in (".", ""):
            raise UsageError(f"--out は worktree の中の相対 path にしてください: {out!r}")
        cleaned.append(str(p))
    return cleaned


# ---------------------------------------------------------------- 送るファイル


def git_root(cwd: Path) -> Path:
    proc = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if proc.returncode != 0:
        raise UsageError(f"git の worktree の中で実行してください: {cwd}")
    return Path(proc.stdout.strip())


def list_files(root: Path) -> tuple[list[str], list[str]]:
    """送るファイル（root からの相対 path）と、送らない submodule などのディレクトリ。"""
    proc = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
        capture_output=True,
        check=True,
    )
    files, skipped = [], []
    for raw in sorted(set(proc.stdout.split(b"\0"))):
        if not raw:
            continue
        rel = os.fsdecode(raw)
        path = root / rel
        if path.is_symlink() or path.is_file():
            files.append(rel)
        elif path.is_dir():
            skipped.append(rel)
        # 消した追跡ファイルは送らない
    return files, skipped


def find_secrets(root: Path, files: list[str]) -> list[str]:
    found = []
    for rel in files:
        name = PurePosixPath(rel).name.lower()
        hit = next((pat for pat in SECRET_NAMES if fnmatch.fnmatchcase(name, pat)), None)
        if hit:
            found.append(f"{rel}（名前が {hit}）")
            continue
        path = root / rel
        if path.is_symlink():
            continue
        try:
            if path.stat().st_size > SECRET_SCAN_MAX_BYTES:
                continue
            if SECRET_CONTENT.search(path.read_bytes()):
                found.append(f"{rel}（中身に鍵・トークンの形式）")
        except OSError:
            continue
    return found


def make_bundle(root: Path, files: list[str], dest: Path) -> int:
    dest.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(dest, "w:gz", compresslevel=6) as tar:
        for rel in files:
            tar.add(root / rel, arcname=rel, recursive=False)
    return dest.stat().st_size


# ---------------------------------------------------------------- 遠隔で動く部分


def execute_job(
    bundle: str | Path,
    work: str | Path,
    log_path: str | Path,
    out_tar: str | Path,
    result_path: str | Path,
    spec: dict[str, Any],
    on_tick: Callable[[], None] | None = None,
    tick_s: float = 10.0,
    stop: threading.Event | None = None,
) -> dict[str, Any]:
    """bundle を work に展開して `bash -lc cmd` を動かし、outs を out_tar に詰め、result を書く。

    local backend と Modal の Function の両方がこれを使う（Modal には cloudpickle で値として送るので、
    標準ライブラリだけを使い、この中で import する）。
    """
    import contextlib as _contextlib
    import json as _json
    import os as _os
    import signal as _signal
    import subprocess as _subprocess
    import tarfile as _tarfile
    import time as _time
    from pathlib import Path as _Path

    started = _time.time()
    work = _Path(work)
    work.mkdir(parents=True, exist_ok=True)
    with _tarfile.open(bundle) as tar:
        try:
            tar.extractall(work, filter="tar")
        except TypeError:  # filter の無い Python（3.11.4 より前。GCP の Debian 12 の python3 など）。中身は自分の worktree
            tar.extractall(work)
    timed_out = cancelled = False
    term_at = None
    with open(log_path, "ab") as log:
        proc = _subprocess.Popen(
            ["bash", "-lc", spec["cmd"]],
            cwd=work,
            stdin=_subprocess.DEVNULL,
            stdout=log,
            stderr=_subprocess.STDOUT,
            start_new_session=True,
        )
        deadline = started + spec["timeout_s"]
        last_tick = _time.time()
        while True:
            try:
                code = proc.wait(timeout=0.2)
                break
            except _subprocess.TimeoutExpired:
                pass
            now = _time.time()
            want_stop = (stop is not None and stop.is_set()) or now >= deadline
            if want_stop and term_at is None:
                if now >= deadline:
                    timed_out = True
                else:
                    cancelled = True
                term_at = now
                with _contextlib.suppress(ProcessLookupError):
                    _os.killpg(proc.pid, _signal.SIGTERM)
            elif term_at is not None and now - term_at > 10:
                with _contextlib.suppress(ProcessLookupError):
                    _os.killpg(proc.pid, _signal.SIGKILL)
            if on_tick is not None and now - last_tick >= tick_s:
                on_tick()
                last_tick = now
    if code < 0:
        code = 128 - code
    if timed_out:
        with open(log_path, "ab") as log:
            log.write(f"\nhc-remote: --timeout の {spec['timeout_s']} 秒で止めた\n".encode())
    missing = []
    with _tarfile.open(out_tar, "w") as tar:
        for rel in spec["outs"]:
            p = work / rel
            if p.exists() or p.is_symlink():
                tar.add(p, arcname=rel)
            else:
                missing.append(rel)
    ended = _time.time()
    result = {
        "exit_code": code,
        "timed_out": timed_out,
        "cancelled": cancelled,
        "missing_outs": missing,
        "seconds": round(ended - started, 3),
    }
    tmp = _Path(str(result_path) + ".tmp")
    tmp.write_text(_json.dumps(result))
    _os.replace(tmp, result_path)
    if on_tick is not None:
        on_tick()
    return result


MOUNT = "/vol"


def modal_entry(job_id: str, spec: dict[str, Any], volume_name: str, mount: str = MOUNT, work: str = "/work"):
    """Modal の Function の本体（コンテナの中）。ログと結果は Volume に置き、定期的に commit する。"""
    import modal

    volume = modal.Volume.from_name(volume_name)
    d = f"{mount}/jobs/{job_id}"
    return execute_job(
        f"{d}/bundle.tar", work, f"{d}/log", f"{d}/out.tar", f"{d}/result.json", spec, on_tick=volume.commit
    )


def _local_runner(job_dir: str) -> int:
    """local backend の子プロセス。SIGTERM で止める（cancel）。"""
    d = Path(job_dir)
    spec = json.loads((d / "spec.json").read_text())
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    try:
        execute_job(d / "bundle.tar", d / "work", d / "log", d / "out.tar", d / "result.json", spec, stop=stop)
    finally:
        shutil.rmtree(d / "work", ignore_errors=True)
    return 0


# ---------------------------------------------------------------- backend


@dataclass
class Poll:
    done: bool
    result: dict[str, Any] | None = None
    error: str | None = None


class Backend:
    """backend の共通インターフェース。継いで BACKENDS と（課金のあるものは）AUTO_ORDER に足す。

    - billable: 課金があるか。True なら [pricing.<name>]・[budget.<name>] を使い、起動前に枠を確かめる。
    - detached: run を止めても（Ctrl-C・SIGTERM）遠隔のジョブが動き続けるか。False なら止めたときに cancel する。
    - estimate_max_usd / estimate_usd: [pricing.<name>] の 1 秒あたりの料金から見積もる。
    - budget_limit(): 枠（USD）と、その内訳（記録・表示用）。
    - month_usage(start, end): その期間の実際の使用額（USD）。取れなければ Unavailable。
    - launch(job_id, spec, bundle): bundle（tar.gz）を送って起動し、記録に残す handle（JSON にできる dict）を返す。
      起動できなければ Unavailable（auto なら次の backend を試す）。
    - poll(record) / read_log(record, offset) / fetch_outputs(record, dest) / cleanup(record) / cancel(record)
    """

    name = ""
    billable = False
    detached = True
    poll_interval = 1.0
    budget_word = "無料枠"

    def __init__(self, cfg: dict[str, Any], state: Path, sdk: Any = None) -> None:
        self.cfg = cfg
        self.state = state

    def say(self, msg: str) -> None:  # Ctx.backend が ctx.say に差し替える
        print(f"hc-remote: {msg}", file=sys.stderr, flush=True)

    def rates(self) -> tuple[float, float]:
        p = self.cfg["pricing"][self.name]
        return float(p["cpu_core_second_usd"]), float(p["memory_gib_second_usd"])

    def estimate_usd(self, cpu: float, memory_gb: float, seconds: float) -> float:
        if not self.billable:
            return 0.0
        cpu_rate, mem_rate = self.rates()
        return seconds * (cpu * cpu_rate + memory_gb * mem_rate)

    def estimate_max_usd(self, spec: Spec) -> float:
        return self.estimate_usd(spec.cpu, spec.memory_gb, spec.timeout_s + GRACE_S)

    def billed_seconds(self, record: dict[str, Any], result: dict[str, Any], now: datetime, final: bool) -> float:
        """終わったジョブの課金の秒数の見積もり。final は後始末（cleanup）まで済ませるとき。"""
        if "seconds" in result:
            return float(result["seconds"]) + (STARTUP_S if self.billable else 0)
        return (now - datetime.fromisoformat(record["created_at"])).total_seconds()

    def budget_limit(self) -> tuple[float, dict[str, Any], str]:
        budget = self.cfg["budget"][self.name]
        limit = float(budget["free_credit_usd"]) - float(budget["margin_usd"])
        info = {"free_credit_usd": float(budget["free_credit_usd"]), "margin_usd": float(budget["margin_usd"])}
        return limit, info, f"無料枠 ${info['free_credit_usd']:.2f} − 余裕 ${info['margin_usd']:.2f}"

    def check_available(self) -> None:
        pass

    def month_usage(self, start: datetime, end: datetime) -> float:
        raise Unavailable("課金のない backend")

    def launch(self, job_id: str, spec: Spec, bundle: Path) -> dict[str, Any]:
        raise NotImplementedError

    def poll(self, record: dict[str, Any]) -> Poll:
        raise NotImplementedError

    def read_log(self, record: dict[str, Any], offset: int) -> bytes:
        raise NotImplementedError

    def fetch_outputs(self, record: dict[str, Any], dest: Path) -> bool:
        raise NotImplementedError

    def cleanup(self, record: dict[str, Any]) -> None:
        pass

    def cancel(self, record: dict[str, Any]) -> None:
        raise NotImplementedError


class LocalBackend(Backend):
    """同じ手順を手元の一時ディレクトリ（記録の jobs/<id>/work）で行う。試行とテスト用。"""

    name = "local"
    billable = False
    poll_interval = 0.2
    _children: dict[int, subprocess.Popen] = {}

    def launch(self, job_id: str, spec: Spec, bundle: Path) -> dict[str, Any]:
        d = bundle.parent
        (d / "spec.json").write_text(json.dumps(spec.payload()))
        with (d / "runner.err").open("wb") as err:
            proc = subprocess.Popen(
                [sys.executable, str(SCRIPT), "_exec-local", str(d)],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=err,
                start_new_session=True,
            )
        LocalBackend._children[proc.pid] = proc
        return {"pid": proc.pid, "dir": str(d)}

    def _alive(self, pid: int) -> bool:
        child = LocalBackend._children.get(pid)
        if child is not None:
            return child.poll() is None
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    def poll(self, record: dict[str, Any]) -> Poll:
        d = Path(record["handle"]["dir"])
        result = d / "result.json"
        if result.exists():
            return Poll(True, json.loads(result.read_text()))
        if self._alive(int(record["handle"]["pid"])):
            return Poll(False)
        if result.exists():
            return Poll(True, json.loads(result.read_text()))
        err = (d / "runner.err").read_text(errors="replace")[-400:] if (d / "runner.err").exists() else ""
        return Poll(True, error=f"手元の実行が結果を残さずに終わった {err}".strip())

    def read_log(self, record: dict[str, Any], offset: int) -> bytes:
        path = Path(record["handle"]["dir"]) / "log"
        if not path.exists():
            return b""
        with path.open("rb") as f:
            f.seek(offset)
            return f.read()

    def fetch_outputs(self, record: dict[str, Any], dest: Path) -> bool:
        src = Path(record["handle"]["dir"]) / "out.tar"
        if not src.exists():
            return False
        shutil.copyfile(src, dest)
        return True

    def cleanup(self, record: dict[str, Any]) -> None:
        d = Path(record["handle"]["dir"])
        for name in ("bundle.tar", "out.tar", "spec.json"):
            with contextlib.suppress(FileNotFoundError):
                (d / name).unlink()

    def cancel(self, record: dict[str, Any]) -> None:
        with contextlib.suppress(ProcessLookupError):
            os.kill(int(record["handle"]["pid"]), signal.SIGTERM)


class ModalBackend(Backend):
    """Modal の Function（Sandbox ではない）を serialized=True で spawn し、detach する。

    bundle・ログ・結果・持ち帰るものは Volume（[modal] volume）の jobs/<id>/ に置く。
    cpu と memory は request = limit にする（Modal は request と使用量の大きい方で課金するため、
    limit で使用量を抑えると最大見積もりが上限になる）。
    """

    name = "modal"
    billable = True
    poll_interval = 5.0

    def __init__(self, cfg: dict[str, Any], state: Path, sdk: Any = None) -> None:
        super().__init__(cfg, state)
        self._sdk = sdk
        self.opts = cfg["modal"]

    @property
    def sdk(self) -> Any:
        if self._sdk is None:
            try:
                import modal
            except ImportError as exc:
                raise Unavailable(f"Modal SDK を読み込めない（uv run --script で起動する）: {exc}") from exc
            self._sdk = modal
        return self._sdk

    def check_available(self) -> None:
        _ = self.sdk

    def volume(self) -> Any:
        return self.sdk.Volume.from_name(self.opts["volume"], create_if_missing=True)

    def image(self) -> Any:
        return (
            self.sdk.Image.debian_slim(python_version=str(self.opts["python"]))
            .apt_install("git", "build-essential", "curl", "ca-certificates")
            .pip_install(f"uv=={self.opts['uv']}")
        )

    def month_usage(self, start: datetime, end: datetime) -> float:
        try:
            workspace = self.sdk.Workspace.from_context()
            # resolution="h": 途中の区間は入らないので、日単位だと今日の分がまるごと抜ける
            items = workspace.billing.report(start=start, end=end, resolution="h")
            total = Decimal(0)
            for item in items:
                cost = getattr(item, "cost", None)
                if cost is None:
                    cost = item["cost"]
                total += Decimal(str(cost))
        except Unavailable:
            raise
        except Exception as exc:
            raise Unavailable(f"Modal の billing report を取れない: {type(exc).__name__}: {exc}") from exc
        return float(total)

    def launch(self, job_id: str, spec: Spec, bundle: Path) -> dict[str, Any]:
        sdk = self.sdk
        volume = self.volume()
        with volume.batch_upload(force=True) as batch:
            batch.put_file(str(bundle), f"/jobs/{job_id}/bundle.tar")
        app = sdk.App(self.opts["app"])
        memory_mib = int(round(spec.memory_gb * 1024))
        fn = app.function(
            image=self.image(),
            volumes={MOUNT: volume},
            cpu=(float(spec.cpu), float(spec.cpu)),
            memory=(memory_mib, memory_mib),
            timeout=spec.timeout_s + GRACE_S,
            retries=0,
            serialized=True,
            name=f"job-{job_id}",
        )(modal_entry)
        with sdk.enable_output(), app.run(detach=True):
            call = fn.spawn(job_id, spec.payload(), self.opts["volume"])
        with contextlib.suppress(FileNotFoundError):
            bundle.unlink()
        return {"app": self.opts["app"], "volume": self.opts["volume"], "call_id": str(call.object_id)}

    def _read(self, record: dict[str, Any], name: str) -> bytes | None:
        volume = self.sdk.Volume.from_name(record["handle"]["volume"])
        try:
            return b"".join(volume.read_file(f"jobs/{record['id']}/{name}"))
        except (FileNotFoundError, self.sdk.exception.NotFoundError):
            return None

    def poll(self, record: dict[str, Any]) -> Poll:
        exc_mod = self.sdk.exception
        call = self.sdk.FunctionCall.from_id(record["handle"]["call_id"])
        try:
            value = call.get(timeout=0)
        except exc_mod.OutputExpiredError:
            data = self._read(record, "result.json")
            if data:
                return Poll(True, json.loads(data))
            return Poll(True, error="Modal の結果が期限切れで、Volume にも結果が無い")
        except (TimeoutError, exc_mod.TimeoutError) as exc:
            if isinstance(exc, exc_mod.FunctionTimeoutError):
                return Poll(True, error=f"Modal が時間制限で止めた: {exc}")
            return Poll(False)
        except Exception as exc:  # コンテナが落ちた（メモリ超過など）、取り消した
            return Poll(True, error=f"Modal の呼び出しが失敗した: {type(exc).__name__}: {exc}")
        if isinstance(value, dict):
            return Poll(True, value)
        return Poll(True, error=f"Modal の戻り値が想定外: {value!r}")

    def read_log(self, record: dict[str, Any], offset: int) -> bytes:
        data = self._read(record, "log")
        return (data or b"")[offset:]

    def fetch_outputs(self, record: dict[str, Any], dest: Path) -> bool:
        data = self._read(record, "out.tar")
        if data is None:
            return False
        dest.write_bytes(data)
        return True

    def cleanup(self, record: dict[str, Any]) -> None:
        volume = self.sdk.Volume.from_name(record["handle"]["volume"])
        for name in ("bundle.tar", "out.tar"):
            with contextlib.suppress(Exception):
                volume.remove_file(f"jobs/{record['id']}/{name}")

    def cancel(self, record: dict[str, Any]) -> None:
        self.sdk.FunctionCall.from_id(record["handle"]["call_id"]).cancel(terminate_containers=True)


GCP_USER = "hcremote"
GCP_LABEL = "hc-remote"  # ラベル hc-remote=1 と network tag hc-remote
GCP_PREFIX = "hc-remote-"  # IAM 条件が許す VM・disk の名前の接頭辞
GCP_SSH_WAIT_S = 300  # VM を作ってから SSH が通るまで待つ上限
GCP_CREATE_S = 120  # VM の作成と削除の分。最大見積もりと期限に足す
GCP_MIN_BILL_S = 60  # Compute Engine は 1 分未満でも 1 分を課金する
E2_PREDEFINED = (("highcpu", 1, (2, 4, 8, 16, 32)), ("standard", 4, (2, 4, 8, 16, 32)), ("highmem", 8, (2, 4, 8, 16)))
E2_CUSTOM_PREMIUM = 1.05  # custom は predefined より 5% 高い（公式の価格ページ）

GCP_STARTUP = """#!/bin/bash
# hc-remote: VM の準備（root で 1 回）。終わったら ready、失敗したら failed にログの末尾を書く
mkdir -p /var/lib/hc-remote
if {{
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q &&
    apt-get install -y -q --no-install-recommends python3 git build-essential curl ca-certificates &&
    curl -LsSf https://astral.sh/uv/{uv}/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
}} >/var/lib/hc-remote/setup.log 2>&1; then
  touch /var/lib/hc-remote/ready
else
  tail -n 30 /var/lib/hc-remote/setup.log >/var/lib/hc-remote/failed
fi
"""

GCP_RUN = """#!/bin/bash
# hc-remote: VM の準備を待ってから runner.py（execute_job）を動かす。ssh から setsid で切り離して起動する
ready=${{HC_REMOTE_READY:-/var/lib/hc-remote/ready}}
failed=${{ready%/*}}/failed
echo $$ >pid
for ((i = 0; i < {setup_s}; i++)); do
  [[ -e $ready ]] && exec python3 runner.py
  if [[ -e $failed ]]; then
    {{ echo "hc-remote: VM の準備（apt・uv）に失敗した"; cat "$failed"; }} >>log
    echo failed >setup-error
    exit 1
  fi
  sleep 1
done
echo "hc-remote: VM の準備が {setup_s} 秒で終わらなかった" >>log
echo timeout >setup-error
"""


def gcp_runner_source() -> str:
    """VM で動かす runner.py。execute_job（標準ライブラリだけ）の source をそのまま入れる。"""
    return (
        "from __future__ import annotations\n\nimport json\nimport threading\nfrom pathlib import Path\n"
        "from typing import Any, Callable\n\n\n"
        + inspect.getsource(execute_job)
        + '\n\nif __name__ == "__main__":\n'
        + '    execute_job("bundle.tar", "work", "log", "out.tar", "result.json", json.load(open("spec.json")))\n'
    )


@dataclass
class Machine:
    type: str
    vcpu: int
    memory_gb: float
    hour_usd: float


class GcpBackend(Backend):
    """ジョブごとに GCP の Spot VM（E2）を 1 台作り、IAP 経由の SSH で動かして、終わったら消す。

    約束（docs/hc-remote-gcp.md）: CLOUDSDK_CONFIG=[gcp] cloudsdk_config の service account、名前 hc-remote-<id>、
    ラベル hc-remote=1、network tag hc-remote、--no-service-account --no-scopes、block-project-ssh-keys と作成時の
    ssh-keys（ジョブごとの一時鍵）、Spot・--instance-termination-action=DELETE・--max-run-duration。
    使用額は請求額を取らず（Non-goal）、手元の記録の見積もりで数える。
    """

    name = "gcp"
    billable = True
    detached = False  # run を止めたら VM を消す（手元が落ちても --max-run-duration で消える）
    poll_interval = 10.0
    budget_word = "予算"

    def __init__(self, cfg: dict[str, Any], state: Path, sdk: Any = None) -> None:
        super().__init__(cfg, state)
        self.opts = cfg["gcp"]
        self.prices = cfg["pricing"]["gcp"]

    # ---- 見積もり

    def machine(self, cpu: float, memory_gb: float) -> Machine:
        """--cpu（物理コア、1 コア = 2 vCPU）と --memory から、最も安い E2 のマシンタイプを選ぶ。"""
        vcpu = max(2, math.ceil(cpu * 2))
        vcpu += vcpu % 2
        while memory_gb > 8 * vcpu:  # E2 は 1 vCPU あたり 8 GB まで
            vcpu += 2
        if vcpu > 32 or memory_gb > 128:
            raise Unavailable(f"E2 で作れない大きさ（{vcpu} vCPU・{memory_gb:g} GB。E2 は 32 vCPU・128 GB まで）")

        def hour(v: float, m: float) -> float:
            return v * float(self.prices["vcpu_hour_usd"]) + m * float(self.prices["memory_gib_hour_usd"])

        fixed = float(self.prices["fixed_hour_usd"])
        options = []
        for family, ratio, sizes in E2_PREDEFINED:
            if vcpu in sizes and memory_gb <= ratio * vcpu:
                options.append(Machine(f"e2-{family}-{vcpu}", vcpu, ratio * vcpu, hour(vcpu, ratio * vcpu) + fixed))
                break
        mem = math.ceil(max(memory_gb, 0.5 * vcpu) * 4) / 4  # 1 vCPU あたり 0.5 GB 以上、256 MB 単位
        options.append(
            Machine(f"e2-custom-{vcpu}-{int(mem * 1024)}", vcpu, mem, hour(vcpu, mem) * E2_CUSTOM_PREMIUM + fixed)
        )
        return min(options, key=lambda m: m.hour_usd)

    def estimate_usd(self, cpu: float, memory_gb: float, seconds: float) -> float:
        return self.machine(cpu, memory_gb).hour_usd * max(seconds, GCP_MIN_BILL_S) / 3600

    def max_run_s(self, spec: Spec) -> int:
        return spec.timeout_s + GRACE_S + parse_duration(self.opts["setup_timeout"])

    def estimate_max_usd(self, spec: Spec) -> float:
        # VM は --max-run-duration で消えるので、作成・削除の分を足した長さが上限になる
        return self.estimate_usd(spec.cpu, spec.memory_gb, self.max_run_s(spec) + GCP_CREATE_S)

    def billed_seconds(self, record: dict[str, Any], result: dict[str, Any], now: datetime, final: bool) -> float:
        handle = record.get("handle") or {}
        if not final and handle.get("max_run_s"):
            # VM は持ち帰り（wait）か --max-run-duration まで残るので、最大で数えておく
            return float(handle["max_run_s"]) + GCP_CREATE_S
        start = float(handle.get("created_epoch") or datetime.fromisoformat(record["created_at"]).timestamp())
        seconds = max(GCP_MIN_BILL_S, now.timestamp() - start + GCP_CREATE_S / 2)
        if handle.get("max_run_s"):  # VM は --max-run-duration で消えているので、それより長くは課金されない
            seconds = min(seconds, float(handle["max_run_s"]) + GCP_CREATE_S)
        return seconds

    def budget_limit(self) -> tuple[float, dict[str, Any], str]:
        budget = self.cfg["budget"]["gcp"]
        jpy, rate = float(budget["monthly_budget_jpy"]), float(budget["usd_jpy"])
        info = {"monthly_budget_jpy": jpy, "usd_jpy": rate}
        return jpy / rate, info, f"月の予算 {jpy:.0f} 円 ÷ {rate:g} 円/$"

    def month_usage(self, start: datetime, end: datetime) -> float:
        raise Unavailable("GCP は請求額を取らず、hc-remote の記録上の見積もりで数える")

    # ---- gcloud

    def config_dir(self) -> Path:
        return Path(os.path.expanduser(str(self.opts["cloudsdk_config"])))

    def check_available(self) -> None:
        if shutil.which(str(self.opts["gcloud"])) is None:
            raise Unavailable(f"gcloud が無い（{self.opts['gcloud']}）")
        if shutil.which("ssh-keygen") is None:
            raise Unavailable("ssh-keygen が無い")
        if not self.config_dir().is_dir():
            raise Unavailable(
                f"gcloud の設定 {self.config_dir()} が無い（docs/hc-remote-gcp.md の「dev で使う」で作る）"
            )

    def gcloud(self, *args: str, timeout: float | None = 600, input_bytes: bytes | None = None) -> subprocess.CompletedProcess:
        env = dict(os.environ)
        env["CLOUDSDK_CONFIG"] = str(self.config_dir())
        env["CLOUDSDK_CORE_DISABLE_PROMPTS"] = "1"
        cmd = [str(self.opts["gcloud"]), *args, f"--project={self.opts['project']}"]
        try:
            return subprocess.run(
                cmd, env=env, capture_output=True, timeout=timeout, stdin=subprocess.DEVNULL if input_bytes is None else None,
                input=input_bytes,
            )
        except subprocess.TimeoutExpired as exc:
            return subprocess.CompletedProcess(cmd, 124, exc.stdout or b"", (exc.stderr or b"") + b"\ngcloud timed out")
        except OSError as exc:
            return subprocess.CompletedProcess(cmd, 127, b"", str(exc).encode())

    @staticmethod
    def _err(proc: subprocess.CompletedProcess) -> str:
        text = (proc.stderr or b"").decode(errors="replace").strip().splitlines()
        return " / ".join(text[-3:]) or f"終了コード {proc.returncode}"

    def _ssh_flags(self, handle: dict[str, Any]) -> list[str]:
        return [
            f"--zone={handle['zone']}",
            "--tunnel-through-iap",
            f"--ssh-key-file={handle['key']}",
            "--strict-host-key-checking=no",
            "--quiet",
        ]

    def ssh(self, handle: dict[str, Any], command: str, timeout: float = 120) -> subprocess.CompletedProcess:
        return self.gcloud(
            "compute", "ssh", f"{GCP_USER}@{handle['instance']}", *self._ssh_flags(handle), f"--command={command}",
            timeout=timeout,
        )

    def scp(self, handle: dict[str, Any], *paths: str, timeout: float = 600) -> subprocess.CompletedProcess:
        return self.gcloud("compute", "scp", *self._ssh_flags(handle), *paths, timeout=timeout)

    def remote_dir(self, job_id: str) -> str:
        return f"hc-remote/{job_id}"

    def instance_state(self, handle: dict[str, Any]) -> str | None:
        """VM の status（RUNNING など）。無ければ None。確かめられなければ "UNKNOWN"。"""
        proc = self.gcloud(
            "compute", "instances", "describe", handle["instance"], f"--zone={handle['zone']}", "--format=value(status)",
            timeout=120,
        )
        if proc.returncode == 0:
            return proc.stdout.decode().strip() or "UNKNOWN"
        if b"not found" in proc.stderr.lower() or b"was not found" in proc.stderr.lower():
            return None
        return "UNKNOWN"

    def delete_instance(self, name: str, zone: str) -> None:
        proc = self.gcloud("compute", "instances", "delete", name, f"--zone={zone}", "--quiet", timeout=600)
        if proc.returncode != 0 and b"not found" not in proc.stderr.lower():
            raise Unavailable(f"VM {name} を消せない: {self._err(proc)}")

    # ---- ジョブ

    def launch(self, job_id: str, spec: Spec, bundle: Path) -> dict[str, Any]:
        d = bundle.parent
        machine = self.machine(spec.cpu, spec.memory_gb)
        name = f"{GCP_PREFIX}{job_id}"
        zone = str(self.opts["zone"])
        setup_s = parse_duration(self.opts["setup_timeout"])
        max_run = self.max_run_s(spec)
        key = d / "ssh" / "id"
        key.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", GCP_USER, "-f", str(key)],
            check=True, capture_output=True,
        )
        pub = key.with_suffix(".pub").read_text().strip()
        (d / "startup.sh").write_text(GCP_STARTUP.format(uv=self.opts["uv"]))
        (d / "run.sh").write_text(GCP_RUN.format(setup_s=setup_s))
        (d / "runner.py").write_text(gcp_runner_source())
        (d / "spec.json").write_text(json.dumps(spec.payload()))
        created = time.time()
        deadline = int(created) + max_run + GCP_CREATE_S
        create: subprocess.CompletedProcess | None = None
        handle = {
            "instance": name,
            "zone": zone,
            "project": self.opts["project"],
            "machine_type": machine.type,
            "vcpu": machine.vcpu,
            "memory_gb": machine.memory_gb,
            "key": str(key),
            "created_epoch": round(created, 1),
            "deadline_epoch": deadline,
            "max_run_s": max_run,
        }
        self.say(f"VM {name} を作る（{machine.type}、Spot、{format_duration(max_run)} で自動削除）")
        try:
            create = self.gcloud(
                "compute", "instances", "create", name,
                f"--zone={zone}",
                f"--machine-type={machine.type}",
                f"--image-family={self.opts['image_family']}",
                f"--image-project={self.opts['image_project']}",
                f"--boot-disk-size={int(self.opts['boot_disk_gb'])}GB",
                "--boot-disk-type=pd-balanced",
                "--provisioning-model=SPOT",
                "--instance-termination-action=DELETE",
                f"--max-run-duration={max_run}s",
                "--no-service-account",
                "--no-scopes",
                f"--tags={GCP_LABEL}",
                f"--labels={GCP_LABEL}=1,{GCP_LABEL}-job={job_id},{GCP_LABEL}-deadline={deadline}",
                f"--metadata=block-project-ssh-keys=TRUE,ssh-keys={GCP_USER}:{pub}",
                f"--metadata-from-file=startup-script={d / 'startup.sh'}",
                timeout=600,
            )
            if create.returncode != 0:
                raise Unavailable(f"VM を作れない: {self._err(create)}")
            remote = self.remote_dir(job_id)
            ssh_deadline = time.time() + GCP_SSH_WAIT_S
            while True:
                probe = self.ssh(handle, f"mkdir -p {remote}", timeout=120)
                if probe.returncode == 0:
                    break
                if time.time() > ssh_deadline:
                    raise Unavailable(f"VM に SSH で入れない（{GCP_SSH_WAIT_S} 秒）: {self._err(probe)}")
                time.sleep(5)
            files = [str(d / n) for n in ("bundle.tar", "spec.json", "runner.py", "run.sh")]
            sent = self.scp(handle, *files, f"{GCP_USER}@{name}:{remote}/")
            if sent.returncode != 0:
                raise Unavailable(f"VM へ送れない: {self._err(sent)}")
            started = self.ssh(handle, f"cd {remote} && (setsid nohup bash run.sh >/dev/null 2>&1 </dev/null &)")
            if started.returncode != 0:
                raise Unavailable(f"VM でジョブを起動できない: {self._err(started)}")
        except BaseException as exc:
            # 失敗・中断でも VM を消す（消せなくても --max-run-duration で消える）
            try:
                self.delete_instance(name, zone)
            except Exception as del_exc:
                self.say(f"{del_exc}（hc-remote gc で消す）")
            finally:
                shutil.rmtree(key.parent, ignore_errors=True)
            if isinstance(exc, Unavailable):
                # 作成がはっきり失敗したときだけ 0。時間切れ・中断は VM があったかもしれないので数える
                created_vm = create is None or create.returncode == 0 or create.returncode == 124
                elapsed = time.time() - created + GCP_CREATE_S / 2
                exc.spent_usd = self.estimate_usd(spec.cpu, spec.memory_gb, elapsed) if created_vm else 0.0
            raise
        with contextlib.suppress(FileNotFoundError):
            bundle.unlink()
        return handle

    def poll(self, record: dict[str, Any]) -> Poll:
        handle = record["handle"]
        remote = self.remote_dir(record["id"])
        proc = self.ssh(
            handle,
            f"cd {remote} && if [ -e result.json ]; then cat result.json; elif [ -e setup-error ]; then echo SETUP-ERROR; "
            "elif [ -e pid ] && ! kill -0 \"$(cat pid)\" 2>/dev/null; then echo DEAD; fi",
        )
        if proc.returncode != 0:
            state = self.instance_state(handle)
            if state is None or state in ("STOPPING", "TERMINATED", "SUSPENDED"):
                return Poll(True, error=f"VM {handle['instance']} が無い（Spot の回収・--max-run-duration・cancel）")
            if time.time() > float(handle.get("deadline_epoch") or 0):
                return Poll(True, error=f"VM {handle['instance']} に期限を過ぎても入れない: {self._err(proc)}")
            return Poll(False)  # 一時的な SSH の失敗
        text = proc.stdout.decode(errors="replace").strip()
        if not text:
            return Poll(False)
        if text == "SETUP-ERROR":
            return Poll(True, error="VM の準備（apt・uv）に失敗した（hc-remote logs で理由を見る）")
        if text == "DEAD":
            return Poll(True, error="VM のジョブが結果を残さずに終わった")
        try:
            return Poll(True, json.loads(text))
        except json.JSONDecodeError:
            return Poll(False)

    def local_log(self, record: dict[str, Any]) -> Path:
        return self.state / "jobs" / record["id"] / "log"

    def read_log(self, record: dict[str, Any], offset: int) -> bytes:
        local = self.local_log(record)
        if local.exists():
            with local.open("rb") as f:
                f.seek(offset)
                return f.read()
        proc = self.ssh(record["handle"], f"tail -c +{offset + 1} {self.remote_dir(record['id'])}/log 2>/dev/null || true")
        return proc.stdout if proc.returncode == 0 else b""

    def fetch_outputs(self, record: dict[str, Any], dest: Path) -> bool:
        handle = record["handle"]
        proc = self.scp(handle, f"{GCP_USER}@{handle['instance']}:{self.remote_dir(record['id'])}/out.tar", str(dest))
        return proc.returncode == 0 and dest.exists()

    def cleanup(self, record: dict[str, Any]) -> None:
        """ログを手元に残してから VM を消し、一時鍵を消す。"""
        handle = record["handle"]
        local = self.local_log(record)
        if not local.exists() and Path(handle["key"]).exists():
            local.parent.mkdir(parents=True, exist_ok=True)
            self.scp(handle, f"{GCP_USER}@{handle['instance']}:{self.remote_dir(record['id'])}/log", str(local))
        try:
            self.delete_instance(handle["instance"], handle["zone"])
        finally:
            shutil.rmtree(Path(handle["key"]).parent, ignore_errors=True)

    def cancel(self, record: dict[str, Any]) -> None:
        handle = record["handle"]
        self.delete_instance(handle["instance"], handle["zone"])
        shutil.rmtree(Path(handle["key"]).parent, ignore_errors=True)

    def list_instances(self) -> list[dict[str, Any]]:
        """ラベル hc-remote=1 の VM だけ。ラベルの無い VM（ts-crawler-* など）は一覧にも出さない。"""
        proc = self.gcloud(
            "compute", "instances", "list", f"--filter=labels.{GCP_LABEL}=1", "--format=json", timeout=120
        )
        if proc.returncode != 0:
            raise Unavailable(f"VM の一覧を取れない: {self._err(proc)}")
        items = json.loads(proc.stdout or b"[]")
        return [
            i for i in items
            if (i.get("labels") or {}).get(GCP_LABEL) == "1" and str(i.get("name", "")).startswith(GCP_PREFIX)
        ]


BACKENDS: dict[str, type[Backend]] = {"local": LocalBackend, "modal": ModalBackend, "gcp": GcpBackend}
# auto で試す順。どれにも収まらなければ local（手元）で実行する（2026-11-23 のユーザーの決定）。
AUTO_ORDER = ["modal", "gcp"]


# ---------------------------------------------------------------- 記録


class Store:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.jobs_file = root / "jobs.jsonl"

    def job_dir(self, job_id: str) -> Path:
        return self.root / "jobs" / job_id

    @contextlib.contextmanager
    def lock(self):
        self.root.mkdir(parents=True, exist_ok=True)
        with (self.root / "lock").open("w") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            yield

    def append(self, event: dict[str, Any]) -> None:
        self.root.mkdir(parents=True, exist_ok=True)
        with self.jobs_file.open("a") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")

    def records(self) -> dict[str, dict[str, Any]]:
        merged: dict[str, dict[str, Any]] = {}
        if not self.jobs_file.exists():
            return merged
        for line in self.jobs_file.read_text().splitlines():
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict) or "id" not in event:
                continue
            event.pop("event", None)
            merged.setdefault(event["id"], {}).update(event)
        return merged


# ---------------------------------------------------------------- 本体


class Ctx:
    def __init__(self, cfg: dict[str, Any], store: Store, sdk: Any, out: TextIO, err: TextIO, now: Callable[[], datetime]):
        self.cfg = cfg
        self.store = store
        self.sdk = sdk
        self.out = out
        self.err = err
        self.now = now
        self._backends: dict[str, Backend] = {}

    def backend(self, name: str) -> Backend:
        if name not in BACKENDS:
            raise UsageError(f"知らない backend: {name}")
        if name not in self._backends:
            self._backends[name] = BACKENDS[name](self.cfg, self.store.root, sdk=self.sdk)
            self._backends[name].say = self.say
        return self._backends[name]

    def say(self, msg: str) -> None:
        print(f"hc-remote: {msg}", file=self.err, flush=True)


def budget_status(ctx: Ctx, name: str) -> dict[str, Any]:
    """今月（UTC の月初から）の使用額、実行中のジョブの予約、枠の残り。"""
    backend = ctx.backend(name)
    now = ctx.now()
    start = month_start(now)
    records = [r for r in ctx.store.records().values() if r.get("backend") == name]
    this_month = [r for r in records if r.get("created_at", "") >= iso(start)]
    note = None
    try:
        used = backend.month_usage(start, now)
        source = "report"
    except Unavailable as exc:
        used = sum(float(r.get("est_usd") or 0) for r in this_month if r.get("status") != "running")
        source = "local"
        note = str(exc)
    reserved = sum(float(r.get("max_usd") or 0) for r in records if r.get("status") == "running")
    limit, info, limit_text = backend.budget_limit()
    return {
        "backend": name,
        "month": start.strftime("%Y-%m"),
        "used_usd": round(used, 4),
        "source": source,
        "source_note": note,
        "running_reserved_usd": round(reserved, 4),
        **info,
        "limit_usd": round(limit, 4),
        "limit_text": limit_text,
        "remaining_usd": round(limit - used - reserved, 4),
        "jobs": [
            {k: r.get(k) for k in ("id", "status", "exit_code", "cpu", "memory_gb", "seconds", "est_usd", "max_usd")}
            for r in this_month
        ],
    }


SOURCE_LABEL = {
    "report": "Modal の billing report",
    "local": "手元の記録からの見積もり（hc-remote 以外の使用分は入らない）",
}


def yen(status: dict[str, Any], usd: float) -> str:
    """GCP の枠は円で決めているので、円も添える。"""
    rate = status.get("usd_jpy")
    return f"（約 {usd * rate:.0f} 円）" if rate else ""


def refresh_running(ctx: Ctx) -> None:
    for record in ctx.store.records().values():
        if record.get("status") != "running":
            continue
        try:
            poll = ctx.backend(record["backend"]).poll(record)
        except Exception as exc:
            ctx.say(f"{record['id']} の状態を確かめられない（実行中として数える）: {exc}")
            continue
        if poll.done:
            finish(ctx, record, poll, fetch=False)


def eligible(ctx: Ctx, names: list[str], spec: Spec, reasons: list[str]):
    """使えて枠に収まる backend を順に返す（backend, このジョブの最大見積額）。外れた理由は reasons に足す。"""
    for name in names:
        backend = ctx.backend(name)
        try:
            backend.check_available()
            max_usd = backend.estimate_max_usd(spec)
        except Unavailable as exc:
            reasons.append(f"{name}: {exc}")
            continue
        if backend.billable:
            status = budget_status(ctx, name)
            need = status["used_usd"] + status["running_reserved_usd"] + max_usd
            ctx.say(
                f"{name} の今月の使用額 ${status['used_usd']:.2f}（{SOURCE_LABEL[status['source']]}）"
                f" + 実行中 ${status['running_reserved_usd']:.2f} + このジョブの最大 ${max_usd:.2f}"
                f" = ${need:.2f}{yen(status, need)} / 枠 ${status['limit_usd']:.2f}（{status['limit_text']}）"
            )
            if status["source_note"]:
                ctx.say(f"実際の使用額を使わなかった理由: {status['source_note']}")
            if need > status["limit_usd"]:
                reasons.append(f"{name}: {backend.budget_word}を超える（${need:.2f} > ${status['limit_usd']:.2f}）")
                continue
        yield backend, max_usd


def launch_first(
    ctx: Ctx, requested: str, spec: Spec, job_id: str, bundle: Path, nfiles: int, size: int
) -> tuple[Backend, float, dict[str, Any], str | None]:
    """枠に収まる backend で起動する。auto でどの remote でも起動できなければ、手元（local）で実行する。"""
    names = AUTO_ORDER if requested == "auto" else [requested]
    reasons: list[str] = []
    for backend, max_usd in eligible(ctx, names, spec, reasons):
        ctx.say(f"{job_id} を {backend.name} で起動する（{nfiles} ファイル、{size / 1024:.0f} KB）")
        try:
            return backend, max_usd, backend.launch(job_id, spec, bundle), None
        except Unavailable as exc:
            record_failed_launch(ctx, backend, job_id, spec, exc)
            if requested != "auto":
                raise LaunchFailed(f"{backend.name} で起動できない: {exc}") from exc
            reasons.append(f"{backend.name}: {exc}")
            ctx.say(f"{backend.name} で起動できない。次を試す: {exc}")
    if requested != "auto":
        raise Refused("; ".join(reasons))
    fallback = "; ".join(reasons)
    ctx.say(f"どの remote にも収まらないため、手元（local）で実行する: {fallback}")
    local = ctx.backend("local")
    return local, 0.0, local.launch(job_id, spec, bundle), fallback


def record_failed_launch(ctx: Ctx, backend: Backend, job_id: str, spec: Spec, exc: Unavailable) -> None:
    """起動に失敗するまでに課金があれば（VM を作った後の失敗）、枠に数えるため記録に残す。"""
    if not exc.spent_usd:
        return
    ctx.store.append(
        {
            "event": "launch_failed",
            "id": f"{job_id}-{backend.name}",
            "backend": backend.name,
            "status": "error",
            "created_at": iso(ctx.now()),
            "ended_at": iso(ctx.now()),
            "cmd": spec.cmd,
            "cpu": spec.cpu,
            "memory_gb": spec.memory_gb,
            "timeout_s": spec.timeout_s,
            "est_usd": round(exc.spent_usd, 4),
            "error": str(exc),
            "fetched": True,
        }
    )


def new_job_id(now: datetime) -> str:
    return now.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(2)


def cmd_run(ctx: Ctx, args: argparse.Namespace, cwd: Path) -> int:
    words = list(args.cmd)
    if words and words[0] == "--":
        words = words[1:]
    if not words:
        raise UsageError("実行するコマンドを -- の後に書いてください")
    cmd = words[0] if len(words) == 1 else shlex.join(words)
    defaults, limits = ctx.cfg["defaults"], ctx.cfg["limits"]
    spec = Spec(
        cmd=cmd,
        outs=check_outs(args.out or []),
        cpu=float(args.cpu if args.cpu is not None else defaults["cpu"]),
        memory_gb=float(args.memory if args.memory is not None else defaults["memory_gb"]),
        timeout_s=parse_duration(args.timeout if args.timeout is not None else defaults["timeout"]),
    )
    requested = args.backend or defaults["backend"]
    if requested != "auto" and requested not in BACKENDS:
        raise UsageError(f"知らない backend: {requested}")
    root = git_root(cwd)
    files, skipped = list_files(root)
    found = find_secrets(root, files)
    if found:
        raise Refused(
            "秘密情報らしいファイルがあるため送りません（.gitignore に足すか、worktree の外へ移す）: "
            + ", ".join(found)
        )
    if skipped:
        ctx.say(f"ディレクトリ（submodule など）は送らない: {', '.join(skipped)}")
    check_limits(spec, limits)

    job_id = new_job_id(ctx.now())
    job_dir = ctx.store.job_dir(job_id)
    bundle = job_dir / "bundle.tar"
    size = make_bundle(root, files, bundle)
    max_upload = float(limits["max_upload_mb"]) * 1024 * 1024
    if size > max_upload:
        shutil.rmtree(job_dir, ignore_errors=True)
        raise Refused(f"送る量 {size / 1024 / 1024:.1f} MB が上限 max_upload_mb={limits['max_upload_mb']} を超える")

    try:
        with ctx.store.lock():
            refresh_running(ctx)
            running = [r for r in ctx.store.records().values() if r.get("status") == "running"]
            if len(running) >= int(limits["max_concurrent_jobs"]):
                raise Refused(
                    f"実行中のジョブが {len(running)} 件あり、上限 max_concurrent_jobs={limits['max_concurrent_jobs']} に達している"
                    f"（{', '.join(r['id'] for r in running)}）"
                )
            backend, max_usd, handle, fallback = launch_first(ctx, requested, spec, job_id, bundle, len(files), size)
            record = {
                "event": "launch",
                "id": job_id,
                "backend": backend.name,
                "status": "running",
                "created_at": iso(ctx.now()),
                "root": str(root),
                "cmd": spec.cmd,
                "outs": spec.outs,
                "cpu": spec.cpu,
                "memory_gb": spec.memory_gb,
                "timeout_s": spec.timeout_s,
                "max_usd": round(max_usd, 4),
                "handle": handle,
            }
            if fallback:
                record["fallback_reason"] = fallback
            ctx.store.append(record)
    except BaseException:
        if not any(r["id"] == job_id for r in ctx.store.records().values()):
            shutil.rmtree(job_dir, ignore_errors=True)
        raise
    record.pop("event")
    return follow(ctx, record)


def _sigterm_as_interrupt(signum: int, frame: Any) -> None:
    raise KeyboardInterrupt


def follow(ctx: Ctx, record: dict[str, Any]) -> int:
    backend = ctx.backend(record["backend"])
    offset = 0
    try:
        while True:
            chunk = backend.read_log(record, offset)
            if chunk:
                ctx.out.write(chunk.decode(errors="replace"))
                ctx.out.flush()
                offset += len(chunk)
            poll = backend.poll(record)
            if poll.done:
                break
            time.sleep(backend.poll_interval)
    except KeyboardInterrupt:
        if backend.detached:
            ctx.say(
                f"待つのをやめた。{record['id']} は動き続けている。"
                f"hc-remote wait {record['id']} で続きを待つ、hc-remote cancel {record['id']} で止める"
            )
            return 130
        ctx.say(f"中断したので {record['id']} を止めて {backend.name} の後始末をする")
        abort(ctx, record, "run を中断した", cancelled=True)
        return 130
    except Exception as exc:
        if backend.detached:
            raise
        ctx.say(f"{record['id']} を見ている途中で失敗したので {backend.name} の後始末をする: {type(exc).__name__}: {exc}")
        abort(ctx, record, f"{type(exc).__name__}: {exc}", cancelled=False)
        return EXIT_INFRA
    chunk = backend.read_log(record, offset)
    if chunk:
        ctx.out.write(chunk.decode(errors="replace"))
        ctx.out.flush()
    return finish(ctx, record, poll, fetch=True)


def abort(ctx: Ctx, record: dict[str, Any], why: str, *, cancelled: bool) -> None:
    """detached でない backend（GCP）で run が止まったとき: ジョブを止め（VM を消し）、記録を閉じる。"""
    backend = ctx.backend(record["backend"])
    try:
        backend.cancel(record)
    except Exception as exc:
        ctx.say(f"{record['id']} を止められない（hc-remote gc で消す）: {exc}")
    if cancelled:
        ctx.store.append({"event": "cancel", "id": record["id"], "cancel_requested": iso(ctx.now())})
    finish(ctx, record, Poll(True, error=why), fetch=True)


def finish(ctx: Ctx, record: dict[str, Any], poll: Poll, *, fetch: bool) -> int:
    backend = ctx.backend(record["backend"])
    result = poll.result or {}
    current = ctx.store.records().get(record["id"], record)
    if current.get("cancel_requested") or result.get("cancelled"):
        status = "cancelled"
    elif poll.error:
        status = "error"
    elif result.get("timed_out"):
        status = "timeout"
    else:
        status = "done"
    seconds = backend.billed_seconds(record, result, ctx.now(), final=fetch)
    est = backend.estimate_usd(float(record["cpu"]), float(record["memory_gb"]), seconds)
    event: dict[str, Any] = {
        "event": "finish",
        "id": record["id"],
        "status": status,
        "exit_code": result.get("exit_code"),
        "ended_at": iso(ctx.now()),
        "seconds": round(seconds, 1),
        "est_usd": round(est, 4),
    }
    if poll.error:
        event["error"] = poll.error
        ctx.say(f"{record['id']}: {poll.error}")
    if fetch and poll.result is not None and record.get("outs"):
        tmp = ctx.store.job_dir(record["id"]) / "fetched-out.tar"
        tmp.parent.mkdir(parents=True, exist_ok=True)
        if backend.fetch_outputs(record, tmp):
            try:
                with tarfile.open(tmp) as tar:
                    tar.extractall(record["root"], filter="data")
            except (tarfile.TarError, OSError) as exc:
                event["error"] = f"--out を展開できない（{tmp} に残した）: {exc}"
                ctx.say(event["error"])
            else:
                tmp.unlink()
                got = [o for o in record["outs"] if o not in result.get("missing_outs", [])]
                if got:
                    ctx.say(f"持ち帰った: {', '.join(got)}")
        if result.get("missing_outs"):
            ctx.say(f"遠隔に無かった --out: {', '.join(result['missing_outs'])}")
    if fetch:
        event["fetched"] = True
    if current.get("status") == "running" or fetch:
        ctx.store.append(event)
    if fetch:
        try:
            backend.cleanup(record)
        except Exception as exc:
            ctx.say(f"{record['id']} の後始末に失敗した（hc-remote gc で消す）: {exc}")
        ctx.say(
            f"{record['id']} {status} 終了コード {result.get('exit_code')}"
            f"（{format_duration(seconds)}、見積もり ${est:.4f}）"
        )
    code = result.get("exit_code")
    return int(code) if code is not None else EXIT_INFRA


def own_record(ctx: Ctx, job_id: str) -> dict[str, Any]:
    record = ctx.store.records().get(job_id)
    if record is None:
        raise UsageError(f"hc-remote が起動したジョブの記録にありません: {job_id}（hc-remote ls で確かめる）")
    return record


def cmd_wait(ctx: Ctx, args: argparse.Namespace) -> int:
    record = own_record(ctx, args.id)
    if record.get("fetched"):
        ctx.say(f"{record['id']} は終わって持ち帰り済み（{record.get('status')}、終了コード {record.get('exit_code')}）")
        code = record.get("exit_code")
        return int(code) if code is not None else EXIT_INFRA
    return follow(ctx, record)


def cmd_logs(ctx: Ctx, args: argparse.Namespace) -> int:
    record = own_record(ctx, args.id)
    data = ctx.backend(record["backend"]).read_log(record, 0)
    ctx.out.write(data.decode(errors="replace"))
    return 0


def cmd_cancel(ctx: Ctx, args: argparse.Namespace) -> int:
    record = own_record(ctx, args.id)
    if record.get("status") != "running":
        ctx.say(f"{record['id']} は実行中ではない（{record.get('status')}）")
        return 0
    ctx.backend(record["backend"]).cancel(record)
    ctx.store.append({"event": "cancel", "id": record["id"], "cancel_requested": iso(ctx.now())})
    ctx.say(f"{record['id']} を止めた。hc-remote wait {record['id']} で結果を記録する")
    return 0


def cmd_ls(ctx: Ctx, args: argparse.Namespace) -> int:
    refresh_running(ctx)
    records = sorted(ctx.store.records().values(), key=lambda r: r.get("created_at", ""))
    if args.json:
        ctx.out.write(json.dumps(records, ensure_ascii=False, indent=2) + "\n")
        return 0
    if not records:
        ctx.out.write("hc-remote のジョブの記録はありません\n")
        return 0
    ctx.out.write(f"{'id':<24} {'backend':<7} {'status':<9} {'exit':>4} {'cpu':>4} {'mem':>5} {'time':>7} {'est$':>8}  cmd\n")
    for r in records[-30:]:
        exit_code = "" if r.get("exit_code") is None else str(r["exit_code"])
        elapsed = format_duration(r["seconds"]) if r.get("seconds") is not None else ""
        est = f"{r['est_usd']:.4f}" if r.get("est_usd") is not None else f"<{r.get('max_usd', 0):.2f}"
        cmd = r.get("cmd", "")
        cmd = cmd if len(cmd) <= 50 else cmd[:47] + "..."
        ctx.out.write(
            f"{r['id']:<24} {r.get('backend', ''):<7} {r.get('status', ''):<9} {exit_code:>4} "
            f"{r.get('cpu', 0):>4g} {r.get('memory_gb', 0):>5g} {elapsed:>7} {est:>8}  {cmd}\n"
        )
    return 0


def cmd_budget(ctx: Ctx, args: argparse.Namespace) -> int:
    refresh_running(ctx)
    statuses = [budget_status(ctx, name) for name, cls in BACKENDS.items() if cls.billable]
    if args.json:
        ctx.out.write(json.dumps(statuses if len(statuses) != 1 else statuses[0], ensure_ascii=False, indent=2) + "\n")
        return 0
    for s in statuses:
        ctx.out.write(
            f"{s['backend']} {s['month']}（UTC）\n"
            f"  使用額: ${s['used_usd']:.2f}{yen(s, s['used_usd'])}（{SOURCE_LABEL[s['source']]}）\n"
        )
        if s["source_note"]:
            ctx.out.write(f"  実際の使用額を使わなかった理由: {s['source_note']}\n")
        ctx.out.write(
            f"  実行中のジョブの最大見積額: ${s['running_reserved_usd']:.2f}{yen(s, s['running_reserved_usd'])}\n"
            f"  枠: ${s['limit_usd']:.2f}（{s['limit_text']}）\n"
            f"  残り: ${s['remaining_usd']:.2f}{yen(s, s['remaining_usd'])}\n"
            f"  今月の記録にあるジョブ: {len(s['jobs'])} 件\n"
        )
        for j in s["jobs"]:
            est = "" if j.get("est_usd") is None else f"${j['est_usd']:.4f}"
            ctx.out.write(f"    {j['id']} {j.get('status')} cpu={j.get('cpu')} mem={j.get('memory_gb')}GB {est}\n")
    return 0


def cmd_gc(ctx: Ctx, args: argparse.Namespace) -> int:
    """ラベル hc-remote=1 の GCP の VM のうち、記録で終わっているもの・期限を過ぎたものを消す。"""
    backend = ctx.backend("gcp")
    backend.check_available()
    records = ctx.store.records()
    now = ctx.now().timestamp()
    instances = backend.list_instances()
    if not instances:
        ctx.out.write("hc-remote の VM（ラベル hc-remote=1）はありません\n")
        return 0
    failed = 0
    for inst in instances:
        name = inst["name"]
        labels = inst.get("labels") or {}
        job_id = labels.get("hc-remote-job", "")
        zone = str(inst.get("zone", backend.opts["zone"])).rsplit("/", 1)[-1]
        record = records.get(job_id)
        try:
            deadline = int(labels.get("hc-remote-deadline", ""))
        except ValueError:
            deadline = None
        if record is not None and record.get("status") != "running" and record.get("fetched"):
            why = f"記録で終わっている（{record.get('status')}）"
        elif deadline is not None and now > deadline:
            why = "期限（--max-run-duration + 余裕）を過ぎた"
        else:
            if record is None:
                state = "記録に無い（期限前）"
            elif record.get("status") == "running":
                state = "記録で実行中"
            else:
                state = f"終わったが持ち帰り前。hc-remote wait {job_id} で持ち帰って消す"
            ctx.out.write(f"残す: {name}（{state}、{inst.get('status')}）\n")
            continue
        if args.dry_run:
            ctx.out.write(f"消す予定: {name}（{why}）\n")
            continue
        try:
            backend.delete_instance(name, zone)
        except Unavailable as exc:
            failed += 1
            ctx.out.write(f"消せない: {name}: {exc}\n")
            continue
        ctx.out.write(f"消した: {name}（{why}）\n")
        if record is not None and record.get("status") == "running":
            ctx.store.append(
                {"event": "finish", "id": job_id, "status": "error", "ended_at": iso(ctx.now()),
                 "error": "期限を過ぎたので hc-remote gc が VM を消した",
                 "est_usd": record.get("max_usd"), "fetched": True}
            )
    return 1 if failed else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hc-remote", description="重い処理を Modal・GCP へ回す（docs/hc-remote.md）")
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="worktree を送ってコマンドを実行する")
    run.add_argument("--backend", choices=["auto", *BACKENDS])
    run.add_argument("--cpu", type=float, help="物理コア数")
    run.add_argument("--memory", type=float, help="GiB")
    run.add_argument("--timeout", help="例: 30m、2h")
    run.add_argument("--out", action="append", help="持ち帰る path（worktree からの相対）。何度でも書ける")
    run.add_argument("cmd", nargs=argparse.REMAINDER)
    budget = sub.add_parser("budget", help="今月の使用額と枠（Modal の無料枠・GCP の予算）の残り")
    budget.add_argument("--json", action="store_true")
    ls = sub.add_parser("ls", help="hc-remote が起動したジョブ")
    ls.add_argument("--json", action="store_true")
    for name, text in (("logs", "ジョブのログ"), ("wait", "ジョブを待ってログと --out を持ち帰る"), ("cancel", "ジョブを止める")):
        p = sub.add_parser(name, help=text)
        p.add_argument("id")
    gc = sub.add_parser("gc", help="残った GCP の VM（ラベル hc-remote=1）のうち、終わったもの・期限切れを消す")
    gc.add_argument("--dry-run", action="store_true", help="消さずに表示だけする")
    return parser


def main(
    argv: list[str] | None = None,
    *,
    sdk: Any = None,
    cwd: Path | None = None,
    out: TextIO | None = None,
    err: TextIO | None = None,
    now: Callable[[], datetime] = utcnow,
) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["_exec-local"]:
        return _local_runner(argv[1])
    out = out or sys.stdout
    err = err or sys.stderr
    args = build_parser().parse_args(argv)
    previous = None
    if args.command in ("run", "wait") and threading.current_thread() is threading.main_thread():
        # Bash の時間制限などで SIGTERM を受けても Ctrl-C と同じに扱う（GCP は起動中・実行中の VM を消してから終わる）
        previous = signal.signal(signal.SIGTERM, _sigterm_as_interrupt)
    try:
        ctx = Ctx(load_config(), Store(state_dir()), sdk, out, err, now)
        if args.command == "run":
            return cmd_run(ctx, args, cwd or Path.cwd())
        return {"budget": cmd_budget, "ls": cmd_ls, "logs": cmd_logs, "wait": cmd_wait, "cancel": cmd_cancel, "gc": cmd_gc}[
            args.command
        ](ctx, args)
    except Refused as exc:
        print(f"hc-remote: 起動しません（ユーザー確認が必要）: {exc}", file=err)
        return EXIT_REFUSED
    except LaunchFailed as exc:
        print(f"hc-remote: {exc}", file=err)
        return EXIT_INFRA
    except (UsageError, Unavailable) as exc:
        print(f"hc-remote: {exc}", file=err)
        return EXIT_USAGE
    finally:
        if previous is not None:
            signal.signal(signal.SIGTERM, previous)


if __name__ == "__main__":
    sys.exit(main())
