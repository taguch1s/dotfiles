#!/usr/bin/env python3
"""hc 上の Claude Code セッションの事故よけ（PreToolUse hook）。

hc 上のセッションは dev ディストリの中で権限確認なし（bypassPermissions）で動く。境界は
ディストリなので、この hook は防御線ではなく、取り返しのつかない操作をうっかり実行しない
ための歯止めに限る。当たれば理由付きで deny し（エージェントにはエラーが返るだけで止まらない）、
当たらなければ何も決めない。allow・ask を返したり、判断を auto mode や監督役に回したりはしない。

  hook             PreToolUse hook（stdin に hook 入力）。Bash のコマンドだけを見る。
  check COMMAND    コマンド文字列を判定して表示する（ルールの確認用）。
  hook-worker / hook-supervisor
                   旧構成（#21・#25）の hook 名。移行中に古い設定から呼ばれても何もしない。

全体像は docs/herdr-core-orchestration.md を参照。
"""

from __future__ import annotations

import argparse
import json
import re
import sys

_SEG = r"[^;&|\n]*"  # 同じ単純コマンドの中だけを見る
_START = r"(^|[\s;&|(`])"  # コマンドの先頭

# (正規表現, 理由)。コマンド文字列全体に対して照合する（$(...) の中も対象）。
DENY_RULES: list[tuple[str, str]] = [
    # 一般ユーザーに sudo はない。パスワード入力で止まらないよう、実行させずに返す。
    (rf"{_START}(sudo|doas|pkexec)\b", "管理者権限（dev の作業ユーザーは root になれない）"),
    (rf"{_START}su(\s+-|\s+root|\s*$)", "ユーザー切り替え（su）"),
    # リモートの履歴とブランチ（GitHub の ruleset でも止める）。
    (rf"\bgit\b{_SEG}\bpush\b{_SEG}(\s--force(-with-lease|-if-includes)?\b|\s-[a-zA-Z]*f[a-zA-Z]*\b|\s\+\S)",
     "force push"),
    (rf"\bgit\b{_SEG}\bpush\b{_SEG}(\s--mirror\b|\s--delete\b|\s-d\b|\s:\S|\s--prune\b)",
     "リモートのブランチ・tag の削除や mirror push"),
    # 手元の未保存の作業や履歴を消す操作。
    (rf"\bgit\b{_SEG}\breset\b{_SEG}--hard\b", "git reset --hard（未 commit の変更が消える。git stash を使う）"),
    (rf"\bgit\b{_SEG}\bclean\b{_SEG}\s-[a-zA-Z]*f", "git clean -f（未追跡ファイルが消える）"),
    (rf"\bgit\b{_SEG}\bbranch\b{_SEG}\s(-[a-zA-Z]*D\b|--delete\b{_SEG}--force\b|--force\b{_SEG}--delete\b)",
     "マージしていないブランチの強制削除（git branch -d を使う）"),
    (rf"\bgit\b{_SEG}\bstash\s+(drop|clear)\b", "stash の破棄"),
    (rf"\bgit\b{_SEG}\b(filter-branch|filter-repo|update-ref\s+-d)\b", "履歴・参照の書き換え"),
    (rf"\bgit\b{_SEG}\bconfig\b{_SEG}--(global|system)\b", "Git の全体設定の変更（全セッションに効く）"),
    # GitHub 側の設定と公開物。
    (r"\bgh\s+repo\s+(delete|archive|rename|edit)\b", "リポジトリ設定の変更・削除"),
    (r"\bgh\s+release\s+delete\b", "リリースの削除"),
    (r"\bgh\s+(secret|variable|ssh-key|gpg-key)\b", "秘密情報・鍵の操作"),
    (r"\bgh\s+auth\s+(logout|refresh|switch|token|setup-git)\b", "GitHub 認証の変更・表示（全セッションに効く）"),
    (rf"\bgh\s+api\b{_SEG}(-X|--method)\s*['\"]?DELETE", "GitHub API での削除"),
    (rf"\bgh\s+api\b{_SEG}(rulesets|/protection)\b{_SEG}\s(-X|--method|-f|-F|--field|--raw-field|--input)\b",
     "ruleset・ブランチ保護の変更"),
    (rf"\bgh\s+api\b{_SEG}\s(-X|--method|-f|-F|--field|--raw-field|--input)\b{_SEG}(rulesets|/protection)\b",
     "ruleset・ブランチ保護の変更"),
    (r"\b(npm|pnpm|yarn|bun)\s+publish\b|\bcargo\s+publish\b|\btwine\s+upload\b|\buv\s+publish\b|\bdocker\s+push\b",
     "パッケージ・イメージの公開"),
    # ファイルシステムとシステム。
    (rf"\brm\b{_SEG}\s(/|/\*|~|~/|~/\*|\$HOME|\$HOME/|\$\{{HOME\}}|\.\.?/?|\*)(?=\s|$|;|&|\|)",
     "ルート・ホーム・カレントディレクトリ全体の削除"),
    (r"\b(curl|wget)\b[^;&\n]*\|\s*(sudo\s+)?(ba|z|da)?sh\b", "ダウンロードしたスクリプトの実行"),
    (rf"{_START}(mkfs(\.\w+)?|shutdown|reboot|poweroff|halt|fdisk|parted)\b", "システム操作"),
    (r"\bdd\b[^;&|\n]*\bof=/dev/", "デバイスへの書き込み"),
    (r"\bcrontab\s+-r\b", "crontab の削除"),
    (r"\bchmod\b[^;&|\n]*\b777\b", "chmod 777"),
]


def deny_reason(command: str) -> str | None:
    for pattern, reason in DENY_RULES:
        if re.search(pattern, command):
            return reason
    return None


def hook() -> int:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    if not isinstance(payload, dict) or payload.get("tool_name") != "Bash":
        return 0
    command = (payload.get("tool_input") or {}).get("command")
    if not isinstance(command, str):
        return 0
    reason = deny_reason(command)
    if reason is None:
        return 0
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                f"事故よけの hook が止めました: {reason}。"
                "別の方法で進めるか、必要なら監督役（hc send supervisor）に判断を依頼してください。"),
        }
    }, ensure_ascii=False))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="hc-permission", description="hc 上の Claude Code セッションの事故よけ hook。")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("hook", help="PreToolUse hook（stdin に hook 入力）")
    check = sub.add_parser("check", help="コマンド文字列を判定して表示する")
    check.add_argument("text")
    sub.add_parser("hook-worker", help="旧構成の hook 名（何もしない）")
    sub.add_parser("hook-supervisor", help="旧構成の hook 名（何もしない）")
    args = parser.parse_args(argv)

    if args.command == "hook":
        return hook()
    if args.command == "check":
        reason = deny_reason(args.text)
        print(f"deny: {reason}" if reason else "通す")
        return 1 if reason else 0
    # 旧構成の hook。stdin を読み捨て、決定を返さない（通常の権限確認に任せる）。
    sys.stdin.read()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
