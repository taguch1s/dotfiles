#!/usr/bin/env bash
# hc 上の Claude Code（監督役・ワーカー）を起動する。hc のテンプレートから呼ぶ。
# 権限確認なし（bypassPermissions・sandbox なし）で動かすので、境界になる dev ディストリ
# （/etc/dotfiles-role が dev）でだけ起動し、それ以外（admin）では起動しない。
# 全体像は docs/herdr-core-orchestration.md、dev の作り方は docs/wsl-dev-distro.md。
set -euo pipefail

role_file="${HC_CLAUDE_ROLE_FILE:-/etc/dotfiles-role}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-core/claude"

die() {
  printf 'hc-claude: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: hc-claude supervisor [claude の引数...]
       hc-claude supervisor [--model fable|opus] [claude の引数...]
       hc-claude worker [--model opus|sonnet] [claude の引数...]

役割のシステムプロンプトと hc 用の settings を付けて、claude を権限確認なしで起動する。
dev ディストリ（/etc/dotfiles-role が dev）でだけ動く。
hc 上の監督役は、hc-supervisor restart で同じ terminal のまま claude を起動し直せる。
モデルは役割の直後の --model で選べる。監督役は既定が fable で、fable か opus
（hc のテンプレート claude-supervisor-opus が --model opus を渡す）。ワーカーは既定が opus で、
opus か sonnet（hc のテンプレート claude-worker-sonnet が --model sonnet を渡す）。
EOF
}

role="${1:-}"
case "$role" in
  supervisor|worker) shift ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

# モデル: 役割の直後の --model <名前> で選べる。監督役は fable（既定）か opus、ワーカーは opus（既定）か sonnet
# （監督役の既定を fable にしたのはユーザーの判断、2026-11-27。それまでは opus 固定）。
# 許可しない名前は、警告して役割の既定で起動する（起動は止めない）。
# --model は claude にそのまま渡さずここで消費する（claude に --model を二重に渡さない）。
if [[ "$role" == supervisor ]]; then
  allowed_models=(fable opus)
else
  allowed_models=(opus sonnet)
fi
default_model="${allowed_models[0]}"
model="$default_model"
is_allowed_model() {
  local allowed
  for allowed in "${allowed_models[@]}"; do [[ "$1" == "$allowed" ]] && return 0; done
  return 1
}
if [[ "${1:-}" == --model || "${1:-}" == --model=* ]]; then
  if [[ "$1" == --model=* ]]; then
    requested="${1#--model=}"
    shift
  else
    (($# >= 2)) || { usage >&2; exit 2; }
    requested="$2"
    shift 2
  fi
  if is_allowed_model "$requested"; then
    model="$requested"
  else
    printf 'hc-claude: --model %s は許可していないモデルなので、%s を使います（許可: %s）。\n' "$requested" "$default_model" "${allowed_models[*]}" >&2
  fi
fi

distro_role="$(cat "$role_file" 2>/dev/null || true)"
[[ "$distro_role" == dev ]] \
  || die "dev ディストリでだけ起動します（$role_file が dev ではありません）。admin ではエージェントを動かしません。dev の作り方: docs/wsl-dev-distro.md"

settings="$config_dir/session-settings.json"
prompt="$config_dir/$role-prompt.md"
[[ -f "$settings" && -f "$prompt" ]] || die "設定がありません: $settings / $prompt（dotfiles で make link を実行してください）"

# effort: 監督役は判断の質を優先して high、ワーカーは量をこなすので medium。
# ~/.claude/settings.json の effortLevel に左右されないよう明示する。
case "$role" in
  supervisor) effort=high ;;
  worker) effort=medium ;;
esac

# 文脈予算: session-settings.json の claude-context-guard hook が読む閾値と上限を役割ごとに渡す。
# 閾値は監督役 200k（CLAUDE.md の対話と同じ）、ワーカー 180k。上限は自動 compact（約 243k）の
# 手前で handoff を書かせるためのもので、役割共通の 225k（#61）。上書きは役割ごとの
# HC_CLAUDE_<ROLE>_CTX_GUARD_TOKENS（閾値）・HC_CLAUDE_<ROLE>_CTX_GUARD_LIMIT_TOKENS（上限）で行い、
# 呼び出し元の CLAUDE_CTX_GUARD_TOKENS・CLAUDE_CTX_GUARD_LIMIT_TOKENS は使わない
# （監督役の環境がワーカーに引き継がれても、ワーカーの値が監督役の値にならないように）。
role_upper="${role^^}"
case "$role" in
  supervisor) ctx_tokens=200000 ;;
  worker) ctx_tokens=180000 ;;
esac
ctx_limit_tokens=225000
# 役割ごとの上書き（環境変数名 $1）が正の整数ならそれを、そうでなければ既定（$2）を出す。
ctx_value() {
  local var="$1" value="$2" override="${!1:-}"
  if [[ "$override" =~ ^[1-9][0-9]*$ ]]; then
    value="$override"
  elif [[ -n "$override" ]]; then
    printf 'hc-claude: %s=%s は正の整数ではないので、既定の %s を使います。\n' "$var" "$override" "$value" >&2
  fi
  printf '%s\n' "$value"
}
CLAUDE_CTX_GUARD_TOKENS="$(ctx_value "HC_CLAUDE_${role_upper}_CTX_GUARD_TOKENS" "$ctx_tokens")"
CLAUDE_CTX_GUARD_LIMIT_TOKENS="$(ctx_value "HC_CLAUDE_${role_upper}_CTX_GUARD_LIMIT_TOKENS" "$ctx_limit_tokens")"
export CLAUDE_CTX_GUARD_TOKENS CLAUDE_CTX_GUARD_LIMIT_TOKENS
# 役割: SessionEnd の claude-token-metrics record が hc.role に記録し、タスク単位の集計で監督役を分ける（#48）。
export HC_CLAUDE_ROLE="$role"

claude_args=(--model "$model" --effort "$effort" --permission-mode bypassPermissions
  --settings "$settings" --append-system-prompt-file "$prompt")

# ワーカー、または hc の外: claude に置き換わる。
if [[ "$role" != supervisor || -z "${HC_TERMINAL_ID:-}" ]]; then
  exec "${HC_CLAUDE_BIN:-claude}" "${claude_args[@]}" "$@"
fi

# 監督役: 同じ terminal（同じ tN）のまま Claude Code だけを入れ替えられるよう、claude を子として動かす。
# hc の terminal の parent は起動時に決まり変えられないので、terminal を作り直すと、監督役が起動した
# ワーカーとの親子関係が切れる。hc-supervisor restart は <状態>/<tN>.pid（この bash の pid）を見て、
# <状態>/<tN>.restart に新しい claude への最初の依頼文を書いてから claude を SIGTERM で止める。
# claude が終わったとき .restart があれば、その依頼文で claude を起動し直す。無ければ終わる。
# <状態>/<tN>.model があれば（hc-supervisor restart --model）、起動し直す claude のモデルをそれに替える
# （許可しない名前は、警告していまのモデルのまま）。無ければ、いまのモデルのまま。
state_dir="${HC_CLAUDE_STATE_DIR:-$HOME/.local/state/hc-claude}"
pid_file="$state_dir/$HC_TERMINAL_ID.pid"
restart_file="$state_dir/$HC_TERMINAL_ID.restart"
model_file="$state_dir/$HC_TERMINAL_ID.model"
mkdir -p "$state_dir"
rm -f "$restart_file" "$model_file"
echo "$$" >"$pid_file"
trap 'rm -f "$pid_file"' EXIT
args=("$@")
while :; do
  status=0
  "${HC_CLAUDE_BIN:-claude}" "${claude_args[@]}" "${args[@]}" || status=$?
  [[ -f "$restart_file" ]] || exit "$status"
  request="$(<"$restart_file")"
  rm -f "$restart_file"
  if [[ -f "$model_file" ]]; then
    requested="$(<"$model_file")"
    rm -f "$model_file"
    if is_allowed_model "$requested"; then
      model="$requested"
      claude_args[1]="$model"
    else
      printf 'hc-claude: 起動し直すモデル %s は許可していないので、%s のままにします（許可: %s）。\n' "$requested" "$model" "${allowed_models[*]}" >&2
    fi
  fi
  args=()
  [[ -z "$request" ]] || args=("$request")
  printf '\nhc-claude: Claude Code を起動し直します（同じ terminal %s のまま）。\n' "$HC_TERMINAL_ID"
done
