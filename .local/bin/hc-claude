#!/usr/bin/env bash
# hc 上の Claude Code（監督役・ワーカー）を起動する。hc のテンプレートから呼ぶ。
# 権限確認なし（bypassPermissions・sandbox なし）で動かすので、境界になる dev ディストリ
# （/etc/dotfiles-role が dev）でだけ起動し、それ以外（admin）では起動しない。
# 全体像は docs/herdr-core-orchestration.md、dev の作り方は docs/wsl-dev-distro.md。
set -euo pipefail

role_file="${HC_CLAUDE_ROLE_FILE:-/etc/dotfiles-role}"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-core/claude"

die() {
  printf 'hc-claude: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: hc-claude supervisor [claude の引数...]
       hc-claude worker [--model opus|sonnet] [claude の引数...]

役割のシステムプロンプトと hc 用の settings を付けて、claude を権限確認なしで起動する。
dev ディストリ（/etc/dotfiles-role が dev）でだけ動く。
hc 上の監督役は、hc-supervisor restart で同じ terminal のまま claude を起動し直せる。
モデルは既定で opus。ワーカーだけ、役割の直後の --model で opus か sonnet を選べる
（hc のテンプレート claude-worker-sonnet が --model sonnet を渡す）。監督役は opus のまま。
EOF
}

role="${1:-}"
case "$role" in
  supervisor|worker) shift ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

# モデル: 既定は opus。ワーカーだけ、役割の直後の --model <名前> で選べる（監督役は判断の質を優先して opus 固定）。
# 許可しない名前・監督役への指定は、警告して opus で起動する（起動は止めない。迷ったら opus の方針と同じ）。
# --model は claude にそのまま渡さずここで消費する（claude に --model を二重に渡さない）。
allowed_models=(opus sonnet)
model=opus
if [[ "${1:-}" == --model || "${1:-}" == --model=* ]]; then
  if [[ "$1" == --model=* ]]; then
    requested="${1#--model=}"
    shift
  else
    (($# >= 2)) || { usage >&2; exit 2; }
    requested="$2"
    shift 2
  fi
  if [[ "$role" != worker ]]; then
    printf 'hc-claude: 監督役のモデルは opus 固定です（--model %s は使いません）。\n' "$requested" >&2
  else
    for allowed in "${allowed_models[@]}"; do
      [[ "$requested" != "$allowed" ]] || model="$requested"
    done
    [[ "$model" == "$requested" ]] \
      || printf 'hc-claude: --model %s は許可していないモデルなので、opus を使います（許可: %s）。\n' "$requested" "${allowed_models[*]}" >&2
  fi
fi

distro_role="$(cat "$role_file" 2>/dev/null || true)"
[[ "$distro_role" == dev ]] \
  || die "dev ディストリでだけ起動します（$role_file が dev ではありません）。admin ではエージェントを動かしません。dev の作り方: docs/wsl-dev-distro.md"

settings="$config_dir/session-settings.json"
prompt="$config_dir/$role-prompt.md"
[[ -f "$settings" && -f "$prompt" ]] || die "設定がありません: $settings / $prompt（dotfiles で make link を実行してください）"

# effort: 監督役は判断の質を優先して high、ワーカーは量をこなすので medium。
# ~/.claude/settings.json の effortLevel に左右されないよう明示する。
case "$role" in
  supervisor) effort=high ;;
  worker) effort=medium ;;
esac

# 文脈予算: session-settings.json の claude-context-guard hook が読む閾値を役割ごとに渡す。
# 監督役は CLAUDE.md の 150k、ワーカーは作業単位で区切る前提で 120k。上書きは役割ごとの
# HC_CLAUDE_<ROLE>_CTX_GUARD_TOKENS で行い、呼び出し元の CLAUDE_CTX_GUARD_TOKENS は使わない
# （監督役の環境がワーカーに引き継がれても、ワーカーの閾値が監督役の値にならないように）。
case "$role" in
  supervisor) ctx_var=HC_CLAUDE_SUPERVISOR_CTX_GUARD_TOKENS ctx_tokens=150000 ;;
  worker) ctx_var=HC_CLAUDE_WORKER_CTX_GUARD_TOKENS ctx_tokens=120000 ;;
esac
ctx_override="${!ctx_var:-}"
if [[ "$ctx_override" =~ ^[1-9][0-9]*$ ]]; then
  ctx_tokens="$ctx_override"
elif [[ -n "$ctx_override" ]]; then
  printf 'hc-claude: %s=%s は正の整数ではないので、既定の %s を使います。\n' "$ctx_var" "$ctx_override" "$ctx_tokens" >&2
fi
export CLAUDE_CTX_GUARD_TOKENS="$ctx_tokens"

claude_args=(--model "$model" --effort "$effort" --permission-mode bypassPermissions
  --settings "$settings" --append-system-prompt-file "$prompt")

# ワーカー、または hc の外: claude に置き換わる。
if [[ "$role" != supervisor || -z "${HC_TERMINAL_ID:-}" ]]; then
  exec "${HC_CLAUDE_BIN:-claude}" "${claude_args[@]}" "$@"
fi

# 監督役: 同じ terminal（同じ tN）のまま Claude Code だけを入れ替えられるよう、claude を子として動かす。
# hc の terminal の parent は起動時に決まり変えられないので、terminal を作り直すと、監督役が起動した
# ワーカーとの親子関係が切れる。hc-supervisor restart は <状態>/<tN>.pid（この bash の pid）を見て、
# <状態>/<tN>.restart に新しい claude への最初の依頼文を書いてから claude を SIGTERM で止める。
# claude が終わったとき .restart があれば、その依頼文で claude を起動し直す。無ければ終わる。
state_dir="${HC_CLAUDE_STATE_DIR:-$HOME/.local/state/hc-claude}"
pid_file="$state_dir/$HC_TERMINAL_ID.pid"
restart_file="$state_dir/$HC_TERMINAL_ID.restart"
mkdir -p "$state_dir"
rm -f "$restart_file"
echo "$$" >"$pid_file"
trap 'rm -f "$pid_file"' EXIT
args=("$@")
while :; do
  status=0
  "${HC_CLAUDE_BIN:-claude}" "${claude_args[@]}" "${args[@]}" || status=$?
  [[ -f "$restart_file" ]] || exit "$status"
  request="$(<"$restart_file")"
  rm -f "$restart_file"
  args=()
  [[ -z "$request" ]] || args=("$request")
  printf '\nhc-claude: Claude Code を起動し直します（同じ terminal %s のまま）。\n' "$HC_TERMINAL_ID"
done
