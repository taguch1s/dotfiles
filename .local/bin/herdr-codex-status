#!/usr/bin/env python3
"""Render the focused Codex pane's live session details for Herdr's tab bar."""

from __future__ import annotations

import json
import os
import re
import subprocess
import tomllib
from datetime import datetime
from pathlib import Path


CODEX_HOME = Path.home() / ".codex"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "herdr-codex-status"
CPU_CACHE = CACHE_DIR / "cpu.json"
DEFAULT_LEASE_LIMIT = 3
MODEL_PATTERN = re.compile(r'"model"\s*:\s*"([^"]+)"')


def snapshot() -> dict:
    result = subprocess.run(
        [str(Path.home() / ".local/bin/herdr"), "api", "snapshot"],
        capture_output=True, check=False, text=True, timeout=0.7,
    )
    if result.returncode:
        return {}
    try:
        return json.loads(result.stdout)["result"]["snapshot"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return {}


def focused_codex_session(data: dict) -> str | None:
    pane_id = data.get("focused_pane_id")
    for pane in data.get("panes", []):
        if pane.get("pane_id") == pane_id and pane.get("agent") == "codex":
            return (pane.get("agent_session") or {}).get("value")
    return None


def task_summary(pane: dict) -> str | None:
    title = str(pane.get("terminal_title_stripped") or "").strip()
    if not title:
        return None
    # Codex titles conventionally append the workspace after " | ".
    summary = title.rsplit(" | ", 1)[0].strip()
    return summary[:48] if summary else None


def sync_codex_tab_labels(data: dict) -> None:
    """Keep every Codex tab named after the task advertised by Codex itself."""
    labels = {tab.get("tab_id"): str(tab.get("label") or "") for tab in data.get("tabs", [])}
    herdr = str(Path.home() / ".local/bin/herdr")
    for pane in data.get("panes", []):
        if pane.get("agent") != "codex":
            continue
        tab_id, summary = pane.get("tab_id"), task_summary(pane)
        if not tab_id or not summary or labels.get(tab_id) == summary:
            continue
        subprocess.run(
            [herdr, "tab", "rename", str(tab_id), summary],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            check=False, timeout=0.5,
        )


def transcript_for(session_id: str) -> Path | None:
    matches = list((CODEX_HOME / "sessions").glob(f"*/*/*/*{session_id}.jsonl"))
    return max(matches, key=lambda item: item.stat().st_mtime) if matches else None


def latest_usage(path: Path) -> dict:
    # JSONL is append-only. Reading backwards avoids loading long transcripts.
    with path.open("rb") as source:
        source.seek(0, 2)
        position = source.tell()
        remaining = b""
        while position:
            step = min(position, 65536)
            position -= step
            source.seek(position)
            lines = (source.read(step) + remaining).split(b"\n")
            remaining = lines[0]
            for raw in reversed(lines[1:]):
                try:
                    event = json.loads(raw)
                except (json.JSONDecodeError, UnicodeDecodeError):
                    continue
                payload = event.get("payload", {})
                if event.get("type") == "event_msg" and payload.get("type") == "token_count":
                    return payload
    return {}


def session_model(path: Path) -> str:
    try:
        first_line = path.open(encoding="utf-8").readline()
    except OSError:
        return "Codex"
    match = MODEL_PATTERN.search(first_line)
    return match.group(1) if match else "Codex"


def configured_effort() -> str:
    try:
        with (CODEX_HOME / "config.toml").open("rb") as source:
            value = tomllib.load(source).get("model_reasoning_effort")
    except (OSError, tomllib.TOMLDecodeError):
        value = None
    return str(value) if value else "—"


def context_label(info: dict) -> str:
    latest = (info.get("last_token_usage") or {}).get("input_tokens")
    limit = info.get("model_context_window")
    if not isinstance(limit, int):
        return "ctx:—"
    if not isinstance(latest, int):
        return f"ctx:—/{limit // 1000}k"
    return f"ctx:{latest // 1000}k/{limit // 1000}k ({round(latest / limit * 100)}%)"


def window_label(limit: dict | None, expected_minutes: int, title: str) -> str:
    if not limit or limit.get("window_minutes") != expected_minutes:
        return f"{title}:—"
    used, reset = limit.get("used_percent"), limit.get("resets_at")
    if not isinstance(used, (int, float)):
        return f"{title}:—"
    output = f"{title}:{used:g}%"
    if isinstance(reset, (int, float)):
        output += " " + datetime.fromtimestamp(reset).strftime("%m/%d %H:%M")
    return output


def cpu_counters() -> tuple[int, int] | None:
    """Return aggregate and idle jiffies from Linux' constant-size /proc/stat."""
    try:
        for line in Path("/proc/stat").read_text(encoding="utf-8").splitlines():
            if line.startswith("cpu "):
                values = [int(value) for value in line.split()[1:]]
                if len(values) < 4:
                    return None
                return sum(values), values[3] + (values[4] if len(values) > 4 else 0)
    except (OSError, ValueError):
        pass
    return None


def previous_cpu_counters() -> tuple[int, int] | None:
    try:
        data = json.loads(CPU_CACHE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return None
        total, idle = data.get("total"), data.get("idle")
        if isinstance(total, int) and isinstance(idle, int):
            return total, idle
    except (OSError, json.JSONDecodeError, TypeError):
        pass
    return None


def save_cpu_counters(counters: tuple[int, int]) -> None:
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        CPU_CACHE.write_text(json.dumps({"total": counters[0], "idle": counters[1]}), encoding="utf-8")
    except OSError:
        pass


def cpu_label() -> str:
    current = cpu_counters()
    if not current:
        return "cpu:—"
    previous = previous_cpu_counters()
    save_cpu_counters(current)
    if not previous or current[0] <= previous[0]:
        return "cpu:—"
    busy = 100 * (1 - (current[1] - previous[1]) / (current[0] - previous[0]))
    return f"cpu:{max(0, min(100, round(busy)))}%"


def memory_label() -> str:
    try:
        values = {}
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            key, value, *_ = line.replace(":", "").split()
            values[key] = int(value)
        total, available = values.get("MemTotal"), values.get("MemAvailable")
        if not total or available is None:
            return "mem:—"
        used = total - available
        return f"mem:{used / 1048576:.1f}/{total / 1048576:.1f}G ({round(used / total * 100)}%)"
    except (OSError, ValueError):
        return "mem:—"


def lease_limit() -> int:
    try:
        return max(1, int(os.environ.get("HERDR_CODEX_LEASE_LIMIT", DEFAULT_LEASE_LIMIT)))
    except ValueError:
        return DEFAULT_LEASE_LIMIT


def lease_label(data: dict) -> str:
    """Count live unique Codex sessions; a lease is an observability proxy, not a quota API."""
    sessions = set()
    working_sessions = set()
    agents = data.get("agents", [])
    if not isinstance(agents, list):
        return f"agents:— (稼働:—) | lease:—/{lease_limit()}"
    for agent in agents:
        if not isinstance(agent, dict):
            continue
        if agent.get("agent") != "codex" or agent.get("agent_status") == "unknown":
            continue
        agent_session = agent.get("agent_session")
        if not isinstance(agent_session, dict):
            continue
        session_id = agent_session.get("value")
        if session_id:
            session_id = str(session_id)
            sessions.add(session_id)
            if agent.get("agent_status") == "working":
                working_sessions.add(session_id)
    limit = lease_limit()
    warning = " ⚠" if len(sessions) >= limit else ""
    return f"agents:{len(sessions)} (稼働:{len(working_sessions)}) | lease:{len(sessions)}/{limit}{warning}"


def resource_label(data: dict) -> str:
    return f"host {cpu_label()} {memory_label()} | {lease_label(data)}"


def _main() -> None:
    data = snapshot()
    sync_codex_tab_labels(data)
    resources = resource_label(data)
    session_id = focused_codex_session(data)
    if not session_id:
        print(f"Codex: セッションなし | {resources}")
        return
    path = transcript_for(session_id)
    if not path:
        print(f"Codex: 利用状況を待機中 | {resources}")
        return
    usage = latest_usage(path)
    rate_limits = usage.get("rate_limits") or {}
    primary, secondary = rate_limits.get("primary"), rate_limits.get("secondary")
    five_hour = window_label(primary, 300, "5h")
    weekly = window_label(primary, 10080, "週")
    if five_hour.endswith("—"):
        five_hour = window_label(secondary, 300, "5h")
    if weekly.endswith("—"):
        weekly = window_label(secondary, 10080, "週")
    print(
        f"{session_model(path)} | effort:{configured_effort()} | "
        f"{context_label(usage.get('info') or {})} | {five_hour} | {weekly} | {resources}"
    )


def main() -> None:
    try:
        _main()
    except (AttributeError, KeyError, OSError, subprocess.SubprocessError, TimeoutError, TypeError, ValueError):
        print("Codex: 状態を取得できません")


if __name__ == "__main__":
    main()
