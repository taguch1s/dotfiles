#!/bin/bash
# Windows のアイドルスリープを抑止すべきかを判定し、~/.cache/awake/state に書く常駐ループ (systemd user service)
# dev ディストリは interop 無効で powershell.exe を呼べないため、実際の抑止は Windows 側の
# windows/awake-watcher.ps1 が state を読んで SetThreadExecutionState を保持する。
# state の中身: 抑止理由 (claude / claude-tool / ssh / hc-working / hc-job など。空なら抑止しない)。毎ループ書き直すので mtime が生存確認を兼ねる。
DIR=$HOME/.cache/awake
BUSY_TTL=${BUSY_TTL:-30}   # 分。Esc 中断では Stop hook が走らずマーカーが残るため、期限で打ち切る
INTERVAL=${INTERVAL:-30}   # 秒
HC_BIN=${HC_BIN:-$HOME/.local/bin/hc}   # systemd user service の PATH には ~/.local/bin がない
HC_TIMEOUT=${HC_TIMEOUT:-5}   # 秒。hc や core が応答しなくてもループを止めない
# herdr-core のソケット。繋がらないときは hc を呼ばない (hc_states のコメント)
HC_CORE_SOCK=${HC_CORE_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/herdr-core/default.sock}
HEAVY_LOCK=${HEAVY_LOCK:-$HOME/.local/share/hc-supervisor/heavy.lock}
PROC_LOCKS=${PROC_LOCKS:-/proc/locks}

# hook が置く作業中マーカー (UserPromptSubmit / PreToolUse で更新、Stop で削除)
claude_busy() {
  [ -n "$(find "$DIR" -maxdepth 1 -name 'busy-*' -mmin -"$BUSY_TTL" 2>/dev/null)" ]
}

# Claude が Bash ツールでコマンド実行中 (claude の直下にシェルがいる)。長時間コマンドでマーカーが古くなっても抑止を続ける
claude_tool() {
  ps -eo pid=,ppid=,comm= | awk '
    { comm[$1]=$3; parent[$1]=$2 }
    END { for (p in comm) if (comm[p] ~ /^(sh|bash|zsh)$/ && comm[parent[p]] == "claude") { found=1; exit } exit !found }'
}

# Tailscale SSH のセッション中 (tailscaled が be-child ssh を子として起動する)
tailscale_ssh() {
  pgrep -f 'tailscaled be-child ssh' >/dev/null
}

# SSH 経由の tmux クライアントが attach 中
ssh_tmux() {
  local pid p
  for pid in $(tmux list-clients -F '#{client_pid}' 2>/dev/null); do
    tr '\0' '\n' < /proc/$pid/environ 2>/dev/null | grep -q '^SSH_CONNECTION=' && return 0
    p=$pid
    while [ -n "$p" ] && [ "$p" -gt 1 ]; do
      case $(command cat /proc/$p/comm 2>/dev/null) in sshd*|tailscaled) return 0 ;; esac
      p=$(awk '/^PPid:/{print $2}' /proc/$p/status 2>/dev/null)
    done
  done
  return 1
}

# hc の端末の状態を 1 行に 1 つ出す: working (エージェントが作業中) / job (シェル以外、またはスクリプトを実行中のシェルが前面にいる)
# 待機中のエージェント (status が idle・done など) と、プロンプトで待つ対話シェルは出さない。
# 各 hc 呼び出しに timeout を付け、失敗した端末は数えない。
# core が動いていなければ hc を呼ばない: hc は core に繋がらないと (ls でも server status でも) core を起動し、
# core はこの service の環境 (PATH に ~/.local/bin がない) を引き継ぐ。その core が起動する terminal は
# hc-claude・claude・uv を見つけられず、監督役もワーカーも起動できなくなる (実機 2026-11-28、PC の再起動直後)。
hc_states() {
  [ -x "$HC_BIN" ] || return 0
  timeout 20 python3 - "$HC_BIN" "$HC_TIMEOUT" "$HC_CORE_SOCK" <<'EOF' 2>/dev/null
import json, os, socket, subprocess, sys
hc, timeout, core_sock = sys.argv[1], float(sys.argv[2]), sys.argv[3]
SHELLS = {"sh", "bash", "zsh", "dash", "fish"}

def core_up():
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(timeout)
            s.connect(core_sock)
        return True
    except OSError:
        return False

def hc_json(*args):
    out = subprocess.run([hc, *args, "--json"], capture_output=True, text=True, timeout=timeout, check=True).stdout
    return json.loads(out)

def running_job(fg):
    name = os.path.basename(fg.get("name") or "").lstrip("-")
    if name not in SHELLS:
        return True
    # 対話シェルは前面のジョブが foreground になる。シェル自身が前面で -c やスクリプトを持つなら実行中
    args = (fg.get("argv") or [])[1:]
    return "-c" in args or any(not a.startswith("-") for a in args)

if not core_up():
    sys.exit(0)
try:
    terminals = hc_json("ls").get("terminals", [])
except Exception:
    sys.exit(0)
for t in terminals:
    if t.get("state") != "live":
        continue
    if t.get("status") is not None:
        if t["status"] == "working":
            print("working")
        continue
    try:
        fg = hc_json("get", t["address"]).get("foreground") or {}
    except Exception:
        continue
    if fg and running_job(fg):
        print("job")
EOF
}

# 重い処理の共有ロック (flock) を誰かが持っている。flock を試すと実処理の取得と競合するので /proc/locks を読む
heavy_lock_held() {
  local ino
  ino=$(stat -c %i "$HEAVY_LOCK" 2>/dev/null) || return 1
  awk -v ino="$ino" '{ n = split($6, f, ":"); if (f[n] == ino) { found = 1; exit } } END { exit !found }' "$PROC_LOCKS" 2>/dev/null
}

reasons() {
  local r=() hc
  claude_busy && r+=(claude)
  claude_tool && r+=(claude-tool)
  tailscale_ssh && r+=(ssh)
  ssh_tmux && r+=(ssh-tmux)
  hc=$(hc_states)
  grep -qx working <<<"$hc" && r+=(hc-working)
  { grep -qx job <<<"$hc" || heavy_lock_held; } && r+=(hc-job)
  (IFS=+; echo "${r[*]}")
}

# --once: 1 回だけ判定して理由を出す (test・手動確認用)
[ "${1:-}" = --once ] && { reasons; exit 0; }

mkdir -p "$DIR"
prev=-
while true; do
  reason=$(reasons)
  printf '%s\n' "$reason" > "$DIR/state.tmp" && mv -f "$DIR/state.tmp" "$DIR/state"
  [ "$reason" != "$prev" ] && echo "state: ${reason:-idle}" && prev=$reason
  sleep "$INTERVAL"
done
