{
  "_format": [
    "委譲・作り直し・over_delegation の fixture。events は waste/cases.json と同じ形（tests/test_claude_token_metrics.py の expand_events が展開する）。",
    "subagents: ファイル名（agent-<id>）-> {meta, events}。meta は agent-<id>.meta.json の中身（オブジェクト。文字列ならそのまま書く。null なら meta.json を作らない）。",
    "expected.delegation は部分一致（agents は先頭から順に部分一致）。rules は ルール名 -> [件数, トークン]（トークンが null なら件数だけ見る）。",
    "kinds は over_delegation の種類別の件数。重みは既定（cc5m 1.25、cc1h 2、cr 0.1、out 5）。"
  ],
  "cases": [
    {
      "name": "delegation_basic_and_trivial",
      "note": "ag1 は 2 リクエスト・ツール 1 回で trivial（cold start = 10 + 500 = 510 トークン、コスト 10 + 500 × 1.25 = 635）。ag2 は 4 リクエスト・ツール 3 回。",
      "events": [
        {"user": "go"},
        {"req": "M1", "u": [0, 1000, 0, 10], "tools": [["ag1", "Agent", {"description": "d", "prompt": "p1", "subagent_type": "general-purpose"}], ["ag2", "Agent", {"description": "d", "prompt": "p2", "subagent_type": "Explore"}]]},
        {"res": "ag1", "fill": "r", "bytes": 100},
        {"res": "ag2", "fill": "q", "bytes": 300},
        {"req": "M2", "u": [0, 700, 1000, 10], "tools": [["tb", "Bash", {"command": "git log"}]]},
        {"res": "tb", "fill": "l", "bytes": 500},
        {"req": "M3", "u": [0, 0, 1700, 10]}
      ],
      "subagents": {
        "agent-a1": {
          "meta": {"toolUseId": "ag1", "agentType": "general-purpose", "model": "m1", "spawnDepth": 1, "finished": true},
          "events": [
            {"req": "S1", "u": [10, 500, 0, 5], "tools": [["s1", "Bash", {"command": "ls"}]]},
            {"res": "s1", "fill": "a", "bytes": 1000},
            {"req": "S2", "u": [0, 0, 600, 5]}
          ]
        },
        "agent-a2": {
          "meta": {"toolUseId": "ag2", "agentType": "Explore", "model": "m1", "spawnDepth": 1, "finished": true},
          "events": [
            {"req": "S1", "u": [20, 800, 0, 5], "tools": [["t1", "Bash", {"command": "ls"}], ["t2", "Bash", {"command": "pwd"}]]},
            {"res": "t1", "fill": "a", "bytes": 1000},
            {"res": "t2", "fill": "b", "bytes": 500},
            {"req": "S2", "u": [0, 0, 820, 5], "tools": [["t3", "Bash", {"command": "ls"}]]},
            {"res": "t3", "fill": "c", "bytes": 300},
            {"req": "S3", "u": [0, 0, 900, 5]},
            {"req": "S4", "u": [0, 0, 950, 5]}
          ]
        }
      },
      "expected": {"delegation": {"agent_calls": 2, "subagent_tool_bytes": 2800, "agent_result_bytes": 400, "main_tool_bytes": 500, "compression": 0.14285714285714285, "unlinked": 0, "subagent_cost_share": 0.455847765661749, "agents": [{"tool_use_id": "ag1", "agent_type": "general-purpose", "model": "m1", "requests": 2, "tool_calls": 1, "weighted_cost": 745, "cold_start_tokens": 510, "result_bytes": 100}, {"tool_use_id": "ag2", "agent_type": "Explore", "model": "m1", "requests": 4, "tool_calls": 3, "weighted_cost": 1387, "cold_start_tokens": 820, "result_bytes": 300}]}, "rules": {"over_delegation": [1, 510]}, "over_delegation_cost": 635, "kinds": {"trivial": 1, "duplicate": 0}, "under_delegation": false}
    },
